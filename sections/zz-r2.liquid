<div>x</div>
{% schema %}
{
  "name": "ZZ R2",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton",
      "default": "Commencer ma routine"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton",
      "info": "Laisse #acheter pour remonter au bloc d'achat de la page produit."
    },
    {
      "type": "range",
      "id": "cta_gap",
      "min": 20,
      "max": 90,
      "step": 4,
      "unit": "px",
      "label": "Espace au-dessus du bouton",
      "default": 48
    },
    {
      "type": "header",
      "content": "Grille"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "unit": "col",
      "label": "Colonnes (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "grid_gap_sm",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Espacement (mobile)",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "show_connector",
      "label": "Ligne pointillée entre les étapes",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Largeur",
      "options": [
        {
          "value": "narrow",
          "label": "Étroite"
        },
        {
          "value": "normal",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Cartes"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Arrondi",
      "default": 18
    }
  ]
}
{% endschema %}
