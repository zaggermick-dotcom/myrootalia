{%- comment -%}
  myrootelia — Contenu page produit (sous la fiche Batana)
  Bénéfices · Ingrédient unique · Rituel · Comparaison factuelle · Origine · Réassurance
  Conformité : allégations cosmétiques uniquement. Aucun faux avis / % inventé.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap');

  #mrp-{{ uid }} {
    --g: {{ s.color_green | default: '#2F5233' }};
    --o: {{ s.color_gold | default: '#B07A3B' }};
    --c: {{ s.color_cream | default: '#F5F1EA' }};
    --ink: {{ s.color_ink | default: '#2B2B2B' }};
    --serif: 'Playfair Display', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--sans); color: var(--ink);
  }
  #mrp-{{ uid }} * { box-sizing: border-box; }
  #mrp-{{ uid }} img { display:block; max-width:100%; }
  #mrp-{{ uid }} .mrp-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  #mrp-{{ uid }} .mrp-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: var(--o); margin: 0 0 12px; }
  #mrp-{{ uid }} .mrp-h { font-family: var(--serif); font-weight: 600; color: var(--g); font-size: clamp(24px,3.4vw,38px); line-height:1.15; margin: 0 0 16px; }
  #mrp-{{ uid }} .mrp-lead { font-size: 16px; line-height: 1.75; color: #4a463f; }

  /* Bénéfices */
  #mrp-{{ uid }} .mrp-benefits { background: var(--c); padding: 72px 0; }
  #mrp-{{ uid }} .mrp-bgrid { display:grid; grid-template-columns: repeat(4,1fr); gap: 22px; margin-top: 34px; }
  #mrp-{{ uid }} .mrp-bcard { background:#fff; border-radius:18px; padding: 28px 22px; text-align:center; box-shadow: 0 12px 30px rgba(43,43,43,.06); }
  #mrp-{{ uid }} .mrp-bicon { width:52px; height:52px; margin:0 auto 16px; border-radius:50%; background: var(--c); display:flex; align-items:center; justify-content:center; color:var(--g); }
  #mrp-{{ uid }} .mrp-bicon svg { width:26px; height:26px; }
  #mrp-{{ uid }} .mrp-bt { font-family:var(--serif); font-size:17px; color:var(--g); margin:0 0 6px; }
  #mrp-{{ uid }} .mrp-bd { font-size:13.5px; color:#6a655c; line-height:1.55; margin:0; }

  /* Ingredient */
  #mrp-{{ uid }} .mrp-ingr { padding: 84px 0; }
  #mrp-{{ uid }} .mrp-split { display:grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items:center; }
  #mrp-{{ uid }} .mrp-media { border-radius: 20px; overflow:hidden; box-shadow: 0 30px 70px rgba(43,43,43,.14); }
  #mrp-{{ uid }} .mrp-inci { margin-top: 20px; background: var(--c); border-radius: 14px; padding: 16px 20px; font-size: 14px; }
  #mrp-{{ uid }} .mrp-inci strong { color: var(--g); }

  /* Rituel */
  #mrp-{{ uid }} .mrp-ritual { background: var(--g); color: #f3efe6; padding: 84px 0; }
  #mrp-{{ uid }} .mrp-ritual .mrp-h { color:#fff; }
  #mrp-{{ uid }} .mrp-ritual .mrp-eyebrow { color:#cbb892; }
  #mrp-{{ uid }} .mrp-steps { display:grid; grid-template-columns: repeat(3,1fr); gap: 22px; margin-top: 34px; }
  #mrp-{{ uid }} .mrp-step { background: rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:16px; padding: 26px 22px; }
  #mrp-{{ uid }} .mrp-step__n { font-family:var(--serif); font-size: 30px; color:#cbb892; margin-bottom: 8px; }
  #mrp-{{ uid }} .mrp-step__t { font-weight:600; color:#fff; margin-bottom:6px; }
  #mrp-{{ uid }} .mrp-step__d { font-size:14px; color:#d9d3c6; line-height:1.6; }

  /* Comparaison */
  #mrp-{{ uid }} .mrp-compare { padding: 84px 0; }
  #mrp-{{ uid }} .mrp-table { max-width: 760px; margin: 30px auto 0; border-radius: 18px; overflow: hidden; box-shadow: 0 18px 50px rgba(43,43,43,.08); border:1px solid rgba(47,82,51,.08); }
  #mrp-{{ uid }} .mrp-row { display:grid; grid-template-columns: 1.4fr 1fr 1fr; }
  #mrp-{{ uid }} .mrp-row > div { padding: 15px 18px; font-size: 14px; display:flex; align-items:center; gap:8px; }
  #mrp-{{ uid }} .mrp-row--head > div { font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.5px; }
  #mrp-{{ uid }} .mrp-row--head .mrp-us { background: var(--g); color:#fff; justify-content:center; }
  #mrp-{{ uid }} .mrp-row--head .mrp-them { background:#efece5; color:#8a8377; justify-content:center; }
  #mrp-{{ uid }} .mrp-row--head .mrp-lbl { background:#fff; }
  #mrp-{{ uid }} .mrp-row .mrp-lbl { background:#fff; color:var(--ink); font-weight:500; }
  #mrp-{{ uid }} .mrp-row .mrp-us { background:rgba(47,82,51,.06); color:var(--g); justify-content:center; font-weight:600; }
  #mrp-{{ uid }} .mrp-row .mrp-them { background:#faf9f6; color:#a89f92; justify-content:center; }
  #mrp-{{ uid }} .mrp-row + .mrp-row > div { border-top:1px solid rgba(47,82,51,.07); }
  #mrp-{{ uid }} .mrp-tick { color: var(--o); }

  /* Réassurance */
  #mrp-{{ uid }} .mrp-trust { background: var(--c); padding: 64px 0; }
  #mrp-{{ uid }} .mrp-tgrid { display:grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  #mrp-{{ uid }} .mrp-tc { text-align:center; }
  #mrp-{{ uid }} .mrp-tc svg { width:30px; height:30px; color:var(--g); margin-bottom:10px; }
  #mrp-{{ uid }} .mrp-tc b { display:block; color:var(--g); font-family:var(--serif); font-size:16px; margin-bottom:4px; }
  #mrp-{{ uid }} .mrp-tc span { font-size:13px; color:#6a655c; }

  /* Free-from (Sans) */
  #mrp-{{ uid }} .mrp-free { padding: 46px 0; border-bottom:1px solid rgba(47,82,51,.08); }
  #mrp-{{ uid }} .mrp-pills { display:flex; flex-wrap:wrap; justify-content:center; gap:12px; margin-top:22px; }
  #mrp-{{ uid }} .mrp-pill { display:inline-flex; align-items:center; gap:8px; background:var(--c); color:var(--g); border:1px solid rgba(47,82,51,.12); border-radius:999px; padding:10px 18px; font-size:14px; font-weight:500; }
  #mrp-{{ uid }} .mrp-pill svg { width:16px; height:16px; color:var(--o); flex:none; }

  /* Façons d'utiliser */
  #mrp-{{ uid }} .mrp-uses { margin-top: 40px; display:grid; grid-template-columns: repeat(3,1fr); gap:18px; text-align:left; }
  #mrp-{{ uid }} .mrp-use { background: rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:16px; padding:22px; }
  #mrp-{{ uid }} .mrp-use b { display:block; font-family:var(--serif); font-size:16px; color:#fff; margin-bottom:6px; }
  #mrp-{{ uid }} .mrp-use span { font-size:13.5px; color:#d9d3c6; line-height:1.6; }
  #mrp-{{ uid }} .mrp-use em { color:#cbb892; font-style:normal; font-weight:600; }

  /* FAQ */
  #mrp-{{ uid }} .mrp-faq { padding: 80px 0; background:#fff; }
  #mrp-{{ uid }} .mrp-faq .mrp-wrap { max-width: 780px; }
  #mrp-{{ uid }} .mrp-q { border-bottom:1px solid rgba(47,82,51,.12); }
  #mrp-{{ uid }} .mrp-q summary { list-style:none; cursor:pointer; padding:20px 4px; font-family:var(--serif); font-size:18px; color:var(--g); display:flex; justify-content:space-between; align-items:center; gap:16px; }
  #mrp-{{ uid }} .mrp-q summary::-webkit-details-marker { display:none; }
  #mrp-{{ uid }} .mrp-q summary::after { content:"+"; font-size:24px; color:var(--o); font-family:var(--sans); line-height:1; transition:transform .2s; }
  #mrp-{{ uid }} .mrp-q[open] summary::after { transform:rotate(45deg); }
  #mrp-{{ uid }} .mrp-q p { margin:0 4px; padding:0 0 22px; font-size:15px; line-height:1.75; color:#4a463f; }

  @media (max-width: 860px) {
    #mrp-{{ uid }} .mrp-bgrid { grid-template-columns: 1fr 1fr; }
    #mrp-{{ uid }} .mrp-split { grid-template-columns: 1fr; gap: 30px; }
    #mrp-{{ uid }} .mrp-steps, #mrp-{{ uid }} .mrp-tgrid, #mrp-{{ uid }} .mrp-uses { grid-template-columns: 1fr; }
    #mrp-{{ uid }} .mrp-row { grid-template-columns: 1.3fr .85fr .85fr; }
    #mrp-{{ uid }} .mrp-ingr .mrp-media { order:-1; }
  }
{%- endstyle -%}

<div id="mrp-{{ uid }}">

  <!-- BÉNÉFICES -->
  <section class="mrp-benefits">
    <div class="mrp-wrap" style="text-align:center;">
      <p class="mrp-eyebrow">Nourrit · Répare · Fortifie</p>
      <h2 class="mrp-h">Ce que le Batana apporte à vos cheveux</h2>
      <div class="mrp-bgrid" style="text-align:left;">
        <div class="mrp-bcard">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg></div>
          <p class="mrp-bt">Nourrit intensément</p>
          <p class="mrp-bd">Une huile riche qui gaine la fibre et nourrit le cuir chevelu en profondeur.</p>
        </div>
        <div class="mrp-bcard">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v20M5 9l7-7 7 7"/></svg></div>
          <p class="mrp-bt">Apparence plus dense</p>
          <p class="mrp-bd">Favorise l'apparence de cheveux visiblement plus sains et plus denses.</p>
        </div>
        <div class="mrp-bcard">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg></div>
          <p class="mrp-bt">Apaise le cuir chevelu</p>
          <p class="mrp-bd">Réconforte les cuirs chevelus secs et inconfortables, soir après soir.</p>
        </div>
        <div class="mrp-bcard">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 20A7 7 0 0 1 4 13c0-4 3-8 7-11 4 3 7 7 7 11a7 7 0 0 1-7 7Z"/><path d="M11 20V9"/></svg></div>
          <p class="mrp-bt">Cheveux secs & crépus</p>
          <p class="mrp-bd">Idéale pour cheveux secs, frisés et crépus qui ont soif de nutrition.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INGRÉDIENT -->
  <section class="mrp-ingr">
    <div class="mrp-wrap">
      <div class="mrp-split">
        <div>
          <p class="mrp-eyebrow">Un seul ingrédient</p>
          <h2 class="mrp-h">100 % Batana pur. Rien d'autre.</h2>
          <p class="mrp-lead">Pas de remplissage, pas de dilution. Juste l'huile épaisse et sombre extraite du fruit du palmier <em>Elaeis oleifera</em>, pressée à froid pour préserver ses nutriments. Naturellement riche en acides gras (oléique, linoléique) et en vitamine E, c'est un émollient qui gaine et nourrit la fibre.</p>
          <div class="mrp-inci"><strong>INCI :</strong> Elaeis Oleifera (Palm) Oil · <strong>Sans</strong> additifs, parfum de synthèse ni conservateurs.</div>
        </div>
        <div class="mrp-media"><img src="{{ 'myrootelia-goutte.png' | asset_url }}" alt="Goutte d'huile de Batana pure"></div>
      </div>
    </div>
  </section>

  <!-- FREE-FROM / SANS -->
  <section class="mrp-free">
    <div class="mrp-wrap" style="text-align:center;">
      <p class="mrp-eyebrow">Une formule minimaliste</p>
      <h2 class="mrp-h">Ce qu'il n'y a pas dedans</h2>
      <div class="mrp-pills">
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans additifs</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans parfum de synthèse</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans silicones</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans conservateurs</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans colorant</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Non testée sur les animaux</span>
      </div>
    </div>
  </section>

  <!-- RITUEL -->
  <section class="mrp-ritual">
    <div class="mrp-wrap" style="text-align:center;">
      <p class="mrp-eyebrow">Le rituel du soir</p>
      <h2 class="mrp-h">Simple. 2 minutes. Chaque soir.</h2>
      <div class="mrp-steps" style="text-align:left;">
        <div class="mrp-step"><div class="mrp-step__n">01</div><div class="mrp-step__t">Déposez</div><div class="mrp-step__d">Quelques gouttes sur le cuir chevelu et les longueurs, mèche par mèche.</div></div>
        <div class="mrp-step"><div class="mrp-step__n">02</div><div class="mrp-step__t">Massez</div><div class="mrp-step__d">2 minutes du bout des doigts, pour stimuler et détendre le cuir chevelu.</div></div>
        <div class="mrp-step"><div class="mrp-step__n">03</div><div class="mrp-step__t">Laissez poser</div><div class="mrp-step__d">Idéalement toute la nuit. Rincez ou laissez selon la texture de vos cheveux.</div></div>
      </div>
      <div class="mrp-uses">
        <div class="mrp-use"><b>Cure cuir chevelu</b><span>Sur cuir chevelu sec, <em>3 à 4 fois / semaine</em>, pour une chevelure d'apparence plus dense.</span></div>
        <div class="mrp-use"><b>Soin des longueurs</b><span>Quelques gouttes sur cheveux secs ou humides, <em>2 à 3 fois / semaine</em>, pour nourrir et discipliner.</span></div>
        <div class="mrp-use"><b>Masque de nuit</b><span>En couche généreuse le soir, <em>1 fois / semaine</em>, puis lavez au matin pour un soin profond.</span></div>
      </div>
    </div>
  </section>

  <!-- COMPARAISON (factuelle) -->
  <section class="mrp-compare">
    <div class="mrp-wrap" style="text-align:center;">
      <p class="mrp-eyebrow">Pourquoi myrootelia</p>
      <h2 class="mrp-h">Toutes les huiles de Batana ne se valent pas</h2>
      <div class="mrp-table">
        <div class="mrp-row mrp-row--head">
          <div class="mrp-lbl"></div>
          <div class="mrp-us">myrootelia</div>
          <div class="mrp-them">Huiles génériques</div>
        </div>
        <div class="mrp-row"><div class="mrp-lbl">100 % Batana pur (non dilué)</div><div class="mrp-us"><span class="mrp-tick">✓</span></div><div class="mrp-them">Souvent mélangée</div></div>
        <div class="mrp-row"><div class="mrp-lbl">Origine tracée (Honduras)</div><div class="mrp-us"><span class="mrp-tick">✓</span></div><div class="mrp-them">Rarement</div></div>
        <div class="mrp-row"><div class="mrp-lbl">Pressée à froid</div><div class="mrp-us"><span class="mrp-tick">✓</span></div><div class="mrp-them">Variable</div></div>
        <div class="mrp-row"><div class="mrp-lbl">Sans additifs ni conservateurs</div><div class="mrp-us"><span class="mrp-tick">✓</span></div><div class="mrp-them">Variable</div></div>
        <div class="mrp-row"><div class="mrp-lbl">Discours honnête, sans promesse miracle</div><div class="mrp-us"><span class="mrp-tick">✓</span></div><div class="mrp-them">Allégations exagérées</div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mrp-faq">
    <div class="mrp-wrap" style="text-align:center;">
      <p class="mrp-eyebrow">Questions fréquentes</p>
      <h2 class="mrp-h" style="margin-bottom:28px;">Tout ce qu'il faut savoir</h2>
    </div>
    <div class="mrp-wrap" style="text-align:left;">
      <details class="mrp-q">
        <summary>Pour quels types de cheveux ?</summary>
        <p>Pour tous les types de cheveux, et particulièrement les cheveux secs, épais, frisés ou crépus qui recherchent une nutrition intense. Sa texture riche convient aussi au soin de la barbe et des sourcils.</p>
      </details>
      <details class="mrp-q">
        <summary>Est-ce que l'huile graisse les cheveux ?</summary>
        <p>Le Batana est une huile riche : quelques gouttes suffisent. Appliquée en petite quantité sur les longueurs, ou en masque avant le lavage, elle nourrit sans alourdir. Ajustez la dose à la porosité de vos cheveux.</p>
      </details>
      <details class="mrp-q">
        <summary>Au bout de combien de temps voit-on une différence ?</summary>
        <p>Dès les premières applications, les cheveux paraissent plus souples et plus faciles à coiffer. Pour l'aspect général de la chevelure, la régularité est la clé : intégrez le rituel plusieurs fois par semaine sur la durée.</p>
      </details>
      <details class="mrp-q">
        <summary>Quelle est l'origine de l'huile ?</summary>
        <p>Notre Batana provient du Honduras, extrait selon la méthode ancestrale du peuple Miskito à partir du fruit du palmier <em>Elaeis oleifera</em>. Elle est pressée à froid et 100 % pure, sans dilution.</p>
      </details>
      <details class="mrp-q">
        <summary>Comment se conserve-t-elle ?</summary>
        <p>À température ambiante, à l'abri de la lumière directe. Le Batana peut se figer au froid : réchauffez le flacon entre vos mains ou dans un peu d'eau tiède pour lui rendre sa texture fluide.</p>
      </details>
    </div>
  </section>

  <!-- RÉASSURANCE -->
  <section class="mrp-trust">
    <div class="mrp-wrap">
      <div class="mrp-tgrid">
        <div class="mrp-tc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>
          <b>Satisfait ou remboursé</b><span>30 jours pour essayer le rituel</span>
        </div>
        <div class="mrp-tc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <b>Paiement 100 % sécurisé</b><span>Vos données sont protégées</span>
        </div>
        <div class="mrp-tc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 7h14l-1 13H6L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
          <b>Livraison suivie</b><span>Expédition rapide, colis traçable</span>
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Produit myrootelia",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Couleurs (charte)" },
    { "type": "color", "id": "color_green", "label": "Vert forêt", "default": "#2F5233" },
    { "type": "color", "id": "color_gold", "label": "Or / terre", "default": "#B07A3B" },
    { "type": "color", "id": "color_cream", "label": "Crème", "default": "#F5F1EA" },
    { "type": "color", "id": "color_ink", "label": "Noir doux", "default": "#2B2B2B" }
  ],
  "presets": [{ "name": "Produit myrootelia" }]
}
{% endschema %}
