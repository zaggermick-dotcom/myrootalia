    { "type": "color", "id": "color_btn_text", "label": "Texte du bouton", "default": "#FAF6EF" },
    { "type": "header", "content": "Espacements" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Haut (desktop)", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bas (desktop)", "default": 64 },
    { "type": "range", "id": "padding_top_sm", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Haut (mobile)", "default": 36 },
    { "type": "range", "id": "padding_bottom_sm", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bas (mobile)", "default": 36 }
  ],
  "blocks": [
    {
      "type": "icone",
      "name": "Icône",
      "settings": [
        { "type": "select", "id": "icone", "label": "Icône", "options": [
          { "value": "feuille", "label": "🌿 Feuille" }, { "value": "pousse", "label": "🌱 Pousse" },
          { "value": "goutte", "label": "💧 Goutte" }, { "value": "gouttes", "label": "💦 Gouttes" },
          { "value": "compte_gouttes", "label": "🧪 Compte-gouttes" }, { "value": "flacon", "label": "🧴 Flacon" },
          { "value": "fleur", "label": "🌸 Fleur" }, { "value": "graine", "label": "🌰 Graine" },
          { "value": "soleil", "label": "☀️ Soleil" }, { "value": "lune", "label": "🌙 Lune" },
          { "value": "eau", "label": "🌊 Eau" },
          { "value": "cheveux", "label": "💇 Cheveux" }, { "value": "cuir_chevelu", "label": "🧠 Cuir chevelu" },
          { "value": "massage", "label": "🤲 Massage" }, { "value": "peigne", "label": "🪮 Peigne" },
          { "value": "brosse", "label": "🖌️ Brosse" }, { "value": "main", "label": "✋ Main" },
          { "value": "miroir", "label": "🪞 Miroir" },
          { "value": "bouclier", "label": "🛡️ Bouclier" }, { "value": "coche", "label": "✓ Coche" },
          { "value": "coche_cercle", "label": "✅ Coche cerclée" }, { "value": "croix_cercle", "label": "❌ Croix cerclée" },
          { "value": "cadenas", "label": "🔒 Cadenas" }, { "value": "retour", "label": "↩️ Retour" },
          { "value": "medaille", "label": "🏅 Médaille" }, { "value": "certificat", "label": "📜 Certificat" },
          { "value": "coeur", "label": "❤️ Cœur" }, { "value": "lapin", "label": "🐰 Lapin (cruelty-free)" },
          { "value": "recyclage", "label": "♻️ Recyclage" }, { "value": "sans", "label": "🚫 Sans (interdit)" },
          { "value": "camion", "label": "🚚 Camion" }, { "value": "colis", "label": "📦 Colis" },
          { "value": "cadeau", "label": "🎁 Cadeau" }, { "value": "carte_bancaire", "label": "💳 Carte bancaire" },
          { "value": "etiquette", "label": "🏷️ Étiquette" }, { "value": "monde", "label": "🌍 Monde" },
          { "value": "epingle", "label": "📍 Épingle" },
