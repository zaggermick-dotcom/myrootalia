{%- liquid
  assign style = block.settings.accordion_style | default: 'minimal'
  assign icon = block.settings.icon | default: 'none'
  assign toggle = block.settings.toggle_icon | default: 'plus'
  assign pad_v = block.settings.padding_vertical | default: 16
  assign pad_h = block.settings.padding_horizontal | default: 20
  assign radius = block.settings.corner_radius | default: 12

  assign line = 'rgba(var(--color-foreground, 18,18,18), 0.12)'
  if block.settings.border_color != blank and block.settings.border_color.alpha != 0.0
    assign line = block.settings.border_color
  endif

  assign bg = 'rgb(var(--color-background-secondary, 246,246,246))'
  if block.settings.background_color != blank and block.settings.background_color.alpha != 0.0
    assign bg = block.settings.background_color
  endif
-%}

{%- style -%}
  .custom-accordion--{{ block.id }} {
    flex: var(--group-child-flex, 1 1 0%);
    min-width: 0;
    {%- case style %}
      {%- when 'card' %}
        background: {{ bg }};
        border: 1px solid {{ line }};
        border-radius: {{ radius }}px;
      {%- when 'filled' %}
        background: {{ bg }};
        border-radius: {{ radius }}px;
      {%- else %}
        border-bottom: 1px solid {{ line }};
    {%- endcase %}
  }

  .custom-accordion--{{ block.id }} summary {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    cursor: pointer;
    list-style: none;
    padding: {{ pad_v | divided_by: 10.0 }}rem {% if style == 'minimal' %}0{% else %}{{ pad_h | divided_by: 10.0 }}rem{% endif %};
    font-family: var(--font-heading-family, inherit);
    font-size: {{ block.settings.title_size | divided_by: 10.0 }}rem;
    line-height: 1.35;
    transition: opacity 0.2s ease;
  }

  /* Retire le triangle natif (Safari inclus). */
  .custom-accordion--{{ block.id }} summary::-webkit-details-marker {
    display: none;
  }

  .custom-accordion--{{ block.id }} summary:hover {
    opacity: 0.7;
  }

  .custom-accordion--{{ block.id }} .custom-accordion__title {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    font: inherit;
    text-align: left;
  }

  .custom-accordion--{{ block.id }} .custom-accordion__lead-icon {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    fill: currentColor;
  }

  /* Plus / moins dessiné en CSS : s'anime proprement, aucun SVG à charger. */
  .custom-accordion--{{ block.id }} .custom-accordion__toggle {
    position: relative;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
  }

  .custom-accordion--{{ block.id }} .custom-accordion__toggle::before,
  .custom-accordion--{{ block.id }} .custom-accordion__toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .custom-accordion--{{ block.id }} .custom-accordion__toggle::after {
    transform: rotate(90deg);
  }

  .custom-accordion--{{ block.id }} details[open] .custom-accordion__toggle::after {
    transform: rotate(0deg);
    opacity: 0;
  }

  .custom-accordion--{{ block.id }} .collapsible__icon {
    flex-shrink: 0;
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.25s ease;
  }

  .custom-accordion--{{ block.id }} details[open] .collapsible__icon {
    transform: rotate(180deg);
  }

  .custom-accordion--{{ block.id }} .custom-accordion__content {
    padding: 0 {% if style == 'minimal' %}0{% else %}{{ pad_h | divided_by: 10.0 }}rem{% endif %} {{ pad_v | divided_by: 10.0 }}rem;
    word-break: break-word;
  }

  .custom-accordion--{{ block.id }} .custom-accordion__content > :last-child {
    margin-bottom: 0;
  }

  /* Révélation en CSS pur : pas de JS, pas de saut de mise en page. */
  .custom-accordion--{{ block.id }} details[open] .custom-accordion__content {
    animation: customAccordionReveal 0.25s ease;
  }

  @keyframes customAccordionReveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-accordion--{{ block.id }} details[open] .custom-accordion__content {
      animation: none;
    }
  }

  {%- if block.settings.mobile_hidden %}
    @media screen and (max-width: 749px) {
      .custom-accordion--{{ block.id }} {
        display: none;
      }
    }
  {%- endif %}
{%- endstyle -%}

{%- if block.settings.heading != blank or block.settings.content != blank -%}
  <div
    class="custom-accordion custom-accordion--{{ block.id }} custom-accordion--{{ style }}"
    {% render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation %}
    {{ block.shopify_attributes }}
  >
    {%- comment -%} Ouvert dans l'aperçu, sinon on ne verrait qu'une ligne de titre. {%- endcomment -%}
    <details
      id="Details-{{ block.id }}"
      {% if block.settings.open_by_default or request.visual_preview_mode %}open{% endif %}
    >
      <summary id="Summary-{{ block.id }}">
        {%- if block.settings.icon_custom != blank -%}
          {{
            block.settings.icon_custom
            | image_url: width: 40
            | image_tag: loading: 'lazy', class: 'custom-accordion__lead-icon'
          }}
        {%- elsif icon != 'none' -%}
          {%- render 'icons', icon: icon, width: 20 -%}
        {%- endif -%}

        <p class="custom-accordion__title">
          {{ block.settings.heading | default: block.settings.page.title }}
        </p>

        {%- case toggle -%}
          {%- when 'plus' -%}
            <span class="custom-accordion__toggle" aria-hidden="true"></span>
          {%- when 'caret' -%}
            {%- render 'icon-caret', behavior: 'arrow' -%}
        {%- endcase -%}
      </summary>
      <div
        class="custom-accordion__content rte"
        id="CollapsibleAccordion-{{ block.id }}"
        role="region"
        aria-labelledby="Summary-{{ block.id }}"
      >
        {{ block.settings.content }}
        {{ block.settings.page.content }}
      </div>
    </details>
  </div>
{%- endif -%}

