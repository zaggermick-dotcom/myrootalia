{%- liquid
  assign bgImage = section.settings.image_bg_colored
  assign bgImageMobile = section.settings.image_bg_colored_mobile
  if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank
    render 'cut-colored'
  endif

  assign direction = section.settings.direction | default: 'horizontal'
  assign align_horizontal = section.settings.align_horizontal | default: 'stretch'
  assign align_vertical = section.settings.align_vertical | default: 'stretch'
  assign gap = section.settings.gap | default: 24
  assign gap_mobile = section.settings.gap_mobile | default: 16

  case align_horizontal
    when 'center'
      assign align_horizontal_cross = 'center'
      assign align_horizontal_main = 'center'
    when 'right'
      assign align_horizontal_cross = 'flex-end'
      assign align_horizontal_main = 'flex-end'
    when 'stretch'
      assign align_horizontal_cross = 'stretch'
      assign align_horizontal_main = 'flex-start'
    else
      assign align_horizontal_cross = 'flex-start'
      assign align_horizontal_main = 'flex-start'
  endcase

  case align_vertical
    when 'center'
      assign align_vertical_cross = 'center'
      assign align_vertical_main = 'center'
    when 'bottom'
      assign align_vertical_cross = 'flex-end'
      assign align_vertical_main = 'flex-end'
    when 'stretch'
      assign align_vertical_cross = 'stretch'
      assign align_vertical_main = 'flex-start'
    else
      assign align_vertical_cross = 'flex-start'
      assign align_vertical_main = 'flex-start'
  endcase

  if direction == 'vertical'
    assign justify_content = align_vertical_main
    assign align_items = align_horizontal_cross
  else
    assign justify_content = align_horizontal_main
    assign align_items = align_vertical_cross
  endif

  comment
    Children only grow along the main axis, and only when the merchant asked for
    "stretch". Growing unconditionally leaves no free space, which makes
    left/center/right silently inert.
  endcomment
  if direction == 'vertical' or align_horizontal != 'stretch'
    assign child_flex = '0 0 auto'
  else
    assign child_flex = '1 1 0%'
  endif

  comment
    Cross axis in a vertical parent, main axis in a horizontal one: either way a
    child is only full-width when the alignment is "stretch". Blocks with no
    intrinsic width read this instead of hardcoding 100%.
  endcomment
  if align_horizontal == 'stretch'
    assign child_width = '100%'
  else
    assign child_width = 'auto'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_sm }}px;
    padding-bottom: {{ section.settings.padding_bottom_sm }}px;
  }

  {%- if section.settings.hide_mobile -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding { display: none; }
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- if section.settings.hide_desktop -%}
        display: none;
      {%- endif -%}
    }
  }

  .advanced-custom-section-{{ section.id }} {
    display: flex;
    flex-direction: {% if direction == 'vertical' %}column{% else %}row{% endif %};
    flex-wrap: {% if direction == 'vertical' %}nowrap{% else %}wrap{% endif %};
    justify-content: {{ justify_content }};
    align-items: {{ align_items }};
    column-gap: var(--group-gap);
    row-gap: var(--group-gap);
    --group-gap: {{ gap_mobile }}px;
  }

  /* Container contract: children only grow along the parent's axis. */
  .advanced-custom-section-{{ section.id }} > * {
    --group-child-flex: {{ child_flex }};
    --group-child-width: {{ child_width }};
    --group-parent-gap: {% if direction == 'vertical' %}0px{% else %}{{ gap_mobile }}px{% endif %};
  }

  {%- assign mobile_gutter = section.settings.mobile_gutter | default: 0 -%}
  {%- if section.settings.layout_width == 'full' and mobile_gutter > 0 %}
    /* Full width: mobile side gutter; media blocks read the var to escape it. */
    @media screen and (max-width: 749px) {
      .advanced-custom-section-{{ section.id }} {
        padding-left: {{ mobile_gutter }}px;
        padding-right: {{ mobile_gutter }}px;
        --section-mobile-gutter: {{ mobile_gutter }}px;
      }
    }
  {%- endif %}

  {%- if section.settings.stack_on_mobile and direction == 'horizontal' %}
    @media screen and (max-width: 749px) {
      .advanced-custom-section-{{ section.id }} {
        flex-direction: column;
        /* The row becomes a column: axes swap. */
        justify-content: {{ align_vertical_main }};
        align-items: {{ align_horizontal_cross }};
      }

      .advanced-custom-section-{{ section.id }} > * {
        --group-child-flex: 0 0 auto;
        --group-parent-gap: 0px;
      }

      .advanced-custom-section-{{ section.id }} > .group {
        width: var(--group-child-width, 100%);
        max-width: 100%;
      }
    }
  {%- endif %}

  @media screen and (min-width: 750px) {
    .advanced-custom-section-{{ section.id }} {
      --group-gap: {{ gap }}px;
    }

    {%- if direction != 'vertical' %}
      .advanced-custom-section-{{ section.id }} > * {
        --group-parent-gap: {{ gap }}px;
      }
    {%- endif %}
  }
{%- endstyle -%}

{%- render 'separator-top', section: section -%}

{%- capture attributes -%}
  id="{{ section.settings.section_id }}"
  class="color-{{ section.settings.color_palette }} section-{{ section.id }}-padding{% if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank %} cut-colored-section{% endif %}"
  data-section-id="{{ section.id }}"
{%- endcapture -%}

<div {{ attributes }}>
  <div
    class="advanced-custom-section advanced-custom-section-{{ section.id }} custom-section container container--{{ section.settings.layout_width }}"
    {%- render 'animation', enable_animations: section.settings.enable_animations, animation: section.settings.animation -%}
  >
    {% content_for 'blocks' %}
  </div>
</div>

{%- render 'separator-bottom', section: section -%}

