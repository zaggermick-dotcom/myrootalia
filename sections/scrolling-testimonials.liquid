{{ 'scrolling-testimonials.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bgimage = section.settings.image_bg_colored
    assign enable_animations = section.settings.enable_animations
  assign animation = section.settings.animation

  assign bgimagemobile = section.settings.image_bg_colored_mobile
  if section.settings.enable_cut_bg_color or bgimage != blank or bgimagemobile != blank
    render 'cut-colored'
  endif
-%}

{%- # region(collapsed) Styles -%}
{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_sm }}px;
      padding-bottom: {{ section.settings.padding_bottom_sm }}px;
    }

    {%- if section.settings.hide_mobile -%}
      @media screen and (max-width: 749px) {
        .section-{{ section.id }}-padding { display: none; }
      }
    {%- endif -%}

    #t-{{ section.id }} .testimonials-track {
    animation-duration: {{ section.settings.scroll_speed }}s;
  animation-direction: {% if section.settings.scroll_direction == 'right' %}reverse{% else %}normal{% endif %};
  }

  {%- if section.settings.pause_on_hover -%}
  #t-{{ section.id }} .scrolling-testimonials:hover .testimonials-track {
    animation-play-state: paused;
  }
  {%- endif -%}

#t-{{ section.id }} .testimonials-track {
  align-items: {% if section.settings.equalize_review_heights %}stretch{% else %}flex-start{% endif %};
}

#t-{{ section.id }} .testimonial-card {
  justify-content: {% if section.settings.equalize_review_heights %} {{ section.settings.review_content_position }}{% endif %};
}



#t-{{ section.id }} .testimonial-author {
  margin-top: {% if section.settings.equalize_review_heights %}0{% else %}auto{% endif %};
}

{%- liquid
  # 'settings' emits nothing, so both star styles keep inheriting --stars-color
  # from the theme's general settings.
  assign stars_source = section.settings.stars_color_source
  assign stars_custom = section.settings.stars_color_custom
  if stars_source == 'custom' and stars_custom != blank and stars_custom.alpha != 0.0
    assign stars_override = stars_custom.red | append: ', ' | append: stars_custom.green | append: ', ' | append: stars_custom.blue
  elsif stars_source == 'palette'
    assign stars_override = 'var(--color-accent-1)'
  endif
-%}
{%- if section.settings.enable_rating and stars_override != blank %}
  #t-{{ section.id }} .stars {
    --testimonial-stars-color: {{ stars_override }};
  }

  #t-{{ section.id }} .stars__text--stars_color {
    color: rgb(var(--testimonial-stars-color));
  }
{%- endif -%}
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        {%- if section.settings.hide_desktop -%}
          display: none;
        {%- endif -%}
      }
    }
{%- endstyle -%}
{%- # endregion ══════════════════════════════════════════════════════════════ -%}

{%- # ════════════════════════════════════════════════════════════════════════ -%}
{%- # region(collapsed) Markup -%}
{%- render 'separator-top', section: section -%}

{%- capture attributes -%}
  id="{{ section.settings.section_id }}"
  class="color-{{ section.settings.color_palette }} section-{{ section.id }}-padding{% if section.settings.enable_cut_bg_color or bgimage != blank or bgimagemobile != blank %} cut-colored-section{% endif %}"
  data-section-id="{{ section.id }}"
{%- endcapture -%}

<div {{ attributes }}>
  <div class="custom-section container container--{{ section.settings.layout_width }}">
    <div class="scrolling-testimonials-section" id="t-{{ section.id }}">

       {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
          {%- render 'heading',
            alignment:  section.settings.alignment,
            enable_animations: enable_animations,
            animation: animation,
            subheading: section.settings.subheading,
            heading: section.settings.heading,
            description: section.settings.description,
            heading_class: 'scrolling__testimonials__heading',
            heading_style: section.settings.heading_style
          -%}
        {%- endif -%}

      
      <div class="scrolling-testimonials">
        <div class="testimonials-track">
          {% for block in section.blocks %}
            {% render 'testimonial-card',
              block: block,
              text: block.settings.text,
              name: block.settings.name,
              role: block.settings.role,
              image: block.settings.image,
              rating: block.settings.stars_rating,
              enable_rating: section.settings.enable_rating,
              stars_style: section.settings.stars_style,
              verified: block.settings.verified,
              unique: block.id
            %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{%- render 'separator-bottom', section: section -%}
{%- # endregion ══════════════════════════════════════════════════════════════ -%}

<script>
    document.querySelectorAll('#t-{{ section.id }}').forEach((section) => {
      const track = section.querySelector('.testimonials-track');
      if (!track || track.dataset.duplicated === 'true') return;

      // duplicate content 4 times for smooth infinite scroll
      const content = track.innerHTML;
      track.innerHTML += content + content + content + content;

      // set width for CSS animation (divide by 5 because original + 4 duplicates)
      track.style.setProperty('--track-width', `${track.scrollWidth / 5}px`);

      track.dataset.duplicated = 'true';
    });
</script>

