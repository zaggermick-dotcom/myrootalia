  {%- comment -%} ========== DONNÉES VARIANTES ========== {%- endcomment -%}
  <script type="application/json" data-mrt-variants>
    [{%- for v in product.variants -%}
      {"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"cap":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"img":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}]
  </script>

  {%- comment -%} ========== SCRIPT ========== {%- endcomment -%}
  <script>
  (function () {
    var root = document.getElementById('mrt-pp-{{ uid }}');
    if (!root) return;

    var variants = JSON.parse(root.querySelector('[data-mrt-variants]').textContent);
    var current = variants.find(function (v) { return v.id === {{ v0.id }}; }) || variants[0];
    var shopRoot = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    var money = new Intl.NumberFormat('{{ request.locale.iso_code | default: "fr-CA" }}', { style: 'currency', currency: '{{ cart.currency.iso_code | default: "CAD" }}' });
    var fmt = function (cents) { return money.format(cents / 100); };

    /* ---------- galerie ---------- */
    var mainImg = root.querySelector('[data-mrt-main]');
    root.querySelectorAll('[data-mrt-thumb]').forEach(function (t) {
      t.addEventListener('click', function () {
        root.querySelectorAll('[data-mrt-thumb]').forEach(function (x) { x.classList.remove('is-active'); });
        t.classList.add('is-active');
        if (mainImg) { mainImg.style.opacity = 0; setTimeout(function () { mainImg.src = t.dataset.mrtThumb; mainImg.style.opacity = 1; }, 180); }
      });
    });

    /* ---------- variantes ---------- */
    var optGroups = root.querySelectorAll('[data-mrt-option-index]');
    function selectedOptions() {
      return Array.prototype.map.call(optGroups, function (g) {
        var a = g.querySelector('.mrt-opt.is-active');
        return a ? a.dataset.mrtValue : null;
      });
    }
    function refreshVariant() {
      if (!optGroups.length) return;
      var sel = selectedOptions();
      current = variants.find(function (v) {
        return v.options.every(function (o, i) { return o === sel[i]; });
      }) || null;
      var priceEl = root.querySelector('[data-mrt-price]');
      var cmpEl = root.querySelector('[data-mrt-compare]');
      var saveEl = root.querySelector('[data-mrt-save]');
      var saveAmt = root.querySelector('[data-mrt-save-amt]');
      var stickyPrice = root.querySelector('[data-mrt-sticky-price]');
      root.querySelectorAll('[data-mrt-atc]').forEach(function (btn) {
        var label = btn.querySelector('.mrt-btn-label');
        if (current && current.available) {
          btn.disabled = false;
          btn.dataset.mrtVariant = current.id;
          if (label && label.textContent === 'Épuisé') label.textContent = 'Commencer ma routine';
        } else {
          btn.disabled = true;
          if (label) label.textContent = current ? 'Épuisé' : 'Indisponible';
        }
      });
      if (!current) return;
      if (priceEl) priceEl.textContent = fmt(current.price);
      if (stickyPrice) stickyPrice.textContent = fmt(current.price);
      var onSale = current.cap > current.price;
      if (cmpEl) { cmpEl.hidden = !onSale; cmpEl.textContent = onSale ? fmt(current.cap) : ''; }
      if (saveEl) saveEl.hidden = !onSale;
      if (saveAmt && onSale) saveAmt.textContent = fmt(current.cap - current.price);
      if (current.img && mainImg) { mainImg.style.opacity = 0; setTimeout(function () { mainImg.src = current.img; mainImg.style.opacity = 1; }, 180); }
    }
    optGroups.forEach(function (g) {
      g.querySelectorAll('.mrt-opt').forEach(function (b) {
        b.addEventListener('click', function () {
          g.querySelectorAll('.mrt-opt').forEach(function (x) { x.classList.remove('is-active'); });
          b.classList.add('is-active');
          refreshVariant();
        });
      });
    });

    /* ---------- quantité ---------- */
    var qtyInput = root.querySelector('[data-mrt-qty]');
    var minus = root.querySelector('[data-mrt-qty-minus]');
    var plus = root.querySelector('[data-mrt-qty-plus]');
    if (minus) minus.addEventListener('click', function () { qtyInput.value = Math.max(1, parseInt(qtyInput.value || 1, 10) - 1); });
    if (plus) plus.addEventListener('click', function () { qtyInput.value = parseInt(qtyInput.value || 1, 10) + 1; });

    /* ---------- dates de livraison ---------- */
    function fdate(d) { return d.toLocaleDateString('fr-CA', { day: 'numeric', month: 'long' }); }
    var dmin = new Date(); dmin.setDate(dmin.getDate() + 3);
    var dmax = new Date(); dmax.setDate(dmax.getDate() + 8);
    var elMin = root.querySelector('[data-mrt-date-min]'); if (elMin) elMin.textContent = fdate(dmin);
    var elMax = root.querySelector('[data-mrt-date-max]'); if (elMax) elMax.textContent = fdate(dmax);

    /* ---------- SYNCHRO PANIER (tiroir + bulle du thème) ---------- */
    var toast = root.querySelector('[data-mrt-toast]');
    function showToast() {
      if (!toast) return;
      toast.classList.add('is-visible');
      clearTimeout(toast._t);
      toast._t = setTimeout(function () { toast.classList.remove('is-visible'); }, 4200);
    }
    function refreshBubble() {
      return fetch(shopRoot + '?sections=cart-icon-bubble')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var holder = document.getElementById('cart-icon-bubble');
          if (holder && data['cart-icon-bubble']) {
            var doc = new DOMParser().parseFromString(data['cart-icon-bubble'], 'text/html');
            var inner = doc.querySelector('.shopify-section');
            if (inner) holder.innerHTML = inner.innerHTML;
          }
        }).catch(function () {});
    }
    function addToCart(btn) {
      var drawer = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      var errEl = root.querySelector('[data-mrt-error]');
      var fd = new FormData();
      fd.append('id', btn.dataset.mrtVariant);
      fd.append('quantity', qtyInput ? qtyInput.value : 1);
      if (drawer && typeof drawer.renderContents === 'function') {
        fd.append('sections', drawer.getSectionsToRender().map(function (s) { return s.id; }).join(','));
        fd.append('sections_url', window.location.pathname);
        if (typeof drawer.setActiveElement === 'function') drawer.setActiveElement(document.activeElement);
      }
      btn.classList.add('is-loading');
      if (errEl) errEl.classList.remove('is-visible');
      fetch(shopRoot + 'cart/add.js', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' }, body: fd })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.status) {
            if (errEl) { errEl.textContent = data.description || 'Impossible d’ajouter au panier.'; errEl.classList.add('is-visible'); }
            return;
          }
          if (drawer && typeof drawer.renderContents === 'function') {
            drawer.renderContents(data);          /* met à jour tiroir + bulle, et ouvre le tiroir */
          } else {
            refreshBubble().then(showToast);      /* repli : bulle header + toast élégant */
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
        })
        .catch(function () { window.location.href = '{{ routes.cart_url }}'; })
        .finally(function () { btn.classList.remove('is-loading'); });
    }
    root.querySelectorAll('[data-mrt-atc]').forEach(function (btn) {
      btn.addEventListener('click', function () { addToCart(btn); });
    });

    /* ---------- barre sticky ---------- */
    var sticky = root.querySelector('[data-mrt-sticky]');
    var hero = document.getElementById('mrt-acheter-{{ uid }}');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        sticky.classList.toggle('is-visible', !entries[0].isIntersecting);
      }, { rootMargin: '-80px 0px 0px 0px' }).observe(hero);
    }

    /* ---------- défilement doux vers l'achat ---------- */
    root.querySelectorAll('[data-mrt-scroll]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        if (hero) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* ---------- apparitions au défilement ---------- */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      root.querySelectorAll('.mrt-reveal').forEach(function (el) { io.observe(el); });
    } else {
      root.querySelectorAll('.mrt-reveal').forEach(function (el) { el.classList.add('is-in'); });
    }
  })();
  </script>
</div>
{%- endif -%}
