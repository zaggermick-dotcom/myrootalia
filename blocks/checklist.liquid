{%- liquid
  assign items = block.settings.items | newline_to_br | split: '<br />'
  assign icon = block.settings.icon | default: 'check_mark'
  assign icon_size = block.settings.icon_size | default: 16
  assign gap = block.settings.gap | default: 6
-%}

{%- style -%}
  .custom-checklist--{{ block.id }} {
    flex: var(--group-child-flex, 1 1 0%);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .custom-checklist--{{ block.id }} .custom-checklist__item {
    display: flex;
    align-items: {% if block.settings.align_icon_top %}flex-start{% else %}center{% endif %};
    gap: 0.8rem;
  }

  .custom-checklist--{{ block.id }} .custom-checklist__item + .custom-checklist__item {
    margin-top: {{ gap | divided_by: 10.0 }}rem;
  }

  .custom-checklist--{{ block.id }} .custom-checklist__item svg {
    flex-shrink: 0;
    width: {{ icon_size }}px;
    height: {{ icon_size }}px;
    {%- if block.settings.icon_color != blank and block.settings.icon_color.alpha != 0.0 %}
      fill: {{ block.settings.icon_color }};
      color: {{ block.settings.icon_color }};
    {%- else %}
      fill: rgb(var(--color-accent-1, 18,18,18));
      color: rgb(var(--color-accent-1, 18,18,18));
    {%- endif %}
  }

  .custom-checklist--{{ block.id }} .custom-checklist__custom-icon {
    flex-shrink: 0;
    width: {{ icon_size }}px;
    height: auto;
  }

  {%- if block.settings.align_icon_top %}
    .custom-checklist--{{ block.id }} .custom-checklist__item svg,
    .custom-checklist--{{ block.id }} .custom-checklist__custom-icon {
      margin-top: 0.2em;
    }
  {%- endif %}

  {%- if block.settings.mobile_hidden %}
    @media screen and (max-width: 749px) {
      .custom-checklist--{{ block.id }} {
        display: none;
      }
    }
  {%- endif %}
{%- endstyle -%}

{%- if block.settings.items != blank -%}
  <ul
    class="custom-checklist custom-checklist--{{ block.id }}"
    {% render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation %}
    {{ block.shopify_attributes }}
  >
    {%- for item in items -%}
      {%- assign item = item | strip -%}
      {%- if item != blank -%}
        <li class="custom-checklist__item">
          {%- if block.settings.icon_custom != blank -%}
            {{
              block.settings.icon_custom
              | image_url: width: 120
              | image_tag: loading: 'lazy', class: 'custom-checklist__custom-icon', widths: '40, 80, 120'
            }}
          {%- else -%}
            {%- render 'icons', icon: icon, width: icon_size -%}
          {%- endif -%}
          <span>{{ item }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}

