{%- comment -%} Path lives in icon-star-sprite, rendered once per page. {%- endcomment -%}
<svg
  class="icon icon-star {{ class }}"
  aria-hidden="true"
  focusable="false"
  width="{{ width | default: 20 }}"
  height="{{ width | default: 20 }}"
  viewBox="0 0 512.001 512.001"
><use href="#story-icon-star"></use></svg>
