<div class="testimonial-card content-container" {{ block.shopify_attributes }}>
  
  {%- if enable_rating -%}
    {%- render 'block-stars',
      unique: unique,
      rating: rating,
      style: stars_style
    -%}
  {%- endif -%}

  <p class="testimonial-text">
    {{ text }}
  </p>

  <div class="testimonial-author">

    {% if image != blank %}
      <img src="{{ image | image_url: width: 80 }}" loading="lazy">
    {% endif %}

    <div>
      <strong>
        {{ name }}
        {%- if verified -%}
          {% render 'icons', icon: 'check_mark' %}
        {%- endif -%}
      </strong>

      <span>{{ role }}</span>
    </div>

  </div>

</div>
