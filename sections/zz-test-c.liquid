        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Applique"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Quelques gouttes sur cuir chevelu propre et sec, directement à la racine.</p>"
        },
        {
          "type": "header",
          "content": "Fenêtre de détail (optionnelle)"
        },
        {
          "type": "text",
          "id": "button_label",
