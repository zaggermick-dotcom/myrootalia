{%- render 'script' with 'product-form', defer: true -%}

<script>
  (function () {
    var root = document.getElementById('mre-landing');
    if (!root) return;
    var q = function (sel, ctx) { return (ctx || root).querySelector('[data-mre="' + sel + '"]'); };

    /* ---- Palettes ---- */
    root.querySelectorAll('.drop').forEach(function (el) {
      el.addEventListener('click', function () {
        root.setAttribute('data-theme', el.dataset.t);
        root.querySelectorAll('.drop').forEach(function (d) { d.classList.remove('active'); });
        el.classList.add('active');
      });
    });

    /* ---- Galerie ---- */
    var thumbs = root.querySelectorAll('.gal__thumb');
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () {
        var i = t.dataset.thumb;
        root.querySelectorAll('.gal__slide').forEach(function (s) {
          s.classList.toggle('is-active', s.dataset.slide === i);
        });
        thumbs.forEach(function (o) { o.classList.toggle('is-active', o === t); });
      });
    });

    /* ---- Sélecteur de packs ---- */
    var opts = root.querySelectorAll('.packsel__opt');
    var variantInput = q('variant-id');
    var ship = q('ship');
    var atc = q('atc');

    var money = function (cents) {
      try {
        return new Intl.NumberFormat(document.body.dataset.shopLocale || 'fr-CA', {
          style: 'currency',
          currency: document.body.dataset.shopCurrency || 'CAD',
          minimumFractionDigits: 0,
          maximumFractionDigits: 2
        }).format(cents / 100);
      } catch (e) {
        return (cents / 100).toFixed(2);
      }
    };

    var updateShipping = function (price) {
      if (!ship) return;
      var threshold = parseInt(ship.dataset.threshold, 10) || 0;
      var text = q('ship-text');
      var fill = q('ship-fill');
      if (threshold <= 0) { ship.hidden = true; return; }
      if (price >= threshold) {
        ship.classList.add('is-free');
        text.textContent = '✓ Livraison gratuite incluse';
        fill.style.width = '100%';
      } else {
        ship.classList.remove('is-free');
        text.textContent = 'Plus que ' + money(threshold - price) + ' pour la livraison gratuite';
        fill.style.width = Math.round((price / threshold) * 100) + '%';
      }
    };

    var select = function (opt) {
      if (!opt || opt.dataset.available !== 'true') return;

      opts.forEach(function (o) { o.classList.toggle('is-selected', o === opt); });
      var radio = opt.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      if (variantInput) variantInput.value = opt.dataset.variant;

      /* Le pack par défaut peut être en rupture : on réactive le bouton dès qu'un pack dispo est choisi. */
      if (atc) {
        atc.disabled = false;
        var atcText = q('atc-text');
        if (atcText) atcText.textContent = 'Ajouter au panier';
      }

      var price = parseInt(opt.dataset.price, 10) || 0;
      var save = parseInt(opt.dataset.save, 10) || 0;
      var units = parseInt(opt.dataset.units, 10) || 1;

      var priceEl = q('price');
      var compareEl = q('compare');
      var saveEl = q('save');
      var unitEl = q('unit');

      if (priceEl) priceEl.textContent = opt.dataset.priceF;
      if (compareEl) { compareEl.textContent = opt.dataset.compareF; compareEl.hidden = save <= 0; }
      if (saveEl) { saveEl.textContent = opt.dataset.saveF; saveEl.hidden = save <= 0; }
      if (unitEl) { unitEl.textContent = opt.dataset.unitF; unitEl.hidden = units < 2; }

      var stickyName = q('sticky-name');
      var stickyPrice = q('sticky-price');
      if (stickyName) stickyName.textContent = opt.dataset.name;
      if (stickyPrice) stickyPrice.textContent = opt.dataset.priceF;

      updateShipping(price);
    };

    opts.forEach(function (opt) {
      opt.addEventListener('click', function () { select(opt); });
      opt.addEventListener('keydown', function (e) {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); select(opt); }
      });
    });

    var initial = root.querySelector('.packsel__opt.is-selected') || opts[0];
    if (initial) {
      updateShipping(parseInt(initial.dataset.price, 10) || 0);
    }

    /* ---- Barre sticky ---- */
    var sticky = q('sticky');
    var stickyAtc = q('sticky-atc');
    var buybox = document.getElementById('buybox');

    if (stickyAtc && atc) {
      stickyAtc.addEventListener('click', function () {
        if (atc.disabled) return;
        atc.click();
      });
    }

    if (sticky && buybox && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          sticky.classList.toggle('is-visible', !entry.isIntersecting);
        });
      }, { rootMargin: '-120px 0px 0px 0px' }).observe(buybox);
    }
  })();
</script>

