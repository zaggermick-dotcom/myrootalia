{%- liquid
  assign rich_title = block.settings.title
  assign heading_style = block.settings.heading_style | default: 'none'
  assign color = block.settings.color

  case heading_style
    when '1'
      assign level = settings.heading_1_level
    when '2'
      assign level = settings.heading_2_level
    when '3'
      assign level = settings.heading_3_level
    else
      assign level = 2
  endcase

  # Plain paragraphs are unwrapped into a real <hN> (theme styles + SEO), with
  # line breaks joined by <br> so they stay inside the heading.
  # Richer content (Aa heading styles, lists) renders as-is.
  assign rich_mode = 'block'
  if rich_title != blank
    assign is_simple = true
    if rich_title contains '<h1' or rich_title contains '<h2' or rich_title contains '<h3'
      assign is_simple = false
    endif
    if rich_title contains '<h4' or rich_title contains '<h5' or rich_title contains '<h6'
      assign is_simple = false
    endif
    if rich_title contains '<ul' or rich_title contains '<ol'
      assign is_simple = false
    endif
    if is_simple
      assign rich_mode = 'heading'
      assign rich_inner = ''
      assign rich_lines = rich_title | split: '</p>'
      for line in rich_lines
        assign piece = line | remove_first: '<p>' | strip
        if piece != blank
          if rich_inner == blank
            assign rich_inner = piece
          else
            assign rich_inner = rich_inner | append: '<br>' | append: piece
          endif
        endif
      endfor
    endif
  endif

  # Rich mode mirrors the selected style's global separator settings.
  assign sep_enabled = false
  case heading_style
    when '1'
      assign sep_enabled = settings.heading_1_separator
      assign sep_color_setting = settings.heading_1_separator_color
    when '2'
      assign sep_enabled = settings.heading_2_separator
      assign sep_color_setting = settings.heading_2_separator_color
    when '3'
      assign sep_enabled = settings.heading_3_separator
      assign sep_color_setting = settings.heading_3_separator_color
  endcase
  unless block.settings.show_separator
    assign sep_enabled = false
  endunless
-%}

{%- style -%}
  .custom-heading--{{ block.id }} {
    flex: var(--group-child-flex, 1 1 0%);
    min-width: 0;
  }

  {%- if rich_title != blank and rich_mode == 'block' %}
    /* Native tag size hierarchy; only theme casing/spacing applied. */
    .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6) {
      {%- if settings.headings_uppercase %}
        text-transform: uppercase;
      {%- endif %}
      letter-spacing: {{ settings.headings_letter_spacing }}px;
    }

    {%- if sep_enabled %}
      .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6) {
        position: relative;
        padding-bottom: {{ settings.heading_separator_spacing | divided_by: 10.0 }}rem;
      }

      .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6)::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        width: 10rem;
        background-color:
          {%- if sep_color_setting == 'accent-1' -%}
            rgba(var(--color-accent-1))
          {%- elsif sep_color_setting == 'accent-2' -%}
            rgba(var(--color-accent-2))
          {%- elsif sep_color_setting == 'background-2' -%}
            rgba(var(--color-background-secondary))
          {%- else -%}
            rgba(var(--color-foreground))
          {%- endif -%};
      }
    {%- endif %}
  {%- endif %}

  /* Overrides .rte's fixed heading margins; the parent gap spaces blocks. */
  .custom-heading--{{ block.id }} .heading,
  .custom-heading--{{ block.id }} .custom-heading__rich > :last-child {
    margin-bottom: {{ block.settings.spacing_bottom | default: 0 }}px;
  }

  {%- unless block.settings.bold %}
    .custom-heading--{{ block.id }} .heading,
    .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6) {
      font-weight: 400;
    }
  {%- endunless %}

  {%- if block.settings.custom_size %}
    .custom-heading--{{ block.id }} .heading,
    .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6) {
      font-size: {{ block.settings.size_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .custom-heading--{{ block.id }} .heading,
      .custom-heading--{{ block.id }} .custom-heading__rich :is(h1, h2, h3, h4, h5, h6) {
        font-size: {{ block.settings.size_desktop }}px;
      }
    }
  {%- endif %}

  {%- unless block.settings.show_separator %}
    .custom-heading--{{ block.id }} .heading {
      padding-bottom: 0;
    }

    .custom-heading--{{ block.id }} .heading::after {
      content: none;
    }
  {%- endunless %}
{%- endstyle -%}

{%- # Always rendered: the editor needs a DOM node to select the block. -%}
<div class="custom-heading custom-heading--{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if rich_title != blank or block.settings.subheading != blank -%}
    <div class="heading__section {{ block.settings.alignment }}">
      {%- if block.settings.subheading != blank -%}
        <p
          class="h3 subheading"
          {% if color != blank and color.alpha != 0.0 -%}
            style="color:{{ color }}"
          {%- endif %}
          {%- render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation -%}
        >
          {{ block.settings.subheading }}
        </p>
      {%- endif -%}
      {%- if rich_title != blank -%}
        {%- if rich_mode == 'heading' -%}
          <h{{ level }}
            class="heading heading__style--{{ heading_style }}"
            {% if color != blank and color.alpha != 0.0 -%}
              style="color:{{ color }}"
            {%- endif %}
            {%- render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation -%}
          >
            <span>{{ rich_inner }}</span>
          </h{{ level }}>
        {%- else -%}
          <div
            class="custom-heading__rich rte"
            {% if color != blank and color.alpha != 0.0 -%}
              style="color:{{ color }}"
            {%- endif %}
            {%- render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation -%}
          >
            {{ rich_title }}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.advanced_custom_section.heading_block",
  "tag": null,
  "settings": [
   {
      "type": "header",
      "content": "t:sections.global.headers.text"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.global.subheading.label"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "t:sections.global.heading.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.advanced_custom_section.heading_settings.seo_info"
    },
    {
      "type": "select",
      "id": "heading_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.global.style.options.none"
        },
        {
          "value": "1",
          "label": "t:sections.global.style.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.global.style.options.2"
        },
        {
          "value": "3",
          "label": "t:sections.global.style.options.3"
        }
      ],
      "default": "none",
      "label": "t:sections.global.style.heading"
    },
    {
      "type": "checkbox",
      "id": "bold",
      "label": "t:sections.advanced_custom_section.heading_settings.bold",
      "info": "t:sections.advanced_custom_section.heading_settings.bold_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "custom_size",
      "label": "t:sections.advanced_custom_section.heading_settings.custom_size",
      "default": false
    },
    {
      "type": "range",
      "id": "size_desktop",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "t:sections.advanced_custom_section.heading_settings.size_desktop",
      "default": 32,
      "visible_if": "{{ block.settings.custom_size }}"
    },
    {
      "type": "range",
      "id": "size_mobile",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "t:sections.advanced_custom_section.heading_settings.size_mobile",
      "default": 24,
      "visible_if": "{{ block.settings.custom_size }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "t:sections.advanced_custom_section.heading_settings.spacing_bottom",
      "info": "t:sections.advanced_custom_section.heading_settings.spacing_bottom_info",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "t:sections.advanced_custom_section.heading_settings.show_separator",
      "info": "t:sections.advanced_custom_section.heading_settings.show_separator_info",
      "default": true,
      "visible_if": "{{ block.settings.heading_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:sections.advanced_custom_section.heading_settings.color",
      "info": "t:sections.advanced_custom_section.icon.color_info"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.global.alignment.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.global.alignment.options.center"
        },
        {
          "value": "right",
          "label": "t:sections.global.alignment.options.right"
        }
      ],
      "default": "left",
      "label": "t:sections.global.alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.headers.animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "t:sections.global.animation.enable",
      "default": true
    },
    {
      "type": "select",
      "id": "animation",
      "options": [
        {
          "value": "fade-up",
          "label": "t:sections.global.animation.options.fade_up"
        },
        {
          "value": "fade-down",
          "label": "t:sections.global.animation.options.fade_down"
        },
        {
          "value": "fade-right",
          "label": "t:sections.global.animation.options.fade_right"
        },
        {
          "value": "fade-left",
          "label": "t:sections.global.animation.options.fade_left"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.global.animation.options.zoom_in"
        },
        {
          "value": "zoom-out",
          "label": "t:sections.global.animation.options.zoom_out"
        }
      ],
      "default": "fade-up",
      "label": "t:sections.global.animation.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.advanced_custom_section.heading_block",
      "category": "t:categories.content",
      "settings": {
        "title": "<p>Hear from our lovely customers</p>"
      }
    }
  ]
}
{% endschema %}
