{%- liquid
  assign layout = section.settings.layout | default: 'classic'
-%}
{%- case layout -%}
  {%- when 'sidebar' -%}
    {{ 'component-e-tabs.css' | asset_url | stylesheet_tag }}
  {%- when 'stacked' -%}
    {{ 'component-e-tabs-alternate.css' | asset_url | stylesheet_tag }}
  {%- else -%}
    {{ 'section-tabs.css' | asset_url | stylesheet_tag }}
{%- endcase -%}

{%- liquid
  # Each layout keeps the container class its stylesheet expects.
  case layout
    when 'sidebar'
      assign container_class = 'e-tabs'
      assign heading_class = 'e-tabs__heading'
    when 'stacked'
      assign container_class = 'e-tabs-alternate'
      assign heading_class = 'e-tabs-alternate__heading'
    else
      assign container_class = 'tabs'
      assign heading_class = 'video__heading'
  endcase

  assign sectionId = section.id | remove: '-'
  assign enable_animations = section.settings.enable_animations
  assign animation = section.settings.animation

  assign bgImage = section.settings.image_bg_colored
  assign bgImageMobile = section.settings.image_bg_colored_mobile
  if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank
    render 'cut-colored'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_sm }}px;
    padding-bottom: {{ section.settings.padding_bottom_sm }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- render 'separator-top', section: section -%}

<div id="{{ section.settings.section_id }}" class="color-{{ section.settings.color_palette }} section-{{ section.id }}-padding{% if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank %} cut-colored-section{% endif %}">
  <div class="{{ container_class }} container container--{{ section.settings.layout_width }}">
    {%- liquid
      for block in section.blocks
        if block.type == "picto"
          render "pictogram", block: block
        endif
      endfor
    -%}
    
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      {%- render 'heading',
        alignment: section.settings.alignment,
        enable_animations: section.settings.enable_animations,
        animation: section.settings.animation,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        description: section.settings.description,
        heading_class: heading_class,
        heading_style: section.settings.heading_style
      -%}
    {%- endif -%}

    {%- case layout -%}

      {%- when 'sidebar' -%}
        {%- assign prefix = 'e-tabs' -%}
        <theme-tabs
          class="{{ prefix }}__wrapper"
          data-active-class="{{ prefix }}__nav-item--active"
          data-panel-active-class="{{ prefix }}__panel--active"
        >
          <div class="{{ prefix }}__content">
            <div class="{{ prefix }}__grid">
              <div class="{{ prefix }}__nav">
                <div class="{{ prefix }}__nav-list" role="tablist">
                  {%- for block in section.blocks -%}
                    {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
                    {%- render 'tab-nav-button', block: block, section: section, prefix: prefix, first: forloop.first, with_icon: true -%}
                  {%- endfor -%}
                </div>
              </div>
              <div class="{{ prefix }}__panels">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
                  {%- render 'tab-panel', block: block, section: section, prefix: prefix, first: forloop.first, with_button: false -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </theme-tabs>

      {%- when 'stacked' -%}
        {%- assign prefix = 'e-tabs-alternate' -%}
        <theme-tabs
          class="{{ prefix }}__wrapper"
          data-active-class="{{ prefix }}__nav-item--active"
          data-panel-active-class="{{ prefix }}__panel--active"
        >
          <div class="{{ prefix }}__content">
            <div class="{{ prefix }}__nav {{ prefix }}__nav--{{ section.settings.nav_alignment }}">
              <div class="{{ prefix }}__nav-list" role="tablist">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
                  {%- render 'tab-nav-button', block: block, section: section, prefix: prefix, first: forloop.first, with_icon: false -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="{{ prefix }}__panels">
              {%- for block in section.blocks -%}
                {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
                {%- render 'tab-panel', block: block, section: section, prefix: prefix, first: forloop.first, with_button: true -%}
              {%- endfor -%}
            </div>
          </div>
        </theme-tabs>

      {%- else -%}
        <div class="tabs__wrapper">
          <div class="tabs__header" {%- render 'animation', enable_animations: enable_animations, animation: animation -%}>
            {%- for block in section.blocks -%}
              {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
              <div
                data-tab="tab__{{ sectionId }}_{{ block.id | remove: "-" }}"
                class="tab__button{% if forloop.first == true %} active{% endif %}"
                {%- render 'animation', enable_animations: enable_animations, animation: animation -%}
              >
                <h3 class="tabs__heading">
                  {%- render 'icons', icon: block.settings.icon -%}
                  {{ block.settings.heading }}
                </h3>
              </div>
            {%- endfor -%}
          </div>
          <div class="tabs__inner">
            {%- for block in section.blocks -%}
              {%- if block.type != 'tab' -%}{%- continue -%}{%- endif -%}
              <div
                id="tab__{{ sectionId }}_{{ block.id | remove: "-" }}"
                class="tab__content"
                {%- render 'animation', enable_animations: enable_animations, animation: animation -%}
              >
                {{ block.settings.text }}
                {{ block.settings.page_content.content }}
              </div>
            {%- endfor -%}
          </div>
        </div>

    {%- endcase -%}
  </div>
</div>

{%- if layout == 'classic' -%}
  {%- render 'tabs-theme-editor', sectionId: sectionId -%}
{%- else -%}
  {%- render 'tabs-panels' -%}
{%- endif -%}

{%- render 'separator-bottom', section: section -%}

