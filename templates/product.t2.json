            "duree": "30 secondes",
            "icone": "compte_gouttes",
            "title": "Applique",
            "description": "<p>Quelques gouttes sur cuir chevelu propre et sec, directement à la racine grâce à l'embout.</p>",
            "button_label": "Le bon geste",
            "modal_title": "Bien appliquer",
            "modal_content": "Sépare tes cheveux en quelques raies et dépose les gouttes directement sur le cuir chevelu, pas sur les longueurs. 6 à 8 gouttes suffisent pour toute la tête."
          }
        },
        "s1": {
          "type": "etape",
          "settings": {
            "duree": "1 minute",
            "icone": "massage",
            "title": "Masse",
