{%- liquid
  assign alignment = block.settings.alignment | default: 'left'
  assign style = block.settings.stars_style | default: 'stars'

  case alignment
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'flex-start'
  endcase
-%}

{%- style -%}
  .custom-rating--{{ block.id }} {
    flex: var(--group-child-flex, 1 1 0%);
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    justify-content: {{ justify }};
  }

  .custom-rating--{{ block.id }} .custom-rating__text {
    margin: 0;
  }

  {%- if block.settings.color != blank and block.settings.color.alpha != 0.0 %}
    /* Per-block override; blank follows the global stars style. */
    .custom-rating--{{ block.id }} .stars {
      --stars-color: {{ block.settings.color.red }}, {{ block.settings.color.green }}, {{ block.settings.color.blue }};
    }
  {%- endif %}

  {%- if block.settings.mobile_hidden %}
    @media screen and (max-width: 749px) {
      .custom-rating--{{ block.id }} {
        display: none;
      }
    }
  {%- endif %}
{%- endstyle -%}

{%- if style != 'none' or block.settings.text != blank -%}
  <div
    class="custom-rating custom-rating--{{ block.id }}"
    {% render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation %}
    {{ block.shopify_attributes }}
  >
    {%- render 'block-stars',
      unique: block.id,
      rating: block.settings.rating,
      style: style,
      star_first: block.settings.star_first,
      show_max: block.settings.show_max
    -%}

    {%- if block.settings.text != blank -%}
      <p class="custom-rating__text stars__text">{{ block.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.advanced_custom_section.blocks.rating",
  "tag": null,
  "class": "custom-rating-block",
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "/5",
      "label": "t:sections.product.blocks.rating.rating.label",
      "default": 4.8
    },
    {
      "type": "select",
      "id": "stars_style",
      "label": "t:settings_schema.stars.stars_style.label",
      "info": "t:sections.advanced_custom_section.rating.stars_style_info",
      "options": [
        { "value": "stars", "label": "t:settings_schema.stars.stars_style.options.stars" },
        { "value": "full", "label": "t:settings_schema.stars.stars_style.options.full" },
        { "value": "mini", "label": "t:settings_schema.stars.stars_style.options.mini" },
        { "value": "none", "label": "t:settings_schema.stars.stars_style.options.none" }
      ],
      "default": "stars"
    },
    {
      "type": "checkbox",
      "id": "star_first",
      "label": "t:sections.advanced_custom_section.rating.star_first",
      "default": false,
      "visible_if": "{{ block.settings.stars_style == 'mini' }}"
    },
    {
      "type": "checkbox",
      "id": "show_max",
      "label": "t:sections.advanced_custom_section.rating.show_max",
      "default": false,
      "visible_if": "{{ block.settings.stars_style == 'mini' }}"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:sections.advanced_custom_section.rating.color",
      "info": "t:sections.advanced_custom_section.rating.color_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.advanced_custom_section.rating.text.label",
      "default": "t:sections.advanced_custom_section.rating.text_default"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        { "value": "left", "label": "t:sections.global.alignment.options.left" },
        { "value": "center", "label": "t:sections.global.alignment.options.center" },
        { "value": "right", "label": "t:sections.global.alignment.options.right" }
      ],
      "default": "left",
      "label": "t:sections.global.alignment.label"
    },
    {
      "type": "checkbox",
      "id": "mobile_hidden",
      "label": "t:sections.advanced_custom_section.hide_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.headers.animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "t:sections.global.animation.enable",
      "default": true
    },
    {
      "type": "select",
      "id": "animation",
      "options": [
        { "value": "fade-up", "label": "t:sections.global.animation.options.fade_up" },
        { "value": "fade-down", "label": "t:sections.global.animation.options.fade_down" },
        { "value": "fade-right", "label": "t:sections.global.animation.options.fade_right" },
        { "value": "fade-left", "label": "t:sections.global.animation.options.fade_left" },
        { "value": "zoom-in", "label": "t:sections.global.animation.options.zoom_in" },
        { "value": "zoom-out", "label": "t:sections.global.animation.options.zoom_out" }
      ],
      "default": "fade-up",
      "label": "t:sections.global.animation.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.advanced_custom_section.blocks.rating",
      "category": "t:categories.selling"
    }
  ]
}
{% endschema %}
