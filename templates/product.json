            "emoji": "",
            "titre": "Ingrédients & formule",
            "contenu": "<ul><li><strong>Huile de romarin</strong> — l'actif star des routines cuir chevelu sain.</li><li><strong>Huile de ricin</strong> — nourrit et gaine la fibre.</li><li><strong>Biotine</strong> — associée à la force des cheveux.</li><li><strong>Jojoba &amp; argan</strong> — texture légère, absorption rapide.</li></ul><p>Sans sulfates ni parabènes. Parfum naturel léger. Vegan &amp; cruelty-free.</p>",
            "ouvert": false
          }
        },
        "acc_usage": {
          "type": "accordeon",
          "settings": {
            "emoji": "",
            "titre": "Comment l'utiliser",
            "contenu": "<ul><li><strong>Applique</strong> quelques gouttes sur cuir chevelu propre et sec.</li><li><strong>Masse</strong> 1 à 2 minutes, du front à la nuque.</li><li><strong>Laisse poser</strong> — idéalement le soir. Usage quotidien.</li></ul><p>Les résultats s'installent avec la constance, en 8 à 12 semaines.</p>",
            "ouvert": false
          }
        },
