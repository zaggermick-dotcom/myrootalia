          { "value": "personnes", "label": "👥 Personnes" }, { "value": "question", "label": "❓ Question" },
          { "value": "info", "label": "ℹ️ Info" }, { "value": "oeil", "label": "👁️ Œil" },
          { "value": "liste", "label": "📋 Liste" }, { "value": "livre", "label": "📖 Livre" },
