{%- liquid
  assign alignment = block.settings.alignment | default: 'left'
  assign icon = block.settings.icon | default: 'none'
  assign icon_size = block.settings.icon_size | default: 14

  case alignment
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'flex-start'
  endcase

  assign bg = 'rgb(var(--color-accent-1, 18,18,18))'
  if block.settings.background_color != blank and block.settings.background_color.alpha != 0.0
    assign bg = block.settings.background_color
  endif

  assign fg = 'rgb(var(--color-background, 255,255,255))'
  if block.settings.text_color != blank and block.settings.text_color.alpha != 0.0
    assign fg = block.settings.text_color
  endif
-%}

{%- style -%}
  .custom-badge--{{ block.id }} {
    flex: var(--group-child-flex, 1 1 0%);
    min-width: 0;
    display: flex;
    justify-content: {{ justify }};
  }

  .custom-badge--{{ block.id }} .custom-badge__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical | divided_by: 10.0 }}rem {{ block.settings.padding_horizontal | divided_by: 10.0 }}rem;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ bg }};
    color: {{ fg }};
    font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
    font-weight: var(--font-body-weight-bold, 700);
    line-height: 1.2;
    {%- if block.settings.uppercase %}
      text-transform: uppercase;
      letter-spacing: 0.05em;
    {%- endif %}
  }

  .custom-badge--{{ block.id }} .custom-badge__pill svg {
    flex-shrink: 0;
    width: {{ icon_size }}px;
    height: {{ icon_size }}px;
    fill: currentColor;
    color: currentColor;
  }

  {%- if block.settings.mobile_hidden %}
    @media screen and (max-width: 749px) {
      .custom-badge--{{ block.id }} {
        display: none;
      }
    }
  {%- endif %}
{%- endstyle -%}

{%- if block.settings.text != blank -%}
  <div
    class="custom-badge custom-badge--{{ block.id }}"
    {% render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation %}
    {{ block.shopify_attributes }}
  >
    <span class="custom-badge__pill">
      {%- if icon != 'none' -%}
        {%- render 'icons', icon: icon, width: icon_size -%}
      {%- endif -%}
      <span>{{ block.settings.text }}</span>
    </span>
  </div>
{%- endif -%}

