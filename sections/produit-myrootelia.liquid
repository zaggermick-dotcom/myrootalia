{%- comment -%}
  myrootelia — Contenu page produit PREMIUM (sous la fiche Batana)
  Éditorial · haute conversion · CTA panier réels · animations reveal
  Conformité : allégations cosmétiques uniquement. Aucun faux avis / % inventé.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign v = product.selected_or_first_available_variant
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap');

  #mrp-{{ uid }} {
    --g: {{ s.color_green | default: '#2F5233' }};
    --g-dark: #223d27;
    --o: {{ s.color_gold | default: '#B07A3B' }};
    --o-dark: #946530;
    --c: {{ s.color_cream | default: '#F5F1EA' }};
    --ink: {{ s.color_ink | default: '#2B2B2B' }};
    --muted: #6a655c;
    --line: rgba(47,82,51,.10);
    --serif: 'Playfair Display', Georgia, serif;
    --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--sans); color: var(--ink); -webkit-font-smoothing: antialiased;
  }
  #mrp-{{ uid }} * { box-sizing: border-box; }
  #mrp-{{ uid }} img { display: block; max-width: 100%; }
  #mrp-{{ uid }} .mrp-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  #mrp-{{ uid }} .mrp-eyebrow { font-size: 11.5px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--o); margin: 0 0 14px; display: inline-flex; align-items: center; gap: 10px; }
  #mrp-{{ uid }} .mrp-eyebrow::before { content: ""; width: 26px; height: 1px; background: var(--o); opacity: .5; display: inline-block; }
  #mrp-{{ uid }} .mrp-eyebrow.mrp-line-both::after { content: ""; width: 26px; height: 1px; background: var(--o); opacity: .5; display: inline-block; }
  #mrp-{{ uid }} .mrp-h { font-family: var(--serif); font-weight: 600; color: var(--g); font-size: clamp(26px,3.6vw,42px); line-height: 1.12; margin: 0 0 18px; letter-spacing: .2px; }
  #mrp-{{ uid }} .mrp-h em { font-style: italic; color: var(--o); }
  #mrp-{{ uid }} .mrp-lead { font-size: clamp(15px,1.5vw,17px); line-height: 1.8; color: #4a463f; }

  /* Reveal */
  #mrp-{{ uid }} .mrp-rv { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
  #mrp-{{ uid }} .mrp-rv.mrp-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { #mrp-{{ uid }} .mrp-rv { opacity: 1 !important; transform: none !important; } }

  /* Boutons */
  #mrp-{{ uid }} .mrp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; font-family: var(--sans); font-weight: 600; font-size: 15px; letter-spacing: .3px; padding: 16px 34px; border-radius: 50px; text-decoration: none; border: none; transition: transform .25s ease, box-shadow .25s ease, background .25s ease; }
  #mrp-{{ uid }} .mrp-btn--gold { background: var(--o); color: #fff; box-shadow: 0 10px 26px rgba(176,122,59,.32); }
  #mrp-{{ uid }} .mrp-btn--gold:hover { background: var(--o-dark); transform: translateY(-2px); box-shadow: 0 16px 34px rgba(176,122,59,.4); }
  #mrp-{{ uid }} .mrp-btn--ghost { background: transparent; color: var(--g); border: 1.5px solid rgba(47,82,51,.35); }
  #mrp-{{ uid }} .mrp-btn--ghost:hover { border-color: var(--g); background: rgba(47,82,51,.05); }

  /* INTRO / manifeste */
  #mrp-{{ uid }} .mrp-intro { background: var(--c); padding: 84px 0; text-align: center; }
  #mrp-{{ uid }} .mrp-intro .mrp-h { max-width: 760px; margin: 0 auto 20px; }
  #mrp-{{ uid }} .mrp-intro .mrp-lead { max-width: 620px; margin: 0 auto; }
  #mrp-{{ uid }} .mrp-quote { font-family: var(--serif); font-style: italic; font-size: clamp(20px,2.6vw,28px); color: var(--g); line-height: 1.5; max-width: 780px; margin: 34px auto 0; }
  #mrp-{{ uid }} .mrp-quote span { color: var(--o); }

  /* BÉNÉFICES */
  #mrp-{{ uid }} .mrp-benefits { padding: 82px 0; }
  #mrp-{{ uid }} .mrp-bhead { text-align: center; max-width: 640px; margin: 0 auto 46px; }
  #mrp-{{ uid }} .mrp-bgrid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
  #mrp-{{ uid }} .mrp-bcard { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 34px 24px; text-align: center; transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
  #mrp-{{ uid }} .mrp-bcard:hover { transform: translateY(-6px); box-shadow: 0 22px 44px rgba(43,43,43,.10); border-color: rgba(176,122,59,.35); }
  #mrp-{{ uid }} .mrp-bicon { width: 60px; height: 60px; margin: 0 auto 18px; border-radius: 50%; background: linear-gradient(145deg, var(--c), #fff); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; color: var(--g); }
  #mrp-{{ uid }} .mrp-bicon svg { width: 28px; height: 28px; }
  #mrp-{{ uid }} .mrp-bt { font-family: var(--serif); font-size: 18px; color: var(--g); margin: 0 0 8px; }
  #mrp-{{ uid }} .mrp-bd { font-size: 13.5px; color: var(--muted); line-height: 1.6; margin: 0; }

  /* INGRÉDIENT spotlight */
  #mrp-{{ uid }} .mrp-ingr { padding: 90px 0; background: #fff; }
  #mrp-{{ uid }} .mrp-split { display: grid; grid-template-columns: 1.05fr 1fr; gap: 60px; align-items: center; }
  #mrp-{{ uid }} .mrp-media { position: relative; }
  #mrp-{{ uid }} .mrp-media img { border-radius: 22px; box-shadow: 0 34px 80px rgba(43,43,43,.18); position: relative; z-index: 2; }
  #mrp-{{ uid }} .mrp-ph { width: 100%; background: linear-gradient(150deg,#e9e0d2,var(--c) 55%,#dfe6dc); display: flex; align-items: center; justify-content: center; color: var(--g); position: relative; z-index: 2; }
  #mrp-{{ uid }} .mrp-ph svg { width: 56px; height: 56px; opacity: .32; }
  #mrp-{{ uid }} .mrp-media .mrp-ph { aspect-ratio: 4/5; border-radius: 22px; box-shadow: 0 34px 80px rgba(43,43,43,.14); }
  #mrp-{{ uid }} .mrp-step__img .mrp-ph { height: 100%; }
  #mrp-{{ uid }} .mrp-media::after { content: ""; position: absolute; inset: 22px -22px -22px 22px; border: 1.5px solid var(--o); border-radius: 22px; z-index: 1; opacity: .55; }
  #mrp-{{ uid }} .mrp-badge-pur { position: absolute; z-index: 3; top: 18px; left: 18px; background: var(--g); color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .5px; padding: 10px 16px; border-radius: 50px; box-shadow: 0 8px 20px rgba(47,82,51,.3); }
  #mrp-{{ uid }} .mrp-compo { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0; }
  #mrp-{{ uid }} .mrp-chip { background: var(--c); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; font-size: 13px; color: var(--g); font-weight: 500; }
  #mrp-{{ uid }} .mrp-chip b { color: var(--o); }
  #mrp-{{ uid }} .mrp-inci { margin-top: 8px; background: var(--c); border-left: 3px solid var(--o); border-radius: 0 12px 12px 0; padding: 14px 18px; font-size: 13.5px; color: #55504a; }
  #mrp-{{ uid }} .mrp-inci strong { color: var(--g); }

  /* FREE-FROM */
  #mrp-{{ uid }} .mrp-free { padding: 60px 0; background: var(--c); text-align: center; }
  #mrp-{{ uid }} .mrp-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 26px; }
  #mrp-{{ uid }} .mrp-pill { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--g); border: 1px solid var(--line); border-radius: 999px; padding: 11px 20px; font-size: 14px; font-weight: 500; }
  #mrp-{{ uid }} .mrp-pill svg { width: 16px; height: 16px; color: var(--o); flex: none; }

  /* RITUEL */
  #mrp-{{ uid }} .mrp-ritual { padding: 92px 0; background: var(--g); color: #eee7d8; position: relative; overflow: hidden; }
  #mrp-{{ uid }} .mrp-ritual::before { content: ""; position: absolute; top: -120px; right: -120px; width: 360px; height: 360px; background: radial-gradient(circle, rgba(176,122,59,.22), transparent 70%); }
  #mrp-{{ uid }} .mrp-ritual .mrp-h { color: #fff; }
  #mrp-{{ uid }} .mrp-ritual .mrp-eyebrow { color: #cbb892; }
  #mrp-{{ uid }} .mrp-ritual .mrp-eyebrow::before, #mrp-{{ uid }} .mrp-ritual .mrp-eyebrow.mrp-line-both::after { background: #cbb892; }
  #mrp-{{ uid }} .mrp-rhead { text-align: center; max-width: 620px; margin: 0 auto 48px; position: relative; }
  #mrp-{{ uid }} .mrp-steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; position: relative; }
  #mrp-{{ uid }} .mrp-step { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); border-radius: 20px; overflow: hidden; }
  #mrp-{{ uid }} .mrp-step__img { aspect-ratio: 4/3; overflow: hidden; }
  #mrp-{{ uid }} .mrp-step__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  #mrp-{{ uid }} .mrp-step:hover .mrp-step__img img { transform: scale(1.06); }
  #mrp-{{ uid }} .mrp-step__body { padding: 24px; position: relative; }
  #mrp-{{ uid }} .mrp-step__n { position: absolute; top: -22px; left: 24px; width: 44px; height: 44px; border-radius: 50%; background: var(--o); color: #fff; font-family: var(--serif); font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(0,0,0,.25); }
  #mrp-{{ uid }} .mrp-step__t { font-weight: 600; color: #fff; font-size: 17px; margin: 8px 0 6px; }
  #mrp-{{ uid }} .mrp-step__d { font-size: 13.5px; color: #d7d0c1; line-height: 1.6; }
  #mrp-{{ uid }} .mrp-uses { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 26px; }
  #mrp-{{ uid }} .mrp-use { border: 1px solid rgba(255,255,255,.14); border-radius: 14px; padding: 20px; }
  #mrp-{{ uid }} .mrp-use b { display: block; font-family: var(--serif); color: #fff; font-size: 15.5px; margin-bottom: 6px; }
  #mrp-{{ uid }} .mrp-use span { font-size: 13px; color: #d7d0c1; line-height: 1.55; }
  #mrp-{{ uid }} .mrp-use em { color: #cbb892; font-style: normal; font-weight: 600; }

  /* COMPARAISON */
  #mrp-{{ uid }} .mrp-compare { padding: 90px 0; text-align: center; }
  #mrp-{{ uid }} .mrp-table { max-width: 780px; margin: 40px auto 0; border-radius: 20px; overflow: hidden; box-shadow: 0 24px 60px rgba(43,43,43,.10); border: 1px solid var(--line); }
  #mrp-{{ uid }} .mrp-row { display: grid; grid-template-columns: 1.5fr 1fr 1fr; }
  #mrp-{{ uid }} .mrp-row > div { padding: 16px 18px; font-size: 14px; display: flex; align-items: center; gap: 8px; text-align: left; }
  #mrp-{{ uid }} .mrp-row--head > div { font-weight: 700; font-size: 12.5px; text-transform: uppercase; letter-spacing: .6px; }
  #mrp-{{ uid }} .mrp-row--head .mrp-us { background: var(--g); color: #fff; justify-content: center; }
  #mrp-{{ uid }} .mrp-row--head .mrp-them { background: #efece5; color: #8a8377; justify-content: center; }
  #mrp-{{ uid }} .mrp-row--head .mrp-lbl { background: #fff; }
  #mrp-{{ uid }} .mrp-row .mrp-lbl { background: #fff; color: var(--ink); font-weight: 500; }
  #mrp-{{ uid }} .mrp-row .mrp-us { background: rgba(47,82,51,.05); color: var(--g); justify-content: center; font-weight: 600; }
  #mrp-{{ uid }} .mrp-row .mrp-them { background: #faf9f6; color: #a89f92; justify-content: center; }
  #mrp-{{ uid }} .mrp-row + .mrp-row > div { border-top: 1px solid var(--line); }
  #mrp-{{ uid }} .mrp-tick { color: var(--o); font-weight: 700; }

  /* GARANTIE band + CTA */
  #mrp-{{ uid }} .mrp-guarantee { padding: 72px 0; background: linear-gradient(160deg, var(--g), var(--g-dark)); color: #eee7d8; }
  #mrp-{{ uid }} .mrp-gwrap { max-width: 900px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: auto 1fr auto; gap: 30px; align-items: center; }
  #mrp-{{ uid }} .mrp-seal { width: 96px; height: 96px; border-radius: 50%; border: 2px solid rgba(203,184,146,.6); display: flex; align-items: center; justify-content: center; color: #cbb892; flex: none; }
  #mrp-{{ uid }} .mrp-seal svg { width: 46px; height: 46px; }
  #mrp-{{ uid }} .mrp-gtitle { font-family: var(--serif); font-size: clamp(20px,2.4vw,26px); color: #fff; margin: 0 0 6px; }
  #mrp-{{ uid }} .mrp-gtext { font-size: 14.5px; color: #d7d0c1; line-height: 1.65; margin: 0; }

  /* FAQ */
  #mrp-{{ uid }} .mrp-faq { padding: 90px 0; }
  #mrp-{{ uid }} .mrp-faq .mrp-wrap { max-width: 800px; }
  #mrp-{{ uid }} .mrp-faq__head { text-align: center; margin-bottom: 34px; }
  #mrp-{{ uid }} .mrp-q { border: 1px solid var(--line); border-radius: 14px; margin-bottom: 12px; overflow: hidden; background: #fff; transition: border-color .25s ease, box-shadow .25s ease; }
  #mrp-{{ uid }} .mrp-q[open] { border-color: rgba(176,122,59,.4); box-shadow: 0 12px 30px rgba(43,43,43,.06); }
  #mrp-{{ uid }} .mrp-q summary { list-style: none; cursor: pointer; padding: 20px 22px; font-family: var(--serif); font-size: 17px; color: var(--g); display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  #mrp-{{ uid }} .mrp-q summary::-webkit-details-marker { display: none; }
  #mrp-{{ uid }} .mrp-q summary::after { content: "+"; font-size: 24px; color: var(--o); line-height: 1; transition: transform .25s ease; flex: none; }
  #mrp-{{ uid }} .mrp-q[open] summary::after { transform: rotate(45deg); }
  #mrp-{{ uid }} .mrp-q p { margin: 0; padding: 0 22px 22px; font-size: 14.5px; line-height: 1.75; color: #4a463f; }

  /* CTA FINAL avec ajout panier réel */
  #mrp-{{ uid }} .mrp-cta { padding: 92px 0; background: var(--c); text-align: center; }
  #mrp-{{ uid }} .mrp-cta .mrp-h { max-width: 620px; margin: 0 auto 14px; }
  #mrp-{{ uid }} .mrp-cta .mrp-lead { max-width: 540px; margin: 0 auto 26px; }
  #mrp-{{ uid }} .mrp-buy { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 18px; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 22px 28px; box-shadow: 0 22px 50px rgba(43,43,43,.10); }
  #mrp-{{ uid }} .mrp-priceblock { text-align: left; }
  #mrp-{{ uid }} .mrp-price { font-family: var(--serif); font-size: 30px; font-weight: 700; color: var(--g); }
  #mrp-{{ uid }} .mrp-price-old { font-size: 17px; color: #a89f92; text-decoration: line-through; margin-left: 8px; }
  #mrp-{{ uid }} .mrp-save { display: block; font-size: 12px; color: var(--o); font-weight: 600; margin-top: 2px; }
  #mrp-{{ uid }} .mrp-buy form { margin: 0; }
  #mrp-{{ uid }} .mrp-reassure { display: flex; flex-wrap: wrap; justify-content: center; gap: 22px; margin-top: 26px; }
  #mrp-{{ uid }} .mrp-reassure span { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  #mrp-{{ uid }} .mrp-reassure svg { width: 17px; height: 17px; color: var(--g); }

  @media (max-width: 900px) {
    #mrp-{{ uid }} .mrp-bgrid { grid-template-columns: 1fr 1fr; }
    #mrp-{{ uid }} .mrp-split { grid-template-columns: 1fr; gap: 40px; }
    #mrp-{{ uid }} .mrp-media::after { inset: 14px -14px -14px 14px; }
    #mrp-{{ uid }} .mrp-steps, #mrp-{{ uid }} .mrp-uses { grid-template-columns: 1fr; }
    #mrp-{{ uid }} .mrp-step__n { position: static; margin-bottom: 10px; }
    #mrp-{{ uid }} .mrp-row { grid-template-columns: 1.35fr .8fr .8fr; }
    #mrp-{{ uid }} .mrp-gwrap { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  }
{%- endstyle -%}

<div id="mrp-{{ uid }}">

  <!-- INTRO / MANIFESTE -->
  <section class="mrp-intro">
    <div class="mrp-wrap mrp-rv">
      <p class="mrp-eyebrow mrp-line-both" style="justify-content:center;">L'huile ancestrale du Honduras</p>
      <h2 class="mrp-h">Une seule huile. Une vraie tradition. <em>Zéro compromis.</em></h2>
      <p class="mrp-lead">Le Batana est l'or discret du peuple Miskito : une huile épaisse et sombre, extraite à la main du fruit du palmier, qui nourrit intensément la fibre et le cuir chevelu. Nous la livrons pure — rien d'ajouté, rien de caché.</p>
      <p class="mrp-quote">« Prenez soin de vos racines, <span>nourrissez votre nature.</span> »</p>
    </div>
  </section>

  <!-- BÉNÉFICES -->
  <section class="mrp-benefits">
    <div class="mrp-wrap">
      <div class="mrp-bhead mrp-rv">
        <p class="mrp-eyebrow mrp-line-both" style="justify-content:center;">Nourrit · Répare · Fortifie</p>
        <h2 class="mrp-h">Ce que le Batana apporte à vos cheveux</h2>
      </div>
      <div class="mrp-bgrid">
        <div class="mrp-bcard mrp-rv">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg></div>
          <p class="mrp-bt">Nourrit intensément</p>
          <p class="mrp-bd">Une huile riche qui gaine la fibre et nourrit le cuir chevelu en profondeur.</p>
        </div>
        <div class="mrp-bcard mrp-rv">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v20M5 9l7-7 7 7"/></svg></div>
          <p class="mrp-bt">Apparence plus dense</p>
          <p class="mrp-bd">Favorise l'apparence de cheveux visiblement plus sains et plus denses.</p>
        </div>
        <div class="mrp-bcard mrp-rv">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8Z"/></svg></div>
          <p class="mrp-bt">Apaise le cuir chevelu</p>
          <p class="mrp-bd">Réconforte les cuirs chevelus secs et inconfortables, soir après soir.</p>
        </div>
        <div class="mrp-bcard mrp-rv">
          <div class="mrp-bicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M11 20A7 7 0 0 1 4 13c0-4 3-8 7-11 4 3 7 7 7 11a7 7 0 0 1-7 7Z"/><path d="M11 20V9"/></svg></div>
          <p class="mrp-bt">Cheveux secs & crépus</p>
          <p class="mrp-bd">Idéale pour cheveux secs, frisés et crépus qui ont soif de nutrition.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INGRÉDIENT SPOTLIGHT -->
  <section class="mrp-ingr">
    <div class="mrp-wrap">
      <div class="mrp-split">
        <div class="mrp-media mrp-rv">
          <span class="mrp-badge-pur">100 % pur</span>
          {%- if s.ingredient_image != blank -%}
            {{ s.ingredient_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: "Goutte d'huile de Batana pure" }}
          {%- else -%}
            <div class="mrp-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg></div>
          {%- endif -%}
        </div>
        <div class="mrp-rv">
          <p class="mrp-eyebrow">Un seul ingrédient</p>
          <h2 class="mrp-h">100 % Batana pur. <em>Rien d'autre.</em></h2>
          <p class="mrp-lead">Pas de remplissage, pas de dilution. Juste l'huile extraite du fruit du palmier <em>Elaeis oleifera</em>, pressée à froid pour préserver ses nutriments — un émollient naturel qui gaine et nourrit.</p>
          <div class="mrp-compo">
            <span class="mrp-chip"><b>Riche en</b> acides gras (oléique, linoléique)</span>
            <span class="mrp-chip"><b>Source de</b> vitamine E</span>
            <span class="mrp-chip"><b>Pressée</b> à froid</span>
          </div>
          <div class="mrp-inci"><strong>INCI :</strong> Elaeis Oleifera (Palm) Oil · Sans additifs, parfum de synthèse ni conservateurs.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FREE-FROM -->
  <section class="mrp-free">
    <div class="mrp-wrap mrp-rv">
      <p class="mrp-eyebrow mrp-line-both" style="justify-content:center;">Une formule minimaliste</p>
      <h2 class="mrp-h">Ce qu'il n'y a pas dedans</h2>
      <div class="mrp-pills">
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans additifs</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans parfum de synthèse</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans silicones</span>
        <span class="mrp-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>Sans conservateurs</span>
