        },
        "t_77b1861b96": {
          "type": "text",
          "settings": {
            "description": "<ul><li>🧼 <strong>Nettoie</strong> avant et après chaque usage (alcool 70°).</li><li>🙅 <strong>Ne partage pas</strong> ton derma roller — outil personnel.</li><li>🗓️ <strong>Fréquence</strong> : 1 fois par semaine max, jamais deux jours consécutifs.</li><li>🛑 <strong>Pas sur peau irritée</strong>, blessée ou colorée récemment.</li><li>🎒 <strong>Range avec le capuchon</strong> pour préserver les aiguilles.</li></ul><p>Une notice complète est fournie dans la boîte.</p>"
          }
        }
