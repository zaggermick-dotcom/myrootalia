            "button_label": "Pourquoi masser",
            "modal_title": "Pourquoi le massage compte",
            "modal_content": "Le massage aide le soin à bien se répartir et détend le cuir chevelu. Utilise la pulpe des doigts, jamais les ongles, sans forcer."
          }
        },
        "s2": {
          "type": "etape",
          "settings": {
            "duree": "Toute la nuit",
