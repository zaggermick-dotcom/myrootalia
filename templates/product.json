/*
 * myrootelia — page produit (Huile de Batana)
 * Fiche standard + contenu sur-mesure myrootelia + produits liés
 */
{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "media": {
          "type": "media",
          "settings": {
            "block_margin_bottom": 12
          }
        },
        "rating": {
          "type": "rating",
          "disabled": true,
          "settings": {
            "stars_style": "stars",
            "rating": 5,
            "rating_text": " / 5 — à brancher sur ton app d'avis",
            "block_margin_bottom": 8
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "heading_style": "1",
            "show_price": false,
            "price_color": "accent-1",
            "block_margin_bottom": 8
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "price_color": "text",
            "price_font_size": 130,
            "price_font_size_sale": 100,
            "show_sale_badge": true,
            "sale_badge": "Économise [amount]",
            "block_margin_bottom": 8
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "checked_color": "accent",
            "custom_width": "none",
            "flex": false,
            "hide_label": false,
            "bg_secondary": false,
            "size": "small",
            "selection": "background",
            "size_guide": false,
            "block_margin_bottom": 20
          }
        },
        "stock": {
          "type": "stock",
          "settings": {
            "stock_type": "shopify",
            "limit": 100,
            "disable_bar": false,
            "enable_manual_urgency": false,
            "text": "Plus que $quantity en stock",
            "alignment": "left",
            "fill_color": "accent",
            "border": "border--none",
            "shadow": "shadow--none",
            "block_margin_bottom": 16
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "button_text": "Commencer ma routine",
            "button_style": "1",
            "icon": "none",
            "extra_button": false,
            "show_qty": true,
            "show_dynamic_checkout": true,
            "button_width": "all",
            "block_margin_bottom": 16
          }
        },
        "spin": {
          "type": "product-spin-message",
          "settings": {
            "message_1": "<p>Expédié du Québec sous 24 h ouvrées</p>",
            "message_2": "<p>Essai 60 nuits — remboursé si tu n'aimes pas</p>",
            "message_3": "<p>Livraison gratuite dès 50 $</p>",
            "message_4": "<p>Paiement sécurisé — Visa · MC · Amex · Shop Pay</p>",
            "interval": 4,
            "block_margin_bottom": 16
          }
        },
        "delivery": {
          "type": "delivery_estimation",
          "settings": {
            "icons_color": "accent-1",
            "format": "dd/MM",
            "today_info": "Commandé",
            "ready_info": "Expédié",
            "ready": 1,
            "delivered_info": "Livré",
            "delivered": 5,
            "block_margin_bottom": 20
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "icons_style": "grid",
            "fill_color": "accent",
            "color_bg_secondary": true,
            "fill_fade_background": false,
            "bg_color_icons": false,
            "border": "border--none",
            "shadow": "shadow--none",
            "icon_1_icon_type": "check_mark",
            "icon_1_text": "Essai 60 nuits",
            "icon_1_description": "Remboursé, sans justification.",
            "icon_1_url": "",
            "icon_2_icon_type": "truck",
            "icon_2_text": "Livraison offerte 50 $+",
            "icon_2_description": "Expédié du Québec.",
            "icon_2_url": "",
            "icon_3_icon_type": "leaf",
            "icon_3_text": "Actifs naturels",
            "icon_3_description": "Formules courtes et lisibles.",
            "icon_3_url": "",
            "icon_4_icon_type": "chat_bubble",
            "icon_4_text": "Support humain",
            "icon_4_description": "Réponse en 24 h.",
            "icon_4_url": "",
            "block_margin_bottom": 20
          }
        },
        "accordions": {
          "type": "description",
          "settings": {
            "show_description": true,
            "tabs_background": "secondary",
            "icon1": "truck",
            "heading1": "Livraison & retours",
            "text1": "<ul><li>Livraison gratuite au Canada dès 50 $, sinon 6,99 $.</li><li>Expédié du Québec sous 24 à 48 h ouvrées.</li><li>Livré en 3 à 8 jours ouvrables.</li><li>Essai 60 nuits : tu écris, on rembourse.</li></ul>",
            "icon2": "leaf",
            "heading2": "Nos engagements",
            "text2": "<ul><li>Des formules et des gestes qu'on peut expliquer simplement.</li><li>Aucune promesse médicale — du soin, vraiment.</li><li>Un support humain qui répond en moins de 24 h.</li></ul><p>Une question avant de commander ? Écris-nous.</p>",
            "block_margin_bottom": 20
          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "media",
        "rating",
        "title",
        "price",
        "variant_picker",
        "stock",
        "buy_buttons",
        "spin",
        "delivery",
        "trust",
        "accordions",
        "share"
      ],
      "settings": {
        "section_id": "",
        "product_style": "medium",
        "image_ratio": "adapt",
        "thumbnails_style": true,
        "preshot": true,
        "navigation": true,
        "pagination": true,
        "super_glue": true,
        "enable_zoom": true,
        "desktop_content_alignment": "left",
        "enable_animations": false,
        "animation": "fade-up",
        "layout_width": "normal",
        "padding_top": 28,
        "padding_bottom": 48,
        "padding_top_sm": 12,
        "padding_bottom_sm": 24,
        "color_palette": "background-1"
      }
    },
    "produit_myrootelia": {
      "type": "produit-myrootelia",
      "settings": {}
    },
    "related": {
      "type": "related-products",
      "settings": {
        "subheading": "Complète ta routine",
        "heading": "<p>Ça se marie bien avec</p>",
        "heading_style": "2",
        "alignment": "center",
        "limit": 4,
        "media_aspect_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "slides_on_desktop": 4,
        "slides_on_tablet": 3,
        "slides_on_mobile": "2",
        "layout_width": "normal",
        "color_palette": "background-1",
        "padding_top": 56,
        "padding_bottom": 56,
        "padding_top_sm": 28,
        "padding_bottom_sm": 28
      }
    }
  },
  "order": [
    "main",
    "produit_myrootelia",
    "related"
  ]
}
