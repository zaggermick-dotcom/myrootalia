{% comment %}
  MRT · Texte enrichi — section éditoriale premium
  Blocs modulaires : sur-titre, titre, texte, puces, citation, chiffre,
  image, bouton, filet, espace. Cinq dispositions, image de fond avec
  voile, filets décoratifs, et réglages séparés ordinateur / mobile.
{% endcomment %}

{%- liquid
  assign st = section.settings
  assign has_media = false
  if st.image != blank or st.image_mobile != blank
    assign has_media = true
  endif
  assign is_split = false
  if st.layout == 'image_gauche' or st.layout == 'image_droite'
    if has_media
      assign is_split = true
    endif
  endif
-%}

{%- style -%}
  #mrt-texte-{{ section.id }}{
    --mrtX-bg: {{ st.color_bg }};
    --mrtX-ink: {{ st.color_text }};
    --mrtX-title: {{ st.color_title }};
    --mrtX-accent: {{ st.color_accent }};
    --mrtX-line: color-mix(in srgb, {{ st.color_title }} 16%, transparent);
    --mrtX-muted: color-mix(in srgb, {{ st.color_text }} 62%, {{ st.color_bg }});
    --mrtX-serif: var(--font-heading-family, Georgia, serif);
    --mrtX-sans: var(--font-body-family, -apple-system, sans-serif);
    position:relative; background: var(--mrtX-bg); color: var(--mrtX-ink);
    font-family: var(--mrtX-sans); isolation:isolate;
    padding: {{ st.padding_top_sm }}px 0 {{ st.padding_bottom_sm }}px;
  }
  @media(min-width:750px){#mrt-texte-{{ section.id }}{padding: {{ st.padding_top }}px 0 {{ st.padding_bottom }}px;}}
  #mrt-texte-{{ section.id }} *{box-sizing:border-box}
  #mrt-texte-{{ section.id }} .mrtX-wrap{position:relative;z-index:2;
    max-width:{% if st.layout_width == 'etroite' %}760px{% elsif st.layout_width == 'large' %}1440px{% else %}1180px{% endif %};
    margin:0 auto;padding:0 {{ st.side_padding }}px}

  /* ---------- image de fond ---------- */
  {%- if st.layout == 'image_fond' and has_media -%}
  #mrt-texte-{{ section.id }} .mrtX-bg{position:absolute;inset:0;z-index:0;overflow:hidden}
  #mrt-texte-{{ section.id }} .mrtX-bg img{width:100%;height:100%;object-fit:cover;
    object-position:{{ st.focal_x }}% {{ st.focal_y }}%}
  #mrt-texte-{{ section.id }} .mrtX-bg::after{content:"";position:absolute;inset:0;
    background:{% if st.overlay_style == 'degrade_bas' %}linear-gradient(to top, {{ st.overlay_color }} 0%, transparent 75%)
      {%- elsif st.overlay_style == 'degrade_haut' %}linear-gradient(to bottom, {{ st.overlay_color }} 0%, transparent 75%)
      {%- else %}{{ st.overlay_color }}{% endif %};
    opacity:{{ st.overlay_opacity | divided_by: 100.0 }}}
  #mrt-texte-{{ section.id }}{min-height:{{ st.bg_min_height }}px;display:flex;align-items:center}
  @media(max-width:749px){#mrt-texte-{{ section.id }}{min-height:{{ st.bg_min_height_mobile }}px}}
  {%- endif -%}

  /* ---------- disposition en deux colonnes ---------- */
  {%- if is_split -%}
  #mrt-texte-{{ section.id }} .mrtX-split{display:grid;
    grid-template-columns:{% if st.layout == 'image_droite' %}{{ st.text_ratio }}fr {{ 100 | minus: st.text_ratio }}fr{% else %}{{ 100 | minus: st.text_ratio }}fr {{ st.text_ratio }}fr{% endif %};
    gap:{{ st.split_gap }}px;align-items:{{ st.vertical_align }}}
  #mrt-texte-{{ section.id }} .mrtX-media{order:{% if st.layout == 'image_droite' %}2{% else %}0{% endif %};min-width:0}
  #mrt-texte-{{ section.id }} .mrtX-content{min-width:0}
  @media(max-width:899px){
    #mrt-texte-{{ section.id }} .mrtX-split{grid-template-columns:1fr;gap:{{ st.split_gap_mobile }}px}
    #mrt-texte-{{ section.id }} .mrtX-media{order:{% if st.image_first_mobile %}0{% else %}2{% endif %}}}
  {%- endif -%}

  /* ---------- média ---------- */
  #mrt-texte-{{ section.id }} .mrtX-media{position:relative}
  #mrt-texte-{{ section.id }} .mrtX-media figure{margin:0;position:relative;overflow:hidden;
    border-radius:{{ st.image_radius }}px;
    {% if st.image_ratio != 'auto' %}aspect-ratio:{{ st.image_ratio }};{% endif %}
    {% if st.image_shadow %}box-shadow:0 40px 80px -40px rgba(21,42,33,.5);{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-media img{width:100%;height:100%;display:block;
    {% if st.image_ratio != 'auto' %}object-fit:cover;object-position:{{ st.focal_x }}% {{ st.focal_y }}%;{% endif %}
    transition:transform 1.1s cubic-bezier(.22,.61,.36,1)}
  {%- if st.image_zoom -%}
  #mrt-texte-{{ section.id }} .mrtX-media:hover img{transform:scale(1.045)}
  {%- endif -%}
  {%- if st.image_frame -%}
  #mrt-texte-{{ section.id }} .mrtX-media figure::after{content:"";position:absolute;inset:{{ st.frame_inset }}px;
    border:1px solid color-mix(in srgb, var(--mrtX-accent) 55%, transparent);
    border-radius:{{ st.image_radius | minus: 4 | at_least: 0 }}px;pointer-events:none}
  {%- endif -%}
  #mrt-texte-{{ section.id }} .mrtX-caption{margin:12px 2px 0;font-size:12.5px;color:var(--mrtX-muted);
    text-align:{{ st.text_align }};font-style:italic}

  /* ---------- contenu ---------- */
  #mrt-texte-{{ section.id }} .mrtX-content{text-align:{{ st.text_align }};
    {% unless is_split %}max-width:{{ st.content_max_width }}px;
      margin-inline:{% if st.text_align == 'center' %}auto{% elsif st.text_align == 'right' %}auto 0{% else %}0 auto{% endif %};{% endunless %}
    display:flex;flex-direction:column;
    align-items:{% if st.text_align == 'center' %}center{% elsif st.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap:{{ st.block_gap }}px}
  @media(max-width:749px){
    #mrt-texte-{{ section.id }} .mrtX-content{text-align:{{ st.text_align_mobile }};gap:{{ st.block_gap_mobile }}px;
      align-items:{% if st.text_align_mobile == 'center' %}center{% elsif st.text_align_mobile == 'right' %}flex-end{% else %}flex-start{% endif %}}
    #mrt-texte-{{ section.id }} .mrtX-caption{text-align:{{ st.text_align_mobile }}}}

  #mrt-texte-{{ section.id }} .mrtX-b{width:100%;opacity:0;transform:translateY(22px);
    transition:opacity .75s cubic-bezier(.22,.61,.36,1), transform .75s cubic-bezier(.22,.61,.36,1)}
  #mrt-texte-{{ section.id }} .mrtX-b.is-in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){#mrt-texte-{{ section.id }} .mrtX-b{opacity:1;transform:none;transition:none}}

  /* sur-titre */
  #mrt-texte-{{ section.id }} .mrtX-kicker{display:inline-flex;align-items:center;gap:10px;
    font-size:{{ st.kicker_size }}px;letter-spacing:.24em;text-transform:uppercase;
    color:var(--mrtX-accent);font-weight:600;margin:0}
  #mrt-texte-{{ section.id }} .mrtX-kicker::before,
  #mrt-texte-{{ section.id }} .mrtX-kicker::after{content:"";width:26px;height:1px;background:currentColor;opacity:.55}
  {%- unless st.kicker_rules == 'deux' -%}
  #mrt-texte-{{ section.id }} .mrtX-kicker::after{display:none}
  {%- endunless -%}
  {%- if st.kicker_rules == 'aucun' -%}
  #mrt-texte-{{ section.id }} .mrtX-kicker::before{display:none}
  {%- endif -%}

  /* titre */
  #mrt-texte-{{ section.id }} .mrtX-h{font-family:var(--mrtX-serif);font-weight:{{ st.title_weight }};
    font-size:clamp({{ st.title_size_mobile }}px, 4vw, {{ st.title_size }}px);
    line-height:{{ st.title_leading | divided_by: 100.0 }};letter-spacing:-.012em;color:var(--mrtX-title);margin:0;
    text-wrap:balance}
  #mrt-texte-{{ section.id }} .mrtX-h p{margin:0}
  #mrt-texte-{{ section.id }} .mrtX-h em{font-style:italic;color:var(--mrtX-accent)}
  #mrt-texte-{{ section.id }} .mrtX-h strong{font-weight:{{ st.title_weight | plus: 200 | at_most: 800 }}}

  /* texte */
  #mrt-texte-{{ section.id }} .mrtX-p{font-size:{{ st.text_size }}px;line-height:{{ st.text_leading | divided_by: 100.0 }};
    color:var(--mrtX-muted);margin:0}
  #mrt-texte-{{ section.id }} .mrtX-p p{margin:0 0 .85em}
  #mrt-texte-{{ section.id }} .mrtX-p p:last-child{margin-bottom:0}
  #mrt-texte-{{ section.id }} .mrtX-p strong{color:var(--mrtX-title);font-weight:600}
  #mrt-texte-{{ section.id }} .mrtX-p em{color:var(--mrtX-accent);font-style:italic}
  #mrt-texte-{{ section.id }} .mrtX-p a{color:var(--mrtX-accent);text-underline-offset:3px}
  @media(max-width:749px){#mrt-texte-{{ section.id }} .mrtX-p{font-size:{{ st.text_size_mobile }}px}}
  {%- if st.first_letter -%}
  #mrt-texte-{{ section.id }} .mrtX-p--lettrine p:first-of-type::first-letter{
    font-family:var(--mrtX-serif);font-size:3.4em;line-height:.82;float:left;
    margin:.06em .1em 0 0;color:var(--mrtX-accent);font-weight:500}
  {%- endif -%}

  /* puces */
  #mrt-texte-{{ section.id }} .mrtX-list{list-style:none;margin:0;padding:0;display:grid;gap:11px;width:100%}
  #mrt-texte-{{ section.id }} .mrtX-list li{display:flex;gap:11px;align-items:flex-start;
    font-size:{{ st.text_size }}px;line-height:1.55;color:var(--mrtX-muted);
    justify-content:{% if st.text_align == 'center' %}center{% elsif st.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-list li b{color:var(--mrtX-title);font-weight:600}
  #mrt-texte-{{ section.id }} .mrtX-list .mrtX-li-ico{flex:0 0 auto;width:20px;height:20px;margin-top:1px;color:var(--mrtX-accent)}
  #mrt-texte-{{ section.id }} .mrtX-list .mrtX-li-ico svg{width:100%;height:100%}

  /* citation */
  #mrt-texte-{{ section.id }} .mrtX-quote{position:relative;margin:0;width:100%;
    padding:{% if st.quote_style == 'filet' %}0 0 0 22px{% else %}26px 28px{% endif %};
    {% if st.quote_style == 'filet' %}border-left:2px solid var(--mrtX-accent);
    {% elsif st.quote_style == 'carte' %}background:color-mix(in srgb, var(--mrtX-accent) 9%, transparent);
      border-radius:16px;{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-quote p{font-family:var(--mrtX-serif);font-size:{{ st.quote_size }}px;
    line-height:1.42;font-style:italic;color:var(--mrtX-title);margin:0}
  #mrt-texte-{{ section.id }} .mrtX-quote footer{margin-top:12px;font-size:13px;letter-spacing:.1em;
    text-transform:uppercase;color:var(--mrtX-accent);font-weight:600;font-style:normal}

  /* chiffre clé */
  #mrt-texte-{{ section.id }} .mrtX-stat{display:flex;flex-direction:column;gap:4px;width:100%;
    align-items:{% if st.text_align == 'center' %}center{% elsif st.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-stat b{font-family:var(--mrtX-serif);font-weight:500;
    font-size:{{ st.stat_size }}px;line-height:1;color:var(--mrtX-accent)}
  #mrt-texte-{{ section.id }} .mrtX-stat span{font-size:13px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--mrtX-muted);font-weight:600}

  /* image dans le flux */
  #mrt-texte-{{ section.id }} .mrtX-inline-img{width:100%;border-radius:{{ st.image_radius }}px;overflow:hidden;margin:0}
  #mrt-texte-{{ section.id }} .mrtX-inline-img img{width:100%;height:auto;display:block}

  /* filet et espace */
  #mrt-texte-{{ section.id }} .mrtX-rule{width:100%;display:flex;
    justify-content:{% if st.text_align == 'center' %}center{% elsif st.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-rule i{display:block;height:1px;background:var(--mrtX-line)}

  /* boutons */
  #mrt-texte-{{ section.id }} .mrtX-btns{display:flex;flex-wrap:wrap;gap:12px;width:100%;
    justify-content:{% if st.text_align == 'center' %}center{% elsif st.text_align == 'right' %}flex-end{% else %}flex-start{% endif %}}
  @media(max-width:749px){
    #mrt-texte-{{ section.id }} .mrtX-btns{justify-content:{% if st.text_align_mobile == 'center' %}center{% elsif st.text_align_mobile == 'right' %}flex-end{% else %}flex-start{% endif %}}
    {% if st.buttons_full_mobile %}#mrt-texte-{{ section.id }} .mrtX-btns .mrtX-btn{width:100%}{% endif %}}
  #mrt-texte-{{ section.id }} .mrtX-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;
    padding:{{ st.button_padding_y }}px {{ st.button_padding_x }}px;border-radius:{{ st.button_radius }}px;
    font-family:var(--mrtX-sans);font-size:{{ st.button_size }}px;font-weight:600;letter-spacing:.015em;
    text-decoration:none;border:1.5px solid transparent;cursor:pointer;
    transition:transform .3s ease, box-shadow .3s ease, background .3s ease, color .3s ease}
  #mrt-texte-{{ section.id }} .mrtX-btn svg{width:15px;height:15px}
  #mrt-texte-{{ section.id }} .mrtX-btn--1{background:{{ st.color_btn_bg }};color:{{ st.color_btn_text }};
    box-shadow:0 12px 30px -14px rgba(21,42,33,.6)}
  #mrt-texte-{{ section.id }} .mrtX-btn--1:hover{transform:translateY(-3px);filter:brightness(.93)}
  #mrt-texte-{{ section.id }} .mrtX-btn--2{background:transparent;color:var(--mrtX-title);border-color:var(--mrtX-line)}
  #mrt-texte-{{ section.id }} .mrtX-btn--2:hover{border-color:var(--mrtX-accent);color:var(--mrtX-accent);transform:translateY(-3px)}
  #mrt-texte-{{ section.id }} .mrtX-btn--3{background:transparent;color:var(--mrtX-title);padding-left:0;padding-right:0;
    border-bottom:1px solid color-mix(in srgb, var(--mrtX-accent) 60%, transparent);border-radius:0}
  #mrt-texte-{{ section.id }} .mrtX-btn--3:hover{color:var(--mrtX-accent);gap:13px}
{%- endstyle -%}

<section id="mrt-texte-{{ section.id }}">

  {%- if st.layout == 'image_fond' and has_media -%}
    <div class="mrtX-bg" aria-hidden="true">
      {%- if st.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ st.image_mobile | image_url: width: 1200 }}">
          {%- if st.image != blank -%}
            {{ st.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: '', widths: '800,1200,1800,2200' }}
          {%- else -%}
            {{ st.image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
          {%- endif -%}
        </picture>
      {%- else -%}
        {{ st.image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: '', widths: '800,1200,1800,2200' }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="mrtX-wrap">
    <div class="{% if is_split %}mrtX-split{% endif %}">

      {%- if is_split -%}
        <div class="mrtX-media">
          <figure>
            {%- if st.image_mobile != blank and st.image != blank -%}
              <picture>
                <source media="(max-width: 749px)" srcset="{{ st.image_mobile | image_url: width: 1000 }}">
                {{ st.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: st.image_alt, widths: '500,800,1100,1400' }}
              </picture>
            {%- else -%}
              {%- assign img = st.image | default: st.image_mobile -%}
              {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', alt: st.image_alt, widths: '500,800,1100,1400' }}
            {%- endif -%}
          </figure>
          {%- if st.image_caption != blank -%}<figcaption class="mrtX-caption">{{ st.image_caption | escape }}</figcaption>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="mrtX-content">
        {%- for block in section.blocks -%}
          {%- assign delay = forloop.index0 | times: 90 -%}
          {%- case block.type -%}

            {%- when 'surtitre' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <span class="mrtX-kicker">{{ block.settings.texte | escape }}</span>
              </div>

            {%- when 'titre' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                {%- if block.settings.niveau == 'h1' -%}
                  <h1 class="mrtX-h">{{ block.settings.texte }}</h1>
                {%- elsif block.settings.niveau == 'h3' -%}
                  <h3 class="mrtX-h">{{ block.settings.texte }}</h3>
                {%- else -%}
                  <h2 class="mrtX-h">{{ block.settings.texte }}</h2>
                {%- endif -%}
              </div>

            {%- when 'texte' -%}
              <div class="mrtX-b mrtX-p{% if block.settings.lettrine %} mrtX-p--lettrine{% endif %}"
                   style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                {{ block.settings.texte }}
              </div>

            {%- when 'puces' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <ul class="mrtX-list">
                  {%- assign lignes = block.settings.texte | newline_to_br | split: '<br />' -%}
                  {%- for ligne in lignes -%}
                    {%- assign propre = ligne | strip -%}
                    {%- if propre != blank -%}
                      <li>
                        <span class="mrtX-li-ico">{%- render 'mrt-icon', icon: block.settings.icone -%}</span>
                        <span>{{ propre }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>

            {%- when 'citation' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <blockquote class="mrtX-quote">
                  <p>{{ block.settings.texte }}</p>
                  {%- if block.settings.auteur != blank -%}<footer>{{ block.settings.auteur | escape }}</footer>{%- endif -%}
                </blockquote>
              </div>

            {%- when 'chiffre' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <div class="mrtX-stat">
                  <b>{{ block.settings.chiffre | escape }}</b>
                  {%- if block.settings.libelle != blank -%}<span>{{ block.settings.libelle | escape }}</span>{%- endif -%}
                </div>
              </div>

            {%- when 'image' -%}
              {%- if block.settings.image != blank -%}
                <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                  <figure class="mrtX-inline-img" style="max-width:{{ block.settings.largeur }}%">
                    {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: block.settings.alt, widths: '400,700,1000,1200' }}
                  </figure>
                </div>
              {%- endif -%}

            {%- when 'bouton' -%}
              <div class="mrtX-b" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <div class="mrtX-btns">
                  {%- if block.settings.texte != blank -%}
                    <a class="mrtX-btn mrtX-btn--{{ block.settings.style }}" href="{{ block.settings.lien | default: '#acheter' }}">
                      {{ block.settings.texte | escape }}
                      {%- if block.settings.fleche -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.texte_2 != blank -%}
                    <a class="mrtX-btn mrtX-btn--{{ block.settings.style_2 }}" href="{{ block.settings.lien_2 | default: '#acheter' }}">
                      {{ block.settings.texte_2 | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </div>

            {%- when 'filet' -%}
              <div class="mrtX-b mrtX-rule" style="transition-delay:{{ delay }}ms" {{ block.shopify_attributes }}>
                <i style="width:{{ block.settings.largeur }}px"></i>
              </div>

            {%- when 'espace' -%}
              <div class="mrtX-b" style="height:{{ block.settings.hauteur }}px" {{ block.shopify_attributes }}></div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('mrt-texte-{{ section.id }}');
  if (!root) return;
  var items = root.querySelectorAll('.mrtX-b');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    items.forEach(function (el) { io.observe(el); });
  } else {
    items.forEach(function (el) { el.classList.add('is-in'); });
  }
})();
</script>

{% schema %}
{
  "name": "MRT · Texte enrichi",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Disposition" },
    { "type": "select", "id": "layout", "label": "Type", "options": [
      { "value": "simple", "label": "Texte seul" },
      { "value": "image_gauche", "label": "Image à gauche" },
      { "value": "image_droite", "label": "Image à droite" },
      { "value": "image_fond", "label": "Image en fond" }
    ], "default": "simple" },
    { "type": "select", "id": "layout_width", "label": "Largeur", "options": [
      { "value": "etroite", "label": "Étroite" }, { "value": "normale", "label": "Page" }, { "value": "large", "label": "Large" }
    ], "default": "normale" },
    { "type": "range", "id": "content_max_width", "min": 420, "max": 1000, "step": 20, "unit": "px", "label": "Largeur du texte (sans image)", "default": 660 },
