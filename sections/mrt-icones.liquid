  "presets": [
    {
      "name": "MRT · Icônes — Bénéfices",
      "blocks": [
        { "type": "icone", "settings": { "icone": "cuir_chevelu", "titre": "Cuir chevelu sain", "texte": "<p>Apaise et nourrit le cuir chevelu — le sol où tout commence.</p>" } },
        { "type": "icone", "settings": { "icone": "cheveux", "titre": "Moins de casse", "texte": "<p>Des huiles qui gainent la fibre et aident à réduire la casse.</p>" } },
