{% comment %}
  MRT · Routine — parcours d'étapes premium, orienté conversion
  Repris de « Routine Élégante » et affiné :
  - polices du thème (plus d'appel Google Fonts) et animations natives
    par IntersectionObserver (plus de dépendance AOS externe) → page plus rapide
  - aucun onclick inline (compatible CSP)
  - leviers de conversion : chrono total, durée par étape, icône par étape,
    ligne de progression, CTA final ancré sur le bloc d'achat
{% endcomment %}

{%- liquid
  assign st = section.settings
  assign steps = section.blocks | where: 'type', 'etape'
-%}

{%- style -%}
  #mrt-routine-{{ section.id }}{
    --mrtR-bg: {{ st.color_bg }};
    --mrtR-ink: {{ st.color_text }};
    --mrtR-title: {{ st.color_title }};
    --mrtR-accent: {{ st.color_accent }};
    --mrtR-card: {{ st.color_card }};
    --mrtR-line: color-mix(in srgb, {{ st.color_title }} 14%, transparent);
    --mrtR-muted: color-mix(in srgb, {{ st.color_text }} 62%, {{ st.color_bg }});
    --mrtR-num-bg: {{ st.color_num_bg }};
    --mrtR-num-ink: {{ st.color_num_text }};
    --mrtR-btn-bg: {{ st.color_btn_bg }};
    --mrtR-btn-ink: {{ st.color_btn_text }};
    --mrtR-radius: {{ st.card_radius }}px;
    --mrtR-serif: var(--font-heading-family, Georgia, serif);
    --mrtR-sans: var(--font-body-family, -apple-system, sans-serif);
    background: var(--mrtR-bg); color: var(--mrtR-ink); font-family: var(--mrtR-sans);
    padding: {{ st.padding_top_sm }}px 0 {{ st.padding_bottom_sm }}px;
    overflow: hidden;
  }
  @media(min-width:750px){
    #mrt-routine-{{ section.id }}{padding: {{ st.padding_top }}px 0 {{ st.padding_bottom }}px;}
  }
  #mrt-routine-{{ section.id }} *{box-sizing:border-box}
  #mrt-routine-{{ section.id }} .mrtR-wrap{
    max-width:{% if st.layout_width == 'full' %}1600px{% elsif st.layout_width == 'narrow' %}960px{% else %}1240px{% endif %};
    margin:0 auto;padding:0 20px}

  /* ---------- en-tête ---------- */
  #mrt-routine-{{ section.id }} .mrtR-head{text-align:{{ st.alignment }};max-width:680px;margin:0 auto {{ st.header_gap }}px;
    {% if st.alignment == 'left' %}margin-left:0;{% elsif st.alignment == 'right' %}margin-right:0;{% endif %}}
  #mrt-routine-{{ section.id }} .mrtR-kicker{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;
    letter-spacing:.24em;text-transform:uppercase;color:var(--mrtR-accent);font-weight:600;margin-bottom:14px}
  #mrt-routine-{{ section.id }} .mrtR-kicker::before,
  #mrt-routine-{{ section.id }} .mrtR-kicker::after{content:"";width:22px;height:1px;background:var(--mrtR-accent);opacity:.5}
  {% if st.alignment == 'left' %}#mrt-routine-{{ section.id }} .mrtR-kicker::before{display:none}{% endif %}
  #mrt-routine-{{ section.id }} .mrtR-h2{font-family:var(--mrtR-serif);font-weight:500;
    font-size:clamp(27px,3.6vw,{{ st.title_size }}px);line-height:1.18;color:var(--mrtR-title);margin:0 0 12px;letter-spacing:-.01em}
  #mrt-routine-{{ section.id }} .mrtR-h2 em{font-style:italic;color:var(--mrtR-accent)}
  #mrt-routine-{{ section.id }} .mrtR-desc{font-size:16px;line-height:1.65;color:var(--mrtR-muted);margin:0}

  /* pastille chrono */
  #mrt-routine-{{ section.id }} .mrtR-chip{display:inline-flex;align-items:center;gap:9px;margin-top:20px;
    padding:9px 18px 9px 14px;border-radius:999px;font-size:13.5px;font-weight:600;color:var(--mrtR-title);
    background:color-mix(in srgb, var(--mrtR-accent) 16%, var(--mrtR-bg));
    border:1px solid color-mix(in srgb, var(--mrtR-accent) 34%, transparent)}
  #mrt-routine-{{ section.id }} .mrtR-chip svg{width:17px;height:17px;color:var(--mrtR-accent);flex:0 0 auto}

  /* ---------- grille ---------- */
  #mrt-routine-{{ section.id }} .mrtR-grid{display:grid;
    grid-template-columns:repeat({{ st.columns }}, minmax(0,1fr));gap:{{ st.grid_gap }}px;position:relative}
  @media(max-width:1024px){#mrt-routine-{{ section.id }} .mrtR-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:{{ st.grid_gap_sm | plus: 6 }}px}}
  @media(max-width:640px){#mrt-routine-{{ section.id }} .mrtR-grid{grid-template-columns:1fr;gap:{{ st.grid_gap_sm }}px}}

  #mrt-routine-{{ section.id }} .mrtR-item{position:relative;display:flex;flex-direction:column;
    opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.22,.61,.36,1), transform .7s cubic-bezier(.22,.61,.36,1)}
  #mrt-routine-{{ section.id }} .mrtR-item.is-in{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){#mrt-routine-{{ section.id }} .mrtR-item{opacity:1;transform:none;transition:none}}

  /* ligne de progression entre les cartes */
  {%- if st.show_connector -%}
  #mrt-routine-{{ section.id }} .mrtR-item:not(:last-child)::after{content:"";position:absolute;z-index:0;
    top:{{ st.image_ratio | divided_by: 2 }}%;right:calc(-1 * {{ st.grid_gap }}px);width:{{ st.grid_gap }}px;height:2px;
    background:repeating-linear-gradient(90deg,var(--mrtR-accent) 0 5px,transparent 5px 11px);opacity:.45}
  @media(max-width:1024px){#mrt-routine-{{ section.id }} .mrtR-item::after{display:none !important}}
  {%- endif -%}

  /* ---------- carte ---------- */
  #mrt-routine-{{ section.id }} .mrtR-card{position:relative;z-index:1;background:var(--mrtR-card);
    border:1px solid var(--mrtR-line);border-radius:var(--mrtR-radius);overflow:hidden;height:100%;
    display:flex;flex-direction:column;
    box-shadow:0 2px 14px -8px rgba(21,42,33,.22);
    transition:transform .45s cubic-bezier(.22,.61,.36,1), box-shadow .45s ease, border-color .45s ease}
  #mrt-routine-{{ section.id }} .mrtR-item:hover .mrtR-card{transform:translateY(-7px);
    box-shadow:0 30px 60px -30px rgba(21,42,33,.5);border-color:color-mix(in srgb, var(--mrtR-accent) 45%, transparent)}

  #mrt-routine-{{ section.id }} .mrtR-media{position:relative;width:100%;padding-top:{{ st.image_ratio }}%;
    overflow:hidden;background:color-mix(in srgb, var(--mrtR-accent) 10%, var(--mrtR-card))}
  #mrt-routine-{{ section.id }} .mrtR-media img,
  #mrt-routine-{{ section.id }} .mrtR-media svg.placeholder-svg{position:absolute;inset:0;width:100%;height:100%;
    object-fit:cover;transition:transform .8s cubic-bezier(.22,.61,.36,1)}
  #mrt-routine-{{ section.id }} .mrtR-item:hover .mrtR-media img{transform:scale(1.06)}
  #mrt-routine-{{ section.id }} .mrtR-media::after{content:"";position:absolute;inset:0;
    background:linear-gradient(to top, color-mix(in srgb, var(--mrtR-card) 92%, transparent) 0%, transparent 42%)}

  /* numéro en médaillon, à cheval sur l'image */
  #mrt-routine-{{ section.id }} .mrtR-num{position:absolute;z-index:3;left:50%;transform:translateX(-50%);
    bottom:calc(100% - {{ st.image_ratio }}% + -{{ st.num_size | divided_by: 2 }}px);
    width:{{ st.num_size }}px;height:{{ st.num_size }}px;border-radius:50%;
    background:var(--mrtR-num-bg);color:var(--mrtR-num-ink);display:flex;align-items:center;justify-content:center;
    font-family:var(--mrtR-serif);font-size:{{ st.num_size | times: 0.42 | round }}px;font-weight:500;
    box-shadow:0 8px 22px -8px rgba(21,42,33,.55);
    border:2.5px solid var(--mrtR-card);
    transition:transform .45s cubic-bezier(.34,1.4,.64,1), background .35s ease, color .35s ease}
  #mrt-routine-{{ section.id }} .mrtR-item:hover .mrtR-num{transform:translateX(-50%) scale(1.09);
    background:var(--mrtR-accent);color:var(--mrtR-num-bg)}

  #mrt-routine-{{ section.id }} .mrtR-body{position:relative;padding:{{ st.num_size | divided_by: 2 | plus: 14 }}px {{ st.content_padding }}px {{ st.content_padding }}px;
    text-align:center;flex:1;display:flex;flex-direction:column;gap:9px}

  #mrt-routine-{{ section.id }} .mrtR-meta{display:inline-flex;align-items:center;justify-content:center;gap:7px;
    font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--mrtR-accent)}
  #mrt-routine-{{ section.id }} .mrtR-meta svg{width:14px;height:14px}

  #mrt-routine-{{ section.id }} .mrtR-icon{width:34px;height:34px;margin:2px auto 0;color:var(--mrtR-accent)}
  #mrt-routine-{{ section.id }} .mrtR-icon svg{width:100%;height:100%}

  #mrt-routine-{{ section.id }} .mrtR-title{font-family:var(--mrtR-serif);font-weight:500;
    font-size:{{ st.card_title_size }}px;line-height:1.28;color:var(--mrtR-title);margin:0;letter-spacing:-.005em}
  #mrt-routine-{{ section.id }} .mrtR-text{font-size:{{ st.card_text_size }}px;line-height:1.6;
    color:var(--mrtR-muted);margin:0;flex:1}
  #mrt-routine-{{ section.id }} .mrtR-text p{margin:0}

  #mrt-routine-{{ section.id }} .mrtR-more{align-self:center;margin-top:4px;background:none;border:0;padding:5px 2px;
    cursor:pointer;font-family:var(--mrtR-sans);font-size:12.5px;font-weight:600;color:var(--mrtR-title);
    letter-spacing:.02em;display:inline-flex;align-items:center;gap:6px;
    border-bottom:1px solid color-mix(in srgb, var(--mrtR-accent) 60%, transparent);transition:.25s}
  #mrt-routine-{{ section.id }} .mrtR-more:hover{color:var(--mrtR-accent);gap:9px}
  #mrt-routine-{{ section.id }} .mrtR-more svg{width:13px;height:13px}

  /* ---------- CTA final ---------- */
  #mrt-routine-{{ section.id }} .mrtR-cta{text-align:center;margin-top:{{ st.cta_gap }}px}
  #mrt-routine-{{ section.id }} .mrtR-cta-note{font-size:13.5px;color:var(--mrtR-muted);margin:0 0 16px}
  #mrt-routine-{{ section.id }} .mrtR-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;
    padding:17px 40px;border-radius:999px;border:0;cursor:pointer;text-decoration:none;
    background:var(--mrtR-btn-bg);color:var(--mrtR-btn-ink);font-family:var(--mrtR-sans);
    font-size:15.5px;font-weight:600;letter-spacing:.02em;
    box-shadow:0 12px 30px -14px rgba(21,42,33,.6);
    transition:transform .3s ease, box-shadow .3s ease, filter .3s ease}
  #mrt-routine-{{ section.id }} .mrtR-btn:hover{transform:translateY(-3px);filter:brightness(.93);
    box-shadow:0 18px 40px -14px rgba(21,42,33,.7)}
  #mrt-routine-{{ section.id }} .mrtR-btn svg{width:16px;height:16px}

  /* ---------- fenêtre de détail ---------- */
  #mrtR-modal-{{ section.id }}{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;
    padding:20px;background:color-mix(in srgb, {{ st.color_title }} 62%, transparent);backdrop-filter:blur(8px)}
  #mrtR-modal-{{ section.id }}.is-open{display:flex}
  #mrtR-modal-{{ section.id }} .mrtR-modal-card{background:var(--mrtR-card);width:100%;max-width:480px;
    border-radius:22px;padding:38px 32px 32px;position:relative;text-align:center;
    border:1px solid var(--mrtR-line);box-shadow:0 40px 90px -30px rgba(21,42,33,.6);
    animation:mrtRpop .38s cubic-bezier(.22,.61,.36,1)}
  @keyframes mrtRpop{from{opacity:0;transform:translateY(22px) scale(.97)}to{opacity:1;transform:none}}
  #mrtR-modal-{{ section.id }} .mrtR-modal-close{position:absolute;top:14px;right:14px;width:34px;height:34px;
    border-radius:50%;border:0;cursor:pointer;font-size:17px;line-height:1;
    background:color-mix(in srgb, {{ st.color_title }} 7%, transparent);color:var(--mrtR-muted);
    display:flex;align-items:center;justify-content:center;transition:.3s}
  #mrtR-modal-{{ section.id }} .mrtR-modal-close:hover{background:color-mix(in srgb, {{ st.color_title }} 14%, transparent);
    color:var(--mrtR-title);transform:rotate(90deg)}
  #mrtR-modal-{{ section.id }} .mrtR-modal-icon{width:46px;height:46px;margin:0 auto 16px;color:var(--mrtR-accent)}
  #mrtR-modal-{{ section.id }} .mrtR-modal-icon svg{width:100%;height:100%}
  #mrtR-modal-{{ section.id }} h3{font-family:var(--mrtR-serif);font-weight:500;font-size:24px;
    color:var(--mrtR-title);margin:0 0 14px}
  #mrtR-modal-{{ section.id }} .mrtR-modal-text{font-size:15.5px;line-height:1.7;color:var(--mrtR-muted);margin:0 0 24px}
{%- endstyle -%}

<section id="mrt-routine-{{ section.id }}">
  <div class="mrtR-wrap">

    <div class="mrtR-head">
      {%- if st.kicker != blank -%}<span class="mrtR-kicker">{{ st.kicker | escape }}</span>{%- endif -%}
      {%- if st.title != blank -%}<h2 class="mrtR-h2">{{ st.title }}</h2>{%- endif -%}
      {%- if st.description != blank -%}<p class="mrtR-desc">{{ st.description }}</p>{%- endif -%}
      {%- if st.chip_text != blank -%}
        <div class="mrtR-chip">{%- render 'mrt-icon', icon: st.chip_icon -%}{{ st.chip_text | escape }}</div>
      {%- endif -%}
    </div>

    <div class="mrtR-grid">
      {%- for block in steps -%}
        <div class="mrtR-item" style="transition-delay:{{ forloop.index0 | times: 110 }}ms" {{ block.shopify_attributes }}>
          <div class="mrtR-card">

            <div class="mrtR-media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title, widths: '300,500,700' }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="mrtR-num">{{ forloop.index }}</div>

            <div class="mrtR-body">
              {%- if block.settings.duree != blank -%}
                <span class="mrtR-meta">{%- render 'mrt-icon', icon: 'chrono' -%}{{ block.settings.duree | escape }}</span>
              {%- endif -%}
              {%- if block.settings.icone != 'aucune' -%}
                <div class="mrtR-icon">{%- render 'mrt-icon', icon: block.settings.icone -%}</div>
              {%- endif -%}
              <h3 class="mrtR-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <div class="mrtR-text">{{ block.settings.description }}</div>
              {%- endif -%}
              {%- if block.settings.modal_content != blank -%}
                <button type="button" class="mrtR-more"
                  data-mrtr-open
                  data-icon="{{ block.settings.icone }}"
                  data-title="{{ block.settings.modal_title | default: block.settings.title | escape }}"
                  data-content="{{ block.settings.modal_content | escape }}">
                  {{ block.settings.button_label | default: 'En savoir plus' | escape }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              {%- endif -%}
            </div>

          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if st.cta_text != blank -%}
      <div class="mrtR-cta">
        {%- if st.cta_note != blank -%}<p class="mrtR-cta-note">{{ st.cta_note | escape }}</p>{%- endif -%}
        <a class="mrtR-btn" href="{{ st.cta_link | default: '#acheter' }}" data-mrtr-cta>
          {{ st.cta_text | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<div id="mrtR-modal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="mrtR-modal-t-{{ section.id }}">
  <div class="mrtR-modal-card">
    <button type="button" class="mrtR-modal-close" data-mrtr-close aria-label="Fermer">✕</button>
    <div class="mrtR-modal-icon" data-mrtr-modal-icon></div>
    <h3 id="mrtR-modal-t-{{ section.id }}" data-mrtr-modal-title></h3>
    <p class="mrtR-modal-text" data-mrtr-modal-text></p>
    <button type="button" class="mrtR-btn" data-mrtr-close>{{ st.modal_close_text | default: 'J’ai compris' | escape }}</button>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('mrt-routine-{{ section.id }}');
  var modal = document.getElementById('mrtR-modal-{{ section.id }}');
  if (!root) return;

  /* apparition au défilement — natif, sans librairie externe */
  var items = root.querySelectorAll('.mrtR-item');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    items.forEach(function (el) { io.observe(el); });
  } else {
    items.forEach(function (el) { el.classList.add('is-in'); });
  }

  /* fenêtre de détail */
  if (modal) {
    var mIcon = modal.querySelector('[data-mrtr-modal-icon]');
    var mTitle = modal.querySelector('[data-mrtr-modal-title]');
    var mText = modal.querySelector('[data-mrtr-modal-text]');
    var opener = null;
    function open(btn) {
      opener = btn;
      mTitle.textContent = btn.dataset.title || '';
      mText.textContent = btn.dataset.content || '';
      var src = btn.closest('.mrtR-body').querySelector('.mrtR-icon');
      mIcon.innerHTML = src ? src.innerHTML : '';
      mIcon.style.display = src ? '' : 'none';
      modal.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      modal.querySelector('[data-mrtr-close]').focus();
    }
    function close() {
      modal.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      if (opener) { opener.focus(); opener = null; }
    }
    root.querySelectorAll('[data-mrtr-open]').forEach(function (b) {
      b.addEventListener('click', function () { open(b); });
    });
    modal.querySelectorAll('[data-mrtr-close]').forEach(function (b) {
      b.addEventListener('click', close);
    });
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
    });
  }

  /* défilement doux si le CTA pointe vers une ancre de la page */
  var cta = root.querySelector('[data-mrtr-cta]');
  if (cta) {
    cta.addEventListener('click', function (e) {
      var href = cta.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      var target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "MRT · Routine",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "La routine" },
    { "type": "richtext", "id": "title", "label": "Titre", "default": "<p>Deux minutes, <em>chaque soir</em></p>", "info": "Utilise <em>…</em> pour mettre un mot en italique doré." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Un geste simple qui devient un réflexe. Pas de promesse magique — juste de la constance." },
    { "type": "text", "id": "chip_text", "label": "Pastille (chrono)", "default": "2 minutes par jour, montre en main" },
    { "type": "select", "id": "chip_icon", "label": "Icône de la pastille", "options": [
      { "value": "chrono", "label": "Chronomètre" }, { "value": "horloge", "label": "Horloge" },
      { "value": "sablier", "label": "Sablier" }, { "value": "lune", "label": "Lune" },
      { "value": "etincelle", "label": "Étincelle" }, { "value": "coeur", "label": "Cœur" },
      { "value": "feuille", "label": "Feuille" }, { "value": "aucune", "label": "Aucune" }
    ], "default": "chrono" },
    { "type": "select", "id": "alignment", "label": "Alignement de l'en-tête", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "range", "id": "title_size", "min": 0, "max": 54, "step": 2, "unit": "px", "label": "Taille du titre", "default": 38 },
    { "type": "range", "id": "header_gap", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Espace sous l'en-tête", "default": 48 },
    { "type": "header", "content": "Appel à l'action" },
    { "type": "text", "id": "cta_note", "label": "Petite phrase au-dessus", "default": "Essai 60 nuits — remboursé si tu n'aimes pas." },
    { "type": "text", "id": "cta_text", "label": "Texte du bouton", "default": "Commencer ma routine" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton", "info": "Laisse #acheter pour remonter au bloc d'achat de la page produit." },
    { "type": "range", "id": "cta_gap", "min": 0, "max": 92, "step": 4, "unit": "px", "label": "Espace au-dessus du bouton", "default": 48 },
    { "type": "header", "content": "Grille" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "unit": "col", "label": "Colonnes (desktop)", "default": 3 },
