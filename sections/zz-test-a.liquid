<div>a</div>
{% schema %}
{
  "name": "ZZ Test A",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "default": "Ta progression"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre",
      "default": "<p>8 à 12 semaines, <em>en toute honnêteté</em></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Chaque cuir chevelu a son rythme. Voici le déroulé habituel.</p>"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 52,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 36
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espace sous l'en-tête",
      "default": 48
    },
    {
      "type": "header",
      "content": "Disposition"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Type",
      "options": [
        {
          "value": "verticale",
          "label": "Verticale"
        },
        {
          "value": "alternee",
          "label": "Alternée gauche / droite"
        },
        {
          "value": "horizontale",
          "label": "Horizontale"
        }
      ],
      "default": "verticale"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Largeur",
      "options": [
        {
          "value": "narrow",
          "label": "Étroite"
        },
        {
          "value": "normal",
          "label": "Normale"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 12,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Espace entre les étapes",
      "default": 34
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 10,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Espace point / contenu",
      "default": 22
    },
    {
      "type": "header",
      "content": "Repères"
    },
    {
      "type": "select",
      "id": "dot_content",
      "label": "Contenu du point",
      "options": [
        {
          "value": "vide",
          "label": "Point simple"
        },
        {
          "value": "numero",
          "label": "Numéro"
        },
        {
          "value": "icone",
          "label": "Icône"
        }
      ],
      "default": "numero"
    },
    {
      "type": "select",
      "id": "dot_style",
      "label": "Style du point",
      "options": [
        {
          "value": "plein",
          "label": "Fond plein"
        },
        {
          "value": "contour",
          "label": "Contour seul"
        }
      ],
      "default": "contour"
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Taille du point",
      "default": 38
    },
    {
      "type": "range",
      "id": "dot_halo",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Halo autour du point",
      "default": 4
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Style de la ligne",
      "options": [
        {
          "value": "plein",
          "label": "Trait plein"
        },
        {
          "value": "pointille",
          "label": "Pointillé"
        }
      ],
      "default": "plein"
    },
    {
      "type": "range",
      "id": "line_width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Épaisseur de la ligne",
      "default": 2
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "checkbox",
      "id": "card_style",
      "label": "Afficher le contenu dans une carte",
      "default": false
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Arrondi des cartes",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Marge intérieure",
      "default": 22
    },
    {
      "type": "range",
      "id": "item_title_size",
      "min": 15,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Taille des titres",
      "default": 21
    },
    {
      "type": "range",
      "id": "item_text_size",
      "min": 12,
      "max": 19,
      "step": 1,
      "unit": "px",
      "label": "Taille des textes",
      "default": 15
    },
    {
      "type": "header",
      "content": "Bouton (optionnel)"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Petite phrase"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond de section",
      "default": "#FAF6EF"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Titres",
      "default": "#1E3A2F"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Textes",
      "default": "#25332C"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent (points)",
      "default": "#C6A15B"
    },
    {
      "type": "color",
      "id": "color_line",
      "label": "Ligne",
      "default": "#DDD3C4"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "Fond du bouton",
      "default": "#1E3A2F"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "Texte du bouton",
      "default": "#FAF6EF"
    },
    {
      "type": "header",
      "content": "Espacements"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Haut (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bas (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_sm",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Haut (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_sm",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bas (mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "etape",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "periode",
          "label": "Période",
          "default": "Semaines 1–2"
        },
        {
          "type": "text",
          "id": "titre",
          "label": "Titre",
          "default": "Le rituel s'installe."
        },
        {
          "type": "richtext",
          "id": "texte",
          "label": "Texte",
          "default": "<p>Deux minutes chaque soir. Le cuir chevelu est nourri, le massage détend.</p>"
        },
        {
          "type": "select",
          "id": "icone",
          "label": "Icône (si « Icône » est choisi ci-dessus)",
          "options": [
            {
              "value": "aucune",
              "label": "Aucune"
            },
            {
              "value": "pousse",
              "label": "🌱 Pousse"
            },
            {
              "value": "feuille",
              "label": "🌿 Feuille"
            },
            {
              "value": "goutte",
              "label": "💧 Goutte"
            },
            {
              "value": "lune",
              "label": "🌙 Lune"
            },
            {
              "value": "soleil",
              "label": "☀️ Soleil"
            },
            {
              "value": "massage",
              "label": "🤲 Massage"
            },
            {
              "value": "cheveux",
              "label": "💇 Cheveux"
            },
            {
              "value": "cuir_chevelu",
              "label": "🧠 Cuir chevelu"
            },
            {
              "value": "horloge",
              "label": "🕐 Horloge"
            },
            {
              "value": "chrono",
              "label": "⏱️ Chronomètre"
            },
            {
              "value": "sablier",
              "label": "⏳ Sablier"
            },
            {
              "value": "calendrier",
              "label": "📅 Calendrier"
            },
            {
              "value": "croissance",
              "label": "📈 Croissance"
            },
            {
              "value": "graphique",
              "label": "📊 Graphique"
            },
            {
              "value": "etincelle",
              "label": "✨ Étincelle"
            },
            {
              "value": "etoile",
              "label": "⭐ Étoile"
            },
            {
              "value": "coche_cercle",
              "label": "✅ Coche"
            },
            {
              "value": "cible",
              "label": "🎯 Cible"
            },
            {
              "value": "coeur",
              "label": "❤️ Cœur"
            },
            {
              "value": "medaille",
              "label": "🏅 Médaille"
            }
          ],
          "default": "aucune"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optionnelle)"
        }
      ]
    }
  ]
}
{% endschema %}
