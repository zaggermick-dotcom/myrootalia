{% schema %}
{
  "name": "ZZ R2B",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "grid_gap_sm",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Espacement (mobile)",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "show_connector",
      "label": "Ligne pointillée entre les étapes",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Largeur",
      "options": [
        {
          "value": "narrow",
          "label": "Étroite"
        },
        {
          "value": "normal",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Cartes"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Arrondi",
      "default": 18
    }
  ]
}
{% endschema %}
