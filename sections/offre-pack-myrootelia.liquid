{%- comment -%}
  myrootelia — Offre pack premium (accueil)
  Lit le produit via all_products[handle] · 3 formats · ajout panier réel
  Conforme : prix barrés = prix unitaire réel × quantité (économie vraie).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
  assign p = all_products[s.product_handle]
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@300;400;500;600;700&display=swap');

  #mrop-{{ uid }} {
    --g: {{ s.color_green | default: '#1E3F33' }};
    --o: {{ s.color_gold | default: '#C25A34' }};
    --o-dark: #A44A29;
    --c: {{ s.color_cream | default: '#F7F2E9' }};
    --ink: {{ s.color_ink | default: '#26332C' }};
    --muted: #6f6a60;
    --line: rgba(30,63,51,.10);
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--sans); color: var(--ink); background: var(--c);
  }
  #mrop-{{ uid }} * { box-sizing: border-box; }
  #mrop-{{ uid }} img { display:block; max-width:100%; }
  #mrop-{{ uid }} .mrop-wrap { max-width: 1080px; margin: 0 auto; padding: 88px 24px; }
  #mrop-{{ uid }} .mrop-head { text-align: center; max-width: 620px; margin: 0 auto 46px; }
  #mrop-{{ uid }} .mrop-eyebrow { font-size: 11.5px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--o); margin: 0 0 14px; display:inline-flex; align-items:center; gap:10px; }
  #mrop-{{ uid }} .mrop-eyebrow::before, #mrop-{{ uid }} .mrop-eyebrow::after { content:""; width:26px; height:1px; background:var(--o); opacity:.5; }
  #mrop-{{ uid }} .mrop-h { font-family: var(--serif); font-weight: 600; color: var(--g); font-size: clamp(21px,3.6vw,40px); line-height:1.12; margin:0 0 14px; }
  #mrop-{{ uid }} .mrop-h em { font-style: italic; color: var(--o); }
  #mrop-{{ uid }} .mrop-lead { font-size: 16px; line-height:1.7; color:#4a463f; margin:0; }

  #mrop-{{ uid }} .mrop-grid { display:grid; grid-template-columns: repeat(3,1fr); gap: 22px; align-items: stretch; }
  #mrop-{{ uid }} .mrop-card { position:relative; background:#fff; border:1px solid var(--line); border-radius:22px; padding:34px 26px 30px; display:flex; flex-direction:column; text-align:center; transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease; }
  #mrop-{{ uid }} .mrop-card:hover { transform: translateY(-6px); box-shadow:0 26px 54px rgba(43,43,43,.12); }
  #mrop-{{ uid }} .mrop-card--hot { border-color: var(--o); box-shadow:0 26px 60px rgba(194,90,52,.18); }
  #mrop-{{ uid }} .mrop-tag { position:absolute; top:-13px; left:50%; transform:translateX(-50%); background:var(--o); color:#fff; font-size:11px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; padding:6px 16px; border-radius:50px; white-space:nowrap; box-shadow:0 8px 18px rgba(194,90,52,.35); }
  #mrop-{{ uid }} .mrop-tag--green { background: var(--g); box-shadow:0 8px 18px rgba(30,63,51,.3); }
  #mrop-{{ uid }} .mrop-fmt { font-family:var(--serif); font-size:24px; color:var(--g); margin:6px 0 4px; }
  #mrop-{{ uid }} .mrop-sub { font-size:13px; color:var(--muted); margin:0 0 18px; }
  #mrop-{{ uid }} .mrop-price { display:flex; align-items:baseline; justify-content:center; gap:10px; margin-bottom:4px; }
  #mrop-{{ uid }} .mrop-price b { font-family:var(--serif); font-size:34px; font-weight:700; color:var(--ink); }
  #mrop-{{ uid }} .mrop-price s { font-size:16px; color:#a89f92; }
  #mrop-{{ uid }} .mrop-unit { font-size:12.5px; color:var(--muted); margin:0 0 12px; }
  #mrop-{{ uid }} .mrop-save { display:inline-block; background:rgba(30,63,51,.08); color:var(--g); font-size:12.5px; font-weight:600; padding:6px 14px; border-radius:50px; margin-bottom:22px; }
  #mrop-{{ uid }} .mrop-save--none { visibility:hidden; }
  #mrop-{{ uid }} .mrop-btn { margin-top:auto; display:block; width:100%; cursor:pointer; font-family:var(--sans); font-weight:600; font-size:15px; padding:15px 20px; border-radius:50px; border:1.5px solid var(--g); background:transparent; color:var(--g); transition: all .25s ease; }
  #mrop-{{ uid }} .mrop-btn:hover { background:var(--g); color:#fff; transform:translateY(-2px); }
  #mrop-{{ uid }} .mrop-card--hot .mrop-btn { background:var(--o); border-color:var(--o); color:#fff; box-shadow:0 10px 24px rgba(194,90,52,.32); }
  #mrop-{{ uid }} .mrop-card--hot .mrop-btn:hover { background:var(--o-dark); border-color:var(--o-dark); }
  #mrop-{{ uid }} .mrop-form { margin:0; margin-top:auto; }

  #mrop-{{ uid }} .mrop-reassure { display:flex; flex-wrap:wrap; justify-content:center; gap:26px; margin-top:38px; }
  #mrop-{{ uid }} .mrop-reassure span { display:inline-flex; align-items:center; gap:8px; font-size:13px; color:var(--muted); }
  #mrop-{{ uid }} .mrop-reassure svg { width:17px; height:17px; color:var(--g); }

  @media (max-width: 860px) {
    #mrop-{{ uid }} .mrop-grid { grid-template-columns: 1fr; max-width:420px; margin:0 auto; }
  }
{%- endstyle -%}

<div id="mrop-{{ uid }}">
  <div class="mrop-wrap">
    <div class="mrop-head">
      <p class="mrop-eyebrow">{{ s.eyebrow | default: "L'offre myrootelia" }}</p>
      <h2 class="mrop-h">{{ s.heading | default: 'Choisissez votre format' }}</h2>
      <p class="mrop-lead">{{ s.subheading | default: 'Plus vous prenez soin de vos racines dans la durée, plus le prix au flacon baisse. Livré à la maison, satisfait ou remboursé.' }}</p>
    </div>

    {%- if p != blank -%}
      <div class="mrop-grid">
        {%- for variant in p.variants -%}
          {%- liquid
            assign is_hot = false
            if forloop.index == s.highlight_position
              assign is_hot = true
            endif
            assign has_save = false
            if variant.compare_at_price > variant.price
              assign has_save = true
            endif
            assign unit_price = variant.price | divided_by: forloop.index
          -%}
          <div class="mrop-card{% if is_hot %} mrop-card--hot{% endif %}">
            {%- if is_hot -%}
              <span class="mrop-tag">{{ s.highlight_badge | default: 'Le plus choisi' }}</span>
            {%- elsif forloop.last -%}
              <span class="mrop-tag mrop-tag--green">{{ s.last_badge | default: 'Meilleure valeur' }}</span>
            {%- endif -%}
            <p class="mrop-fmt">{{ variant.title }}</p>
            <p class="mrop-sub">{{ forloop.index }} flacon{% if forloop.index > 1 %}s{% endif %} · 50 ml chacun</p>
            <div class="mrop-price">
              <b>{{ variant.price | money }}</b>
              {%- if has_save -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {%- if forloop.index > 1 -%}
              <p class="mrop-unit">soit {{ unit_price | money }} / flacon</p>
            {%- else -%}
              <p class="mrop-unit">le flacon</p>
            {%- endif -%}
            {%- if has_save -%}
              <span class="mrop-save">Vous économisez {{ variant.compare_at_price | minus: variant.price | money }}</span>
            {%- else -%}
              <span class="mrop-save mrop-save--none">.</span>
            {%- endif -%}
            <form method="post" action="/cart/add" accept-charset="UTF-8" class="mrop-form">
              <input type="hidden" name="form_type" value="product">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" name="add" class="mrop-btn">{% if is_hot %}Je choisis ce pack{% else %}Ajouter au panier{% endif %}</button>
            </form>
          </div>
        {%- endfor -%}
      </div>

      <div class="mrop-reassure">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>Satisfait ou remboursé 30 j</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 7h14l-1 13H6L5 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>Livraison suivie</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Paiement 100 % sécurisé</span>
      </div>
    {%- else -%}
      <p class="mrop-lead" style="text-align:center;">Renseignez le <em>handle</em> du produit dans les réglages de la section pour afficher les formats.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Offre pack myrootelia",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit (pour lire les variantes)" },
    { "type": "text", "id": "product_handle", "label": "Handle du produit", "default": "huile-de-batana-100-pure-du-honduras" },
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'offre myrootelia" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Choisissez votre format" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Plus vous prenez soin de vos racines dans la durée, plus le prix au flacon baisse. Livré à la maison, satisfait ou remboursé." },
    { "type": "header", "content": "Mise en avant" },
    { "type": "range", "id": "highlight_position", "min": 0, "max": 3, "step": 1, "label": "Format mis en avant (0 = aucun)", "default": 2 },
    { "type": "text", "id": "highlight_badge", "label": "Badge du format mis en avant", "default": "Le plus choisi" },
    { "type": "text", "id": "last_badge", "label": "Badge du dernier format", "default": "Meilleure valeur" },
    { "type": "header", "content": "Couleurs (charte)" },
    { "type": "color", "id": "color_green", "label": "Vert forêt", "default": "#1E3F33" },
    { "type": "color", "id": "color_gold", "label": "Or / terre", "default": "#C25A34" },
    { "type": "color", "id": "color_cream", "label": "Crème", "default": "#F7F2E9" },
    { "type": "color", "id": "color_ink", "label": "Noir doux", "default": "#26332C" }
  ],
  "presets": [{ "name": "Offre pack myrootelia" }]
}
{% endschema %}
