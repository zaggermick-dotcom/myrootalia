{{ 'sticky-images-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sectionId = section.id | remove: '-'
  assign bgImage = section.settings.image_bg_colored

  assign bgimagemobile = section.settings.image_bg_colored_mobile
  if section.settings.enable_cut_bg_color or bgImage != blank or bgimagemobile != blank
    render 'cut-colored'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_sm }}px;
    padding-bottom: {{ section.settings.padding_bottom_sm }}px;
  }

  {%- if section.settings.hide_mobile -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding { display: none; }
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- if section.settings.hide_desktop -%}
        display: none;
      {%- endif -%}
    }
  }
{%- endstyle -%}
{%- # endregion ══════════════════════════════════════════════════════════════ -%}

{%- # ════════════════════════════════════════════════════════════════════════ -%}
{%- # region(collapsed) Markup -%}
{%- render 'separator-top', section: section -%}

{%- capture attributes -%}
  id="{{ section.settings.section_id }}"
  class="color-{{ section.settings.color_palette }} section-{{ section.id }}-padding{% if section.settings.enable_cut_bg_color or bgImage != blank or bgimagemobile != blank %} cut-colored-section{% endif %}"
  data-section-id="{{ section.id }}"
{%- endcapture -%}
<div {{ attributes }}>
  <div class="custom-section container container--{{ section.settings.layout_width }}">
    <div class="stack-scroll-section">
      <div class="stack-grid layout--{{ section.settings.layout }}">
        <div class="stack-left">
          {% for block in section.blocks %}
            <div class="stack-block" data-index="{{ forloop.index0 }}">
              {%- render 'heading',
                enable_animations: section.settings.enable_animations,
                animation: section.settings.animation,
                heading: block.settings.heading,
                heading_class: 'sticky__image__heading',
                heading_style: block.settings.heading_style,
                subheading: block.settings.subheading
              -%}

              <div
                class="image-with-text__text tj-richtext-class image-with-text__bold-{{ block.settings.color_bold_words }} rte"
                {%- render 'animation',
                  enable_animations: section.settings.enable_animations,
                  animation: section.settings.animation
                -%}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.description }}
              </div>

              <div class="button__container image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }}">
                <div
                  class="banner__content-buttons image-with-text__buttons"
                  {{ block.shopify_attributes }}
                  {%- render 'animation',
                    enable_animations: section.settings.enable_animations,
                    animation: section.settings.animation
                  -%}
                >
                  <a
                    href="{{ block.settings.button_link }}"
                    class="button button__style--{{ block.settings.button_style }}"
                  >
                    {{ block.settings.button_text }}
                  </a>

                  {%- if block.settings.button_text_secondary != blank
                    and block.settings.button_link_secondary != blank
                  -%}
                    <a
                      href="{{ block.settings.button_link_secondary }}"
                      class="button button__style--{{ block.settings.button_style_secondary }}"
                    >
                      {{ block.settings.button_text_secondary }}
                    </a>
                  {%- endif -%}
                </div>

                <div
                  {% render 'animation',
                    enable_animations: section.settings.enable_animations,
                    animation: section.settings.animation
                  %}
                >
                  {%- liquid
                    if block.settings.extra_button
                      render 'extra-button', unique: section.id
                    endif
                  -%}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="stack-right">
          <div class="image-container">
            {% for block in section.blocks %}
              <div class="sticky-image-with-cards global-media-settings" data-index="{{ forloop.index0 }}">
                {% if block.settings.media_type == 'video' and block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '1100x',
                      autoplay: true,
                      loop: true,
                      controls: false,
                      muted: true,
                      playsinline: true
                  }}
                {% elsif block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.heading | strip_html | escape }}"
                    width="1600"
                    height="900"
                    loading="lazy"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="mobile-stack">
        {% for block in section.blocks %}
          <div class="mobile-card">
            {% assign videomobile = block.settings.video_mobile %}
            {% assign videodesktop = block.settings.video %}
            {% assign imagemobile = block.settings.image_mobile %}
            {% assign imagedesktop = block.settings.image %}

            {% if block.settings.media_type == 'video' %}
              {% if videomobile != blank %}
                {{
                  videomobile
                  | video_tag:
                    image_size: '800x',
                    autoplay: true,
                    loop: true,
                    controls: false,
                    muted: true,
                    playsinline: true
                }}
              {% elsif videodesktop != blank %}
                {{
                  videodesktop
                  | video_tag:
                    image_size: '800x',
                    autoplay: true,
                    loop: true,
                    controls: false,
                    muted: true,
                    playsinline: true
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

            {% elsif block.settings.media_type == 'image' %}
              {% if imagemobile != blank %}
                <img
                  src="{{ imagemobile | image_url: width: 800 }}"
                  alt="{{ block.settings.heading | strip_html | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {% elsif imagedesktop != blank %}
                <img
                  src="{{ imagedesktop | image_url: width: 800 }}"
                  alt="{{ block.settings.heading | strip_html | escape }}"
                  width="800"
                  height="600"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <div class="mobile-content">
              {%- render 'heading',
                enable_animations: section.settings.enable_animations,
                animation: section.settings.animation,
                heading: block.settings.heading,
                heading_class: 'sticky__image__heading',
                heading_style: block.settings.heading_style,
                subheading: block.settings.subheading
              -%}

              <div
                class="image-with-text__text tj-richtext-class image-with-text__bold-{{ block.settings.color_bold_words }} rte"
                {%- render 'animation',
                  enable_animations: section.settings.enable_animations,
                  animation: section.settings.animation
                -%}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.description }}
              </div>

              <div class="button__container image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }}">
                <div
                  class="banner__content-buttons image-with-text__buttons"
                  {{ block.shopify_attributes }}
                  {%- render 'animation',
                    enable_animations: section.settings.enable_animations,
                    animation: section.settings.animation
                  -%}
                >
                  <a
                    href="{{ block.settings.button_link }}"
                    class="button button__style--{{ block.settings.button_style }}"
                  >
                    {{ block.settings.button_text }}
                  </a>

                  {%- if block.settings.button_text_secondary != blank
                    and block.settings.button_link_secondary != blank
                  -%}
                    <a
                      href="{{ block.settings.button_link_secondary }}"
                      class="button button__style--{{ block.settings.button_style_secondary }}"
                    >
                      {{ block.settings.button_text_secondary }}
                    </a>
                  {%- endif -%}
                </div>

                <div
                  {% render 'animation',
                    enable_animations: section.settings.enable_animations,
                    animation: section.settings.animation
                  %}
                >
                  {%- liquid
                    if block.settings.extra_button
                      render 'extra-button', unique: section.id
                    endif
                  -%}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{%- render 'separator-bottom', section: section -%}

<script>
  function initStackScroll(section) {
    if (!section) return;

    const cards = section.querySelectorAll('.sticky-image-with-cards');

    function update() {
      const rect = section.getBoundingClientRect();

      const progress = Math.max(0, Math.min(1, -rect.top / (rect.height - window.innerHeight)));

      const total = cards.length - 1;

      cards.forEach((card, i) => {
        if (i === 0) {
          card.style.transform = `translateY(0%)`;
          return;
        }

        const startStep = (i - 1) / total;
        const endStep = i / total;

        let local = (progress - startStep) / (endStep - startStep);
        local = Math.max(0, Math.min(1, local));

        const move = 100 - local * 100;
        card.style.transform = `translateY(${move}%)`;
      });
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.stack-scroll-section');
    initStackScroll(section);
  });

  document.addEventListener('shopify:section:load', (event) => {
    const section = event.target.querySelector('.stack-scroll-section');
    if (section) initStackScroll(section);
  });

  document.addEventListener('shopify:section:reorder', () => {
    const section = document.querySelector('.stack-scroll-section');
    if (section) initStackScroll(section);
  });
</script>


