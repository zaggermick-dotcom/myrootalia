{% schema %}
{
  "name": "ZZ I1",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "unit": "col",
      "label": "Colonnes (mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 10,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Espacement (mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Largeur",
      "options": [
        {
          "value": "narrow",
          "label": "Étroite"
        },
        {
          "value": "normal",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Bouton (optionnel)"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond de section",
      "default": "#FAF6EF"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Fond des cartes",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
