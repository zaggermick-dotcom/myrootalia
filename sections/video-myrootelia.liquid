{%- comment -%}
  myrootelia — Section vidéo (accueil + page produit)
  Accepte une vidéo Shopify (native), une URL YouTube/Vimeo, ou affiche un
  emplacement élégant si vide. Charte premium (vert forêt / terracotta / ivoire).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@300;400;500;600&display=swap');

  #vid-{{ uid }} {
    --g: {{ s.color_green | default: '#1E3F33' }};
    --o: {{ s.color_gold | default: '#C25A34' }};
    --c: {{ s.color_cream | default: '#F7F2E9' }};
    --ink: {{ s.color_ink | default: '#26332C' }};
    --serif: 'Cormorant Garamond', Georgia, serif;
    --sans: 'Jost', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--sans); color: var(--ink);
    background: {% if s.dark %}var(--g){% else %}var(--c){% endif %};
    padding: clamp(56px,7vw,92px) 0;
  }
  #vid-{{ uid }} * { box-sizing: border-box; }
  #vid-{{ uid }} .vid-wrap { max-width: 960px; margin: 0 auto; padding: 0 24px; text-align: center; }
  #vid-{{ uid }} .vid-eyebrow { font-size: 11.5px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: {% if s.dark %}#cbb892{% else %}var(--o){% endif %}; margin: 0 0 14px; }
  #vid-{{ uid }} .vid-h { font-family: var(--serif); font-weight: 600; color: {% if s.dark %}#fff{% else %}var(--g){% endif %}; font-size: clamp(24px,3.4vw,40px); line-height: 1.15; margin: 0 0 14px; }
  #vid-{{ uid }} .vid-sub { font-size: 15px; line-height: 1.7; color: {% if s.dark %}#e2dccf{% else %}#4a463f{% endif %}; max-width: 560px; margin: 0 auto 40px; }
  #vid-{{ uid }} .vid-frame { position: relative; aspect-ratio: 16/9; border-radius: 24px; overflow: hidden; box-shadow: 0 40px 90px rgba(38,51,44,.22); background: #000; }
  #vid-{{ uid }} .vid-frame video, #vid-{{ uid }} .vid-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  #vid-{{ uid }} .vid-ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;
    background: linear-gradient(135deg, var(--g-dark, #14291F), var(--g) 65%, #2c4c3f); color: #f3efe6; text-align: center; padding: 24px; }
  #vid-{{ uid }} .vid-play { width: 84px; height: 84px; border-radius: 50%; background: var(--o); display: flex; align-items: center; justify-content: center; box-shadow: 0 16px 40px rgba(194,90,52,.5); transition: transform .3s ease; }
  #vid-{{ uid }} .vid-frame:hover .vid-play { transform: scale(1.08); }
  #vid-{{ uid }} .vid-play svg { width: 34px; height: 34px; color: #fff; margin-left: 4px; }
  #vid-{{ uid }} .vid-ph b { font-family: var(--serif); font-size: 22px; font-weight: 600; }
  #vid-{{ uid }} .vid-ph span { font-size: 13px; color: #cbb892; letter-spacing: .3px; }
{%- endstyle -%}

<div id="vid-{{ uid }}">
  <div class="vid-wrap">
    {%- if s.eyebrow != blank -%}<p class="vid-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="vid-h">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="vid-sub">{{ s.subheading }}</p>{%- endif -%}

    <div class="vid-frame">
      {%- if s.video != blank -%}
        {{ s.video | video_tag: image_size: '1100x', controls: true, playsinline: true, preload: 'metadata' }}
      {%- elsif s.video_url != blank -%}
        {%- if s.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ s.video_url.id }}" title="{{ s.heading | escape }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {%- elsif s.video_url.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}" title="{{ s.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
        {%- endif -%}
      {%- else -%}
        <div class="vid-ph">
          <div class="vid-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>
          <b>{{ s.placeholder_title | default: 'Votre vidéo ici' }}</b>
          <span>{{ s.placeholder_note | default: 'Ajoutez une vidéo Shopify ou un lien YouTube / Vimeo dans les réglages de la section.' }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vidéo myrootelia",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Vidéo (2 options)" },
    { "type": "video", "id": "video", "label": "Vidéo Shopify (recommandé)" },
    { "type": "video_url", "id": "video_url", "label": "…ou lien YouTube / Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "En vidéo" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le rituel Batana en mouvement" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Découvrez le geste, la texture et l'origine de notre huile — en une minute." },
    { "type": "text", "id": "placeholder_title", "label": "Titre de l'emplacement vide", "default": "Votre vidéo ici" },
    { "type": "text", "id": "placeholder_note", "label": "Note de l'emplacement vide", "default": "Ajoutez une vidéo Shopify ou un lien YouTube / Vimeo dans les réglages de la section." },
    { "type": "header", "content": "Apparence" },
    { "type": "checkbox", "id": "dark", "label": "Fond vert foncé", "default": false },
    { "type": "color", "id": "color_green", "label": "Vert forêt", "default": "#1E3F33" },
    { "type": "color", "id": "color_gold", "label": "Terracotta", "default": "#C25A34" },
    { "type": "color", "id": "color_cream", "label": "Ivoire", "default": "#F7F2E9" },
    { "type": "color", "id": "color_ink", "label": "Encre", "default": "#26332C" }
  ],
  "presets": [{ "name": "Vidéo myrootelia" }]
}
{% endschema %}
