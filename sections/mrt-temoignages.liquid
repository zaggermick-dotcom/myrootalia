{% comment %}
  MRT · Témoignages 3D avant/après — version affinée myrootalia
  Basée sur « Témoignages 3D B/A », avec corrections :
  - polices du thème (plus d'import Google Fonts)
  - réglages « Effet carte active » et « Défilement auto » réellement fonctionnels
  - autoplay sans dépendre des flèches, pause au survol et quand l'onglet est caché
  - couleur des étoiles branchée sur le réglage
  - le produit associé n'écrase plus l'objet produit global de la page
  - valeurs par défaut aux couleurs de la marque et allégations prudentes
{% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color | default: '#C25A34' }};
    --verified-icon-color: {{ section.settings.verified_icon_color }};
    --star-bg-color: {{ section.settings.star_color | default: '#00B67A' }};
    --star-empty-color: #dcdce6;
    --product-bg-color: {{ section.settings.product_bg_color }};
    --cta-bg-color: {{ section.settings.cta_bg_color }};
    --cta-text-color: {{ section.settings.cta_text_color }};
    --arrow-color: {{ section.settings.arrow_color | default: '#1E3A2F' }};
    --dot-color: {{ section.settings.dot_color | default: '#d8d2c6' }};
    --dot-active-color: {{ section.settings.dot_active_color | default: '#1E3A2F' }};
    --card-border-color: {{ section.settings.card_border_color | default: '#1E3A2F' }};
    --card-border-width: {{ section.settings.card_border_width | default: 1 }}px;
    --slider-handle-color: {{ section.settings.slider_handle_color | default: '#ffffff' }};
    --font-heading: var(--font-heading-family, Georgia, serif);
    --font-body: var(--font-body-family, -apple-system, BlinkMacSystemFont, sans-serif);
    --card-width-desktop: {{ section.settings.card_width_desktop }}px;
    --card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --product-padding: {{ section.settings.product_padding }}px;
    --product-img-size: {{ section.settings.product_img_size }}px;
    --product-title-size: {{ section.settings.product_title_size }}px;
    --product-subtitle-size: {{ section.settings.product_subtitle_size }}px;
    --product-btn-size: {{ section.settings.product_btn_size }}px;
    --product-border-radius: {{ section.settings.product_border_radius }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--bg-color);
    overflow: hidden;
    position: relative;
    font-family: var(--font-body);
  }

  .taa-container {
    max-width: {% if section.settings.layout_width == 'container' %}1200px{% else %}100%{% endif %};
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    text-align: {{ section.settings.alignment }};
  }

  .taa-header-group {
    margin-bottom: 25px;
    {% if section.settings.alignment == 'center' %}margin-left:auto;margin-right:auto;{% endif %}
    max-width: 800px;
  }
  .taa-subheading { font-family:var(--font-body); font-size:11px; font-weight:600; text-transform:uppercase;
    letter-spacing:3px; margin-bottom:16px; color:var(--accent-color); }
  .taa-badge { display:inline-flex; align-items:center; gap:8px; background:var(--verified-icon-color);
    color:#fff; padding:8px 20px; border-radius:50px; font-size:11px; font-weight:700; text-transform:uppercase;
    letter-spacing:1.5px; margin-bottom:20px; box-shadow:0 4px 15px rgba(0,0,0,.12); }
  .taa-badge svg { width:14px; height:14px; }
  .taa-title { font-family:var(--font-heading); font-size:clamp(28px,5vw,48px); font-weight:500;
    margin-bottom:18px; line-height:1.15; color:var(--title-color); letter-spacing:-.02em; }
  .taa-title em, .taa-title i { font-style:italic; font-weight:400; color:var(--accent-color); }
  .taa-description { font-size:15px; opacity:.75; line-height:1.7; color:var(--text-color); max-width:600px;
    {% if section.settings.alignment == 'center' %}margin-left:auto;margin-right:auto;{% endif %} }

  .taa-trust-badges { display:flex;
    justify-content:{% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    gap:24px; margin-top:28px; flex-wrap:nowrap; overflow-x:auto; -webkit-overflow-scrolling:touch;
    scrollbar-width:none; padding-bottom:5px; }
  .taa-trust-badges::-webkit-scrollbar { display:none; }
  .taa-trust-badge { display:flex; align-items:center; gap:6px; font-size:11px; font-weight:500;
    color:var(--text-color); opacity:.85; white-space:nowrap; flex-shrink:0; }
  .taa-trust-badge-icon { width:16px; height:16px; color:var(--verified-icon-color); flex-shrink:0; }

  .taa-slider-wrapper { display:flex; overflow-x:auto; gap:0;
    padding:40px calc(50% - var(--card-width-desktop) / 2) 50px;
    scroll-snap-type:x mandatory; scroll-behavior:smooth; -webkit-overflow-scrolling:touch;
    align-items:center; scrollbar-width:none; justify-content:flex-start;
    transform:translateZ(0); perspective:1500px; }
  .taa-slider-wrapper::-webkit-scrollbar { display:none; }

  .taa-card { flex:0 0 var(--card-width-desktop); width:var(--card-width-desktop); height:var(--card-height-desktop);
    margin:0 20px; background:var(--card-bg-color); border-radius:20px; display:flex; flex-direction:row;
    overflow:hidden; scroll-snap-align:center; position:relative; color:var(--text-color); cursor:pointer; z-index:1;
    backface-visibility:hidden; will-change:transform,opacity,filter;
    border:var(--card-border-width) solid var(--card-border-color); transform-style:preserve-3d; }

  /* ═══ Animations desktop — 7 types ═══ */
  .scale-desktop-smooth .taa-card{opacity:.5;filter:blur(2px);transform:translate3d(0,0,0) scale3d(.8,.8,1);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .12s ease-out}
  .scale-desktop-smooth .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,80px) scale3d(1.15,1.15,1);box-shadow:0 60px 120px -20px rgba(0,0,0,.35);z-index:100}
  .scale-desktop-smooth .taa-card.adjacent{opacity:.65;filter:blur(1px);transform:translate3d(0,0,0) scale3d(.9,.9,1)}
  .scale-desktop-bounce .taa-card{opacity:.4;filter:blur(3px);transform:translate3d(0,0,0) scale3d(.7,.7,1);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .1s ease-out}
  .scale-desktop-bounce .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,100px) scale3d(1.25,1.25,1);box-shadow:0 80px 140px -25px rgba(0,0,0,.4);z-index:100}
  .scale-desktop-bounce .taa-card.adjacent{opacity:.55;filter:blur(1.5px);transform:translate3d(0,0,0) scale3d(.85,.85,1)}
  .scale-desktop-elastic .taa-card{opacity:.45;filter:blur(2px);transform:translate3d(0,0,0) scale3d(.75,.75,1);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .12s ease-out}
  .scale-desktop-elastic .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,90px) scale3d(1.2,1.2,1);box-shadow:0 70px 130px -20px rgba(0,0,0,.35);z-index:100}
  .scale-desktop-elastic .taa-card.adjacent{opacity:.6;filter:blur(1px);transform:translate3d(0,0,0) scale3d(.88,.88,1)}
  .scale-desktop-slow .taa-card{opacity:.5;filter:blur(2.5px);transform:translate3d(0,0,0) scale3d(.78,.78,1);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .15s ease-out}
  .scale-desktop-slow .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,70px) scale3d(1.18,1.18,1);box-shadow:0 55px 110px -18px rgba(0,0,0,.3);z-index:100}
  .scale-desktop-slow .taa-card.adjacent{opacity:.65;filter:blur(1px);transform:translate3d(0,0,0) scale3d(.92,.92,1)}
  .scale-desktop-snap .taa-card{opacity:.4;filter:blur(2px);transform:translate3d(0,0,0) scale3d(.82,.82,1);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .08s ease-out}
  .scale-desktop-snap .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,85px) scale3d(1.22,1.22,1);box-shadow:0 65px 125px -20px rgba(0,0,0,.35);z-index:100}
  .scale-desktop-snap .taa-card.adjacent{opacity:.55;filter:blur(1px);transform:translate3d(0,0,0) scale3d(.9,.9,1)}
  .scale-desktop-fade .taa-card{opacity:.5;filter:blur(2px);transform:translate3d(0,0,-20px) scale3d(.85,.85,1);box-shadow:0 5px 15px rgba(0,0,0,.08);transition:all .1s ease-out}
  .scale-desktop-fade .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,20px) scale3d(1.05,1.05,1);box-shadow:0 25px 50px rgba(0,0,0,.15);z-index:100}
  .scale-desktop-fade .taa-card.adjacent{opacity:.5;filter:blur(2px);transform:translate3d(0,0,0) scale3d(.87,.87,1)}
  .scale-desktop-mega .taa-card{opacity:.35;filter:blur(4px);transform:translate3d(0,0,-200px) scale3d(.65,.65,1) rotateY(15deg);box-shadow:0 4px 10px rgba(0,0,0,.05);transition:all .1s ease-out}
  .scale-desktop-mega .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,120px) scale3d(1.35,1.35,1) rotateY(0);box-shadow:0 100px 180px -30px rgba(0,0,0,.45);z-index:100}
  .scale-desktop-mega .taa-card.adjacent-left{opacity:.5;filter:blur(2px);transform:translate3d(40px,0,-100px) scale3d(.8,.8,1) rotateY(10deg)}
  .scale-desktop-mega .taa-card.adjacent-right{opacity:.5;filter:blur(2px);transform:translate3d(-40px,0,-100px) scale3d(.8,.8,1) rotateY(-10deg)}

  /* ═══ Images — slider avant/après ═══ */
  .taa-images { flex:0 0 45%; width:45%; height:100%; position:relative; overflow:hidden;
    background:linear-gradient(145deg,#f8f8f8,#efefef); cursor:col-resize; }
  .taa-images.single-mode { cursor:default; }
  .taa-image { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; }
  .taa-image.before { z-index:1; }
  .taa-image.after { z-index:2; clip-path:inset(0 50% 0 0); }
  .taa-ba-slider { position:absolute; top:0; left:50%; width:4px; height:100%; background:var(--slider-handle-color);
    z-index:10; transform:translateX(-50%); cursor:col-resize; box-shadow:0 0 15px rgba(0,0,0,.3); }
  .taa-ba-slider::before { content:''; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    width:44px; height:44px; background:var(--slider-handle-color); border-radius:50%; box-shadow:0 4px 20px rgba(0,0,0,.25); }
  .taa-ba-slider::after { content:'↔'; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    font-size:16px; color:var(--title-color); font-weight:bold; z-index:2; }
  .taa-label { position:absolute; bottom:10px; padding:5px 12px; background:rgba(255,255,255,.95);
    backdrop-filter:blur(10px); border-radius:50px; font-size:9px; font-weight:700; text-transform:uppercase;
    letter-spacing:1px; color:var(--title-color); z-index:15; box-shadow:0 4px 15px rgba(0,0,0,.12); transform:translateX(-50%); }
  .taa-label.before { left:25%; }
  .taa-label.after { left:75%; }
  .taa-images.single-mode .taa-image-box { width:100%; height:100%; }
  .taa-images.single-mode .taa-image-box svg,
  .taa-images .taa-image-box svg { width:100%; height:100%; }

  /* ═══ Contenu ═══ */
  .taa-content { flex:0 0 55%; width:55%; height:100%; padding:18px 20px; text-align:left; display:flex;
    flex-direction:column; justify-content:flex-start; background:var(--card-bg-color); overflow:visible;
    box-sizing:border-box; gap:8px; }
  .taa-content-top { flex:1; overflow:visible; display:flex; flex-direction:column; min-height:0; gap:6px; }
  .taa-author-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;
    flex-wrap:nowrap; gap:8px; flex-shrink:0; }
  .taa-author-info { display:flex; align-items:center; gap:8px; }
  .taa-author { font-weight:600; font-size:14px; color:var(--text-color); letter-spacing:.2px; }
  .taa-verified-badge { display:inline-flex; align-items:center; gap:4px;
    background:color-mix(in srgb, var(--verified-icon-color) 14%, #fff); color:var(--verified-icon-color);
    padding:4px 10px; border-radius:50px; font-size:10px; font-weight:600; }
  .taa-verified-badge svg { width:12px; height:12px; }
  .taa-author-age { font-weight:400; opacity:.55; font-size:12px; color:var(--text-color); }
  .taa-stars-wrapper { display:flex; align-items:center; gap:4px; flex-shrink:0; }
  .taa-stars { display:flex; gap:2px; }
  .taa-star-box { position:relative; width:22px; height:22px; min-width:22px; background:var(--star-empty-color);
    overflow:hidden; display:flex; align-items:center; justify-content:center; border-radius:4px; }
  .taa-star-fill { position:absolute; left:0; top:0; height:100%; background:var(--star-bg-color); }
  .taa-star-icon { position:relative; z-index:2; width:14px; height:14px; fill:#fff; }
  .taa-review-title { font-family:var(--font-heading); font-size:16px; font-weight:600; margin:0 0 8px;
    line-height:1.3; color:var(--title-color); letter-spacing:-.01em; flex-shrink:0; }
  .taa-review-text { font-size:13px; font-weight:400; line-height:1.6; margin:0 0 8px;
    color:var(--text-color); opacity:.8; flex:0 0 auto; }
  .taa-results-tag { display:inline-flex; align-items:center; gap:6px;
    background:color-mix(in srgb, var(--accent-color) 18%, #fff); color:color-mix(in srgb, var(--accent-color) 70%, #000);
    padding:8px 14px; border-radius:8px; font-size:11px; font-weight:600; margin-bottom:12px; flex-shrink:0;
    align-self:flex-start; }
  .taa-results-tag svg { width:14px; height:14px; }

  .taa-product { background:var(--product-bg-color); border-radius:var(--product-border-radius);
    padding:var(--product-padding); display:flex; align-items:center; justify-content:space-between;
    transition:all .25s ease; gap:8px; flex-shrink:0; margin-top:auto; }
  .taa-product:hover { box-shadow:0 5px 20px rgba(0,0,0,.08); transform:translateY(-2px); }
  .taa-product-left { display:flex; align-items:center; gap:10px; flex:1; min-width:0; overflow:hidden; }
  .taa-product-img { width:var(--product-img-size); height:var(--product-img-size); min-width:var(--product-img-size);
    border-radius:8px; object-fit:cover; background:#fff; box-shadow:0 2px 10px rgba(0,0,0,.08); flex-shrink:0; }
  .taa-product-info { display:flex; flex-direction:column; text-align:left; gap:2px; min-width:0; overflow:hidden; }
  .taa-product-title { font-size:var(--product-title-size); font-weight:600; line-height:1.3;
    color:var(--title-color); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .taa-product-subtitle { font-size:var(--product-subtitle-size); font-weight:400; opacity:.6;
    color:var(--text-color); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .taa-cart-btn { width:var(--product-btn-size); height:var(--product-btn-size); min-width:var(--product-btn-size);
    background:var(--cta-bg-color); border-radius:50%; display:flex; align-items:center; justify-content:center;
    color:var(--cta-text-color); border:none; cursor:pointer; text-decoration:none; transition:all .25s ease;
    box-shadow:0 2px 8px rgba(0,0,0,.1); flex-shrink:0; }
  .taa-cart-btn svg { width:calc(var(--product-btn-size) * .45); height:calc(var(--product-btn-size) * .45); }
  .taa-cart-btn:hover { transform:scale(1.12); box-shadow:0 6px 18px rgba(0,0,0,.18); }

  .taa-nav-btn { position:absolute; top:50%; transform:translateY(-50%); width:52px; height:52px; background:#fff;
    border-radius:50%; box-shadow:0 6px 25px rgba(0,0,0,.12); border:none; cursor:pointer; z-index:20;
    display:flex; align-items:center; justify-content:center; color:var(--arrow-color); transition:all .2s ease; }
  .taa-nav-btn:hover { transform:translateY(-50%) scale(1.15); box-shadow:0 10px 35px rgba(0,0,0,.18);
    background:var(--cta-bg-color); color:var(--cta-text-color); }
  .taa-nav-btn:active { transform:translateY(-50%) scale(1.05); }
  .taa-nav-btn.prev { left:15px; }
  .taa-nav-btn.next { right:15px; }
  .taa-pagination { display:flex; justify-content:center; gap:12px; margin-top:15px; }
  .taa-dot { width:10px; height:10px; background:var(--dot-color); border-radius:50%; cursor:pointer; transition:all .25s ease; }
  .taa-dot:hover { background:var(--dot-active-color); opacity:.6; transform:scale(1.2); }
  .taa-dot.active { background:var(--dot-active-color); transform:scale(1.5); box-shadow:0 2px 10px rgba(0,0,0,.2); }

  .taa-disclaimer { text-align:center; font-size:12px; color:var(--text-color); opacity:.55; margin-top:10px; }

  .taa-stats-bar { display:flex; justify-content:center; gap:50px; margin-top:50px; padding:30px 0;
    border-top:1px solid rgba(0,0,0,.06); border-bottom:1px solid rgba(0,0,0,.06); flex-wrap:nowrap;
    overflow-x:auto; scrollbar-width:none; }
  .taa-stats-bar::-webkit-scrollbar { display:none; }
  .taa-stat { text-align:center; flex-shrink:0; }
  .taa-stat-number { font-family:var(--font-heading); font-size:clamp(26px,4vw,40px); font-weight:600;
    color:var(--title-color); line-height:1.1; }
  .taa-stat-label { font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:1.5px;
    color:var(--text-color); margin-top:8px; opacity:.6; }
  .taa-write-review-btn { display:inline-flex; align-items:center; gap:8px; padding:14px 28px;
    background:var(--cta-bg-color); color:var(--cta-text-color); border-radius:100px; text-decoration:none;
    font-weight:600; font-size:13px; margin-top:15px; cursor:pointer; border:none; transition:all .25s ease;
    box-shadow:0 4px 15px rgba(0,0,0,.1); }
  .taa-write-review-btn:hover { transform:translateY(-3px); box-shadow:0 8px 25px rgba(0,0,0,.18); }

  @media screen and (max-width: 768px) {
    .taa-header-group { margin-bottom:35px; }
    .taa-title { font-size:26px; }
    .taa-description { font-size:14px; }
    .taa-trust-badges { justify-content:flex-start; gap:16px; margin-top:20px;
      margin-left:-20px; margin-right:-20px; padding:0 20px 8px; }
    .taa-slider-wrapper { gap:0; padding:60px calc(50% - var(--card-width-mobile) / 2) 70px; }
    .taa-card { flex:0 0 var(--card-width-mobile); width:var(--card-width-mobile); height:auto;
      min-height:var(--card-height-mobile); flex-direction:column; margin:0 12px; border-radius:18px; }

    .scale-mobile-smooth .taa-card{opacity:.45;filter:blur(2px);transform:translate3d(0,20px,0) scale3d(.82,.82,1);transition:all .3s cubic-bezier(.25,.46,.45,.94)}
    .scale-mobile-smooth .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,0) scale3d(1.05,1.05,1);box-shadow:0 35px 70px -15px rgba(0,0,0,.25);z-index:10}
    .scale-mobile-smooth .taa-card.adjacent{opacity:.6;filter:blur(1px);transform:translate3d(0,10px,0) scale3d(.9,.9,1)}
    .scale-mobile-bounce .taa-card{opacity:.4;filter:blur(3px);transform:translate3d(0,40px,0) scale3d(.75,.75,1) rotateX(10deg);transition:all .25s cubic-bezier(.68,-.55,.265,1.55)}
    .scale-mobile-bounce .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,-10px,0) scale3d(1.08,1.08,1) rotateX(0);box-shadow:0 50px 100px -20px rgba(0,0,0,.35);z-index:10}
    .scale-mobile-bounce .taa-card.adjacent{opacity:.55;filter:blur(1.5px);transform:translate3d(0,15px,0) scale3d(.85,.85,1) rotateX(5deg)}
    .scale-mobile-elastic .taa-card{opacity:.45;filter:blur(2px);transform:translate3d(0,30px,0) scale3d(.78,.78,1);transition:all .35s cubic-bezier(.175,.885,.32,1.275)}
    .scale-mobile-elastic .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,-5px,0) scale3d(1.1,1.1,1);box-shadow:0 45px 90px -18px rgba(0,0,0,.3);z-index:10}
    .scale-mobile-elastic .taa-card.adjacent{opacity:.58;filter:blur(1px);transform:translate3d(0,12px,0) scale3d(.88,.88,1)}
    .scale-mobile-slow .taa-card{opacity:.5;filter:blur(2px);transform:translate3d(0,25px,0) scale3d(.8,.8,1);transition:all .45s cubic-bezier(.22,.61,.36,1)}
    .scale-mobile-slow .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,0) scale3d(1.06,1.06,1);box-shadow:0 40px 80px -15px rgba(0,0,0,.25);z-index:10}
    .scale-mobile-slow .taa-card.adjacent{opacity:.6;filter:blur(1px);transform:translate3d(0,10px,0) scale3d(.9,.9,1)}
    .scale-mobile-snap .taa-card{opacity:.4;filter:blur(2px);transform:translate3d(0,35px,0) scale3d(.82,.82,1);transition:all .15s cubic-bezier(.34,1.56,.64,1)}
    .scale-mobile-snap .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,-8px,0) scale3d(1.08,1.08,1);box-shadow:0 45px 90px -18px rgba(0,0,0,.32);z-index:10}
    .scale-mobile-snap .taa-card.adjacent{opacity:.55;filter:blur(1px);transform:translate3d(0,12px,0) scale3d(.9,.9,1)}
    .scale-mobile-fade .taa-card{opacity:.3;filter:blur(4px);transform:translate3d(0,20px,0) scale3d(.85,.85,1);transition:all .3s cubic-bezier(.4,0,.2,1)}
    .scale-mobile-fade .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,0,0) scale3d(1.04,1.04,1);box-shadow:0 35px 70px -12px rgba(0,0,0,.22);z-index:10}
    .scale-mobile-fade .taa-card.adjacent{opacity:.5;filter:blur(2px);transform:translate3d(0,8px,0) scale3d(.92,.92,1)}
    .scale-mobile-mega .taa-card{opacity:.35;filter:blur(4px);transform:translate3d(0,50px,0) scale3d(.68,.68,1) rotateX(15deg);transition:all .35s cubic-bezier(.19,1,.22,1)}
    .scale-mobile-mega .taa-card.active{opacity:1;filter:blur(0);transform:translate3d(0,-15px,0) scale3d(1.15,1.15,1) rotateX(0);box-shadow:0 60px 120px -25px rgba(0,0,0,.4);z-index:10}
    .scale-mobile-mega .taa-card.adjacent{opacity:.5;filter:blur(2px);transform:translate3d(0,20px,0) scale3d(.82,.82,1) rotateX(8deg)}

    .taa-images { flex:0 0 200px; width:100%; height:200px; }
    .taa-content { flex:1; width:100%; padding:18px 16px; }
    .taa-ba-slider::before { width:38px; height:38px; }
    .taa-ba-slider::after { font-size:14px; }
    .taa-label { padding:5px 10px; font-size:8px; bottom:8px; }
    .taa-nav-btn { display:none; }
    .taa-swipe-hint { display:flex; justify-content:center; align-items:center; gap:8px; margin-top:15px;
      font-size:12px; color:var(--text-color); opacity:.5; animation:swipeHintAnim 2s ease-in-out infinite; }
    @keyframes swipeHintAnim { 0%,100% { transform:translateX(0); opacity:.5; } 50% { transform:translateX(10px); opacity:.8; } }
    .taa-swipe-hint svg { width:16px; height:16px; }
    .taa-stats-bar { gap:30px; padding:25px 20px; margin-top:40px; margin-left:-20px; margin-right:-20px; justify-content:center; }
    .taa-stat-number { font-size:24px; }
    .taa-stat-label { font-size:9px; }
    .taa-review-title { font-size:16px; }
    .taa-review-text { font-size:12px; }
    .taa-author { font-size:12px; }
    .taa-star-box { width:18px; height:18px; min-width:18px; }
    .taa-star-icon { width:11px; height:11px; }
    .taa-product { padding:calc(var(--product-padding) * .85); }
    .taa-product-img { width:calc(var(--product-img-size) * .85); height:calc(var(--product-img-size) * .85); min-width:calc(var(--product-img-size) * .85); }
    .taa-product-title { font-size:calc(var(--product-title-size) * .9); }
    .taa-product-subtitle { font-size:calc(var(--product-subtitle-size) * .9); }
    .taa-cart-btn { width:calc(var(--product-btn-size) * .9); height:calc(var(--product-btn-size) * .9); min-width:calc(var(--product-btn-size) * .9); }
  }
  @media screen and (min-width: 769px) { .taa-swipe-hint { display:none; } }
  @media(prefers-reduced-motion:reduce){ .taa-card{transition:none !important} }
{%- endstyle -%}

<div id="{{ section.settings.section_id }}" class="section-{{ section.id }}-padding scale-desktop-{{ section.settings.scale_type_desktop }} scale-mobile-{{ section.settings.scale_type_mobile }}">
  <div class="taa-container">

    <div class="taa-header-group">
      {% if section.settings.show_badge %}
        <div class="taa-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          {{ section.settings.badge_text | default: 'Avis vérifiés' }}
        </div>
      {% endif %}
      {% if section.settings.subheading != blank %}<div class="taa-subheading">{{ section.settings.subheading }}</div>{% endif %}
      {% if section.settings.title != blank %}<h2 class="taa-title">{{ section.settings.title }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="taa-description">{{ section.settings.description }}</div>{% endif %}

      {% if section.settings.show_trust_badges %}
        <div class="taa-trust-badges">
          {% if section.settings.trust_1 != blank %}
            <div class="taa-trust-badge">
              <svg class="taa-trust-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              <span>{{ section.settings.trust_1 }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_2 != blank %}
            <div class="taa-trust-badge">
              <svg class="taa-trust-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <span>{{ section.settings.trust_2 }}</span>
            </div>
          {% endif %}
          {% if section.settings.trust_3 != blank %}
            <div class="taa-trust-badge">
              <svg class="taa-trust-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              <span>{{ section.settings.trust_3 }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div style="position:relative;">
      {% if section.settings.show_navigation %}
        <button class="taa-nav-btn prev" aria-label="Témoignage précédent">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="taa-nav-btn next" aria-label="Témoignage suivant">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      {% endif %}

      <div class="taa-slider-wrapper" id="Slider-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign rating_value = block.settings.rating %}
          {% assign rating_floor = rating_value | floor %}
          {% assign rating_next = rating_floor | plus: 1 %}
          {% assign rating_decimal = rating_value | minus: rating_floor | times: 100 | round %}

          <div class="taa-card {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">

            <div class="taa-images {% if block.settings.use_single_image %}single-mode{% endif %}" data-before-after>
              {% if block.settings.use_single_image %}
                <div class="taa-image-box">
                  {% if block.settings.image_combined != blank %}
                    <img src="{{ block.settings.image_combined | image_url: width: 800 }}" class="taa-image" loading="lazy" alt="Avant / après — {{ block.settings.author_name | escape }}">
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </div>
              {% else %}
                {% if block.settings.image_before != blank %}
                  <img src="{{ block.settings.image_before | image_url: width: 600 }}" class="taa-image before" loading="lazy" alt="Avant — {{ block.settings.author_name | escape }}">
                {% else %}
                  <div class="taa-image before taa-image-box">{{ 'image' | placeholder_svg_tag }}</div>
                {% endif %}
                {% if block.settings.image_after != blank %}
                  <img src="{{ block.settings.image_after | image_url: width: 600 }}" class="taa-image after" loading="lazy" alt="Après — {{ block.settings.author_name | escape }}">
                {% else %}
                  <div class="taa-image after taa-image-box">{{ 'image' | placeholder_svg_tag }}</div>
                {% endif %}
                <div class="taa-ba-slider"></div>
                <span class="taa-label before">{{ block.settings.time_before | default: 'Jour 0' }}</span>
                <span class="taa-label after">{{ block.settings.time_after | default: 'Semaine 8' }}</span>
              {% endif %}
            </div>

            <div class="taa-content">
              <div class="taa-content-top">
                <div class="taa-author-row">
                  <div class="taa-author-info">
                    <span class="taa-author">{{ block.settings.author_name | default: 'Cliente' }}</span>
                    {% if block.settings.verified %}
                      <span class="taa-verified-badge">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                        Vérifié
                      </span>
                    {% endif %}
                    {% if block.settings.author_age != blank %}<span class="taa-author-age">• {{ block.settings.author_age }}</span>{% endif %}
                  </div>
                  <div class="taa-stars-wrapper">
                    <div class="taa-stars">
                      {% for i in (1..5) %}
                        {% if i <= rating_floor %}{% assign fill_percent = 100 %}
                        {% elsif i == rating_next %}{% assign fill_percent = rating_decimal %}
                        {% else %}{% assign fill_percent = 0 %}{% endif %}
                        <div class="taa-star-box">
                          <div class="taa-star-fill" style="width: {{ fill_percent }}%;"></div>
                          <svg class="taa-star-icon" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>

                {% if block.settings.review_title != blank %}<h3 class="taa-review-title">{{ block.settings.review_title }}</h3>{% endif %}
                {% if block.settings.review_text != blank %}<p class="taa-review-text">{{ block.settings.review_text }}</p>{% endif %}

                {% if block.settings.results_text != blank %}
                  <div class="taa-results-tag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
                    {{ block.settings.results_text }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.product != blank %}
                {% assign bp = block.settings.product %}
                <div class="taa-product">
                  <div class="taa-product-left">
                    {% if bp.featured_image %}<img src="{{ bp.featured_image | image_url: width: 100 }}" class="taa-product-img" alt="{{ bp.title | escape }}" loading="lazy">{% endif %}
                    <div class="taa-product-info">
                      <span class="taa-product-title">{{ bp.title }}</span>
                      <span class="taa-product-subtitle">{{ bp.price | money }}</span>
                    </div>
                  </div>
                  <a href="{{ bp.url }}" class="taa-cart-btn" aria-label="Voir {{ bp.title | escape }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg>
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.settings.show_pagination %}
      <div class="taa-pagination">
        {% for block in section.blocks %}
          <div class="taa-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}" role="button" tabindex="0" aria-label="Témoignage {{ forloop.index }}"></div>
        {% endfor %}
      </div>
    {% endif %}

    <div class="taa-swipe-hint">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      Glisse pour voir plus
    </div>

    {% if section.settings.disclaimer != blank %}
      <p class="taa-disclaimer">{{ section.settings.disclaimer }}</p>
    {% endif %}

    {% if section.settings.show_stats %}
      <div class="taa-stats-bar">
        <div class="taa-stat">
          <div class="taa-stat-number">{{ section.settings.stat_1_number }}</div>
          <div class="taa-stat-label">{{ section.settings.stat_1_label }}</div>
        </div>
        <div class="taa-stat">
          <div class="taa-stat-number">{{ section.settings.stat_2_number }}</div>
          <div class="taa-stat-label">{{ section.settings.stat_2_label }}</div>
        </div>
        <div class="taa-stat">
          <div class="taa-stat-number">{{ section.settings.stat_3_number }}</div>
          <div class="taa-stat-label">{{ section.settings.stat_3_label }}</div>
        </div>
      </div>
    {% endif %}

    {% if section.settings.enable_review_submission and section.settings.review_btn_url != blank %}
      <div style="text-align: center;">
        <a class="taa-write-review-btn" href="{{ section.settings.review_btn_url }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          {{ section.settings.review_btn_text | default: 'Écrire un avis' }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var slider = document.getElementById('Slider-{{ section.id }}');
  if (!slider) return;

  var cards = slider.querySelectorAll('.taa-card');
  var sectionEl = slider.closest('.section-{{ section.id }}-padding');
  var dots = sectionEl ? sectionEl.querySelectorAll('.taa-dot') : [];
  var prevBtn = slider.parentElement.querySelector('.prev');
  var nextBtn = slider.parentElement.querySelector('.next');
  var enableActiveCard = {{ section.settings.enable_active_card | json }};
  var isScrolling = false;
  var lastActiveIndex = 0;

  function centerOn(card) {
    slider.scrollTo({ left: card.offsetLeft + card.offsetWidth / 2 - slider.offsetWidth / 2, behavior: 'smooth' });
  }
  function activeIndex() {
    return Array.prototype.findIndex.call(cards, function (c) { return c.classList.contains('active'); });
  }
  function go(delta) {
    var i = activeIndex();
    var target = i + delta;
    if (target < 0) target = cards.length - 1;
    if (target > cards.length - 1) target = 0;
    centerOn(cards[target]);
  }

  cards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.closest('.taa-images[data-before-after]:not(.single-mode)')) return;
      if (e.target.closest('a')) return;
      centerOn(card);
    });
  });

  function updateActive() {
    var center = slider.scrollLeft + slider.offsetWidth / 2;
    var closest = null, minDist = Infinity, idx = 0;
    cards.forEach(function(card, i) {
      var dist = Math.abs(card.offsetLeft + card.offsetWidth / 2 - center);
      if (dist < minDist) { minDist = dist; closest = card; idx = i; }
    });
    if (idx === lastActiveIndex && slider.querySelector('.taa-card.active')) return;
    lastActiveIndex = idx;
    if (enableActiveCard) {
      cards.forEach(function(c) { c.classList.remove('active', 'adjacent', 'adjacent-left', 'adjacent-right'); });
      if (closest) closest.classList.add('active');
      if (idx > 0) cards[idx - 1].classList.add('adjacent', 'adjacent-left');
      if (idx < cards.length - 1) cards[idx + 1].classList.add('adjacent', 'adjacent-right');
    }
    dots.forEach(function(d) { d.classList.remove('active'); });
    if (dots[idx]) dots[idx].classList.add('active');
  }

  slider.addEventListener('scroll', function() {
    if (!isScrolling) {
      window.requestAnimationFrame(function() { updateActive(); isScrolling = false; });
      isScrolling = true;
    }
  }, { passive: true });
  updateActive();

  if (prevBtn) prevBtn.addEventListener('click', function() { go(-1); });
  if (nextBtn) nextBtn.addEventListener('click', function() { go(1); });
  dots.forEach(function(dot, i) {
    dot.addEventListener('click', function() { centerOn(cards[i]); });
    dot.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); centerOn(cards[i]); } });
  });

  /* ---------- avant/après instantané ---------- */
  var baContainers = (sectionEl || document).querySelectorAll('.taa-images[data-before-after]:not(.single-mode)');
  baContainers.forEach(function(container) {
    var handle = container.querySelector('.taa-ba-slider');
    var afterImage = container.querySelector('.taa-image.after');
    var dragging = false;
    if (!handle || !afterImage) return;
    function setPos(x) {
      var rect = container.getBoundingClientRect();
      var percent = Math.max(0, Math.min(100, ((x - rect.left) / rect.width) * 100));
      handle.style.left = percent + '%';
      afterImage.style.clipPath = 'inset(0 ' + (100 - percent) + '% 0 0)';
    }
    container.addEventListener('mousedown', function(e) { dragging = true; setPos(e.clientX); e.preventDefault(); e.stopPropagation(); });
    document.addEventListener('mousemove', function(e) { if (dragging) setPos(e.clientX); });
    document.addEventListener('mouseup', function() { dragging = false; });
    container.addEventListener('touchstart', function(e) { dragging = true; setPos(e.touches[0].clientX); e.stopPropagation(); }, { passive: true });
    container.addEventListener('touchmove', function(e) { if (dragging) { setPos(e.touches[0].clientX); e.preventDefault(); } }, { passive: false });
    container.addEventListener('touchend', function() { dragging = false; });
  });

  /* ---------- autoplay (pause au survol / onglet caché) ---------- */
  var autoplayEnabled = {{ section.settings.enable_autoplay | json }};
  if (autoplayEnabled && cards.length > 1) {
    var paused = false;
    slider.addEventListener('mouseenter', function() { paused = true; });
    slider.addEventListener('mouseleave', function() { paused = false; });
    slider.addEventListener('touchstart', function() { paused = true; }, { passive: true });
    slider.addEventListener('touchend', function() { setTimeout(function() { paused = false; }, 4000); }, { passive: true });
    setInterval(function() {
      if (paused || document.hidden) return;
      go(1);
    }, {{ section.settings.autoplay_delay | default: 5 | times: 1000 }});
  }
});
</script>

{% schema %}
{
  "name": "MRT · Témoignages 3D B/A",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "section_id", "label": "ID de section (ancre)" },
    { "type": "header", "content": "En-tête" },
    { "type": "checkbox", "id": "show_badge", "label": "Afficher le badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Texte du badge", "default": "Avis vérifiés" },
    { "type": "text", "id": "subheading", "label": "Sous-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Elles ont <em>tenu la routine</em>", "info": "Utilise <em>…</em> pour la couleur accent en italique." },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "select", "id": "alignment", "label": "Alignement", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "header", "content": "Badges de confiance" },
    { "type": "checkbox", "id": "show_trust_badges", "label": "Afficher les badges", "default": true },
    { "type": "text", "id": "trust_1", "label": "Badge 1", "default": "Avis vérifiés" },
    { "type": "text", "id": "trust_2", "label": "Badge 2", "default": "Essai 60 nuits" },
    { "type": "text", "id": "trust_3", "label": "Badge 3", "default": "Expédié du Québec" },
    { "type": "header", "content": "Animations" },
    { "type": "select", "id": "scale_type_desktop", "label": "Animation desktop", "options": [
      { "value": "smooth", "label": "1. Smooth Elegant" }, { "value": "bounce", "label": "2. Bounce Pop" },
      { "value": "elastic", "label": "3. Elastic Stretch" }, { "value": "slow", "label": "4. Slow Motion" },
      { "value": "snap", "label": "5. Snap Quick" }, { "value": "fade", "label": "6. Fade Focus" },
      { "value": "mega", "label": "7. Mega Zoom" }
    ], "default": "fade" },
    { "type": "select", "id": "scale_type_mobile", "label": "Animation mobile", "options": [
      { "value": "smooth", "label": "1. Smooth Elegant" }, { "value": "bounce", "label": "2. Bounce Pop" },
      { "value": "elastic", "label": "3. Elastic Stretch" }, { "value": "slow", "label": "4. Slow Motion" },
      { "value": "snap", "label": "5. Snap Quick" }, { "value": "fade", "label": "6. Fade Focus" },
      { "value": "mega", "label": "7. Mega Zoom" }
    ], "default": "smooth" },
    { "type": "header", "content": "Taille des cartes — desktop" },
    { "type": "range", "id": "card_width_desktop", "min": 0, "max": 900, "step": 10, "unit": "px", "label": "Largeur", "default": 650 },
    { "type": "range", "id": "card_height_desktop", "min": 0, "max": 550, "step": 10, "unit": "px", "label": "Hauteur", "default": 400 },
    { "type": "header", "content": "Taille des cartes — mobile" },
    { "type": "range", "id": "card_width_mobile", "min": 0, "max": 380, "step": 5, "unit": "px", "label": "Largeur", "default": 300 },
    { "type": "range", "id": "card_height_mobile", "min": 0, "max": 650, "step": 10, "unit": "px", "label": "Hauteur", "default": 520 },
    { "type": "header", "content": "Produit associé" },
    { "type": "range", "id": "product_padding", "min": 0, "max": 20, "step": 2, "unit": "px", "label": "Espacement", "default": 12 },
    { "type": "range", "id": "product_img_size", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Taille image", "default": 44 },
    { "type": "range", "id": "product_title_size", "min": 0, "max": 14, "step": 1, "unit": "px", "label": "Taille titre", "default": 12 },
