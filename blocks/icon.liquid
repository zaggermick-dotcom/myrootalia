{%- liquid
  assign icon = block.settings.icon | default: 'none'
  assign icon_custom = block.settings.icon_custom
  assign size = block.settings.size | default: 40
  assign alignment = block.settings.alignment | default: 'left'
  assign width = block.settings.width | default: 'fill'

  case alignment
    when 'center'
      assign justify = 'center'
    when 'right'
      assign justify = 'flex-end'
    else
      assign justify = 'flex-start'
  endcase
-%}

{%- style -%}
  .custom-icon--{{ block.id }} {
    {%- if width == 'fit' %}
      flex: 0 0 auto;
    {%- else %}
      flex: var(--group-child-flex, 1 1 0%);
    {%- endif %}
    min-width: 0;
    display: flex;
    justify-content: {{ justify }};
  }

  .custom-icon--{{ block.id }} .custom-icon__inner {
    display: inline-flex;
    line-height: 0;
    {%- if block.settings.color != blank and block.settings.color.alpha != 0.0 %}
      color: {{ block.settings.color }};
    {%- endif %}
  }

  /* Les SVG de snippets/icons.liquid n'ont pas de fill : sans ça ils restent noirs. */
  .custom-icon--{{ block.id }} .custom-icon__inner svg {
    fill: currentColor;
    width: {{ size }}px;
    height: {{ size }}px;
  }

  .custom-icon--{{ block.id }} .custom-icon__image {
    width: {{ size }}px;
    height: auto;
  }

  {%- if block.settings.mobile_hidden %}
    @media screen and (max-width: 749px) {
      .custom-icon--{{ block.id }} {
        display: none;
      }
    }
  {%- endif %}
{%- endstyle -%}

{%- if icon_custom != blank or icon != 'none' -%}
  <div
    class="custom-icon custom-icon--{{ block.id }}"
    {% render 'animation', enable_animations: block.settings.enable_animations, animation: block.settings.animation %}
    {{ block.shopify_attributes }}
  >
    {%- capture icon_markup -%}
      {%- if icon_custom != blank -%}
        {{
          icon_custom
          | image_url: width: 240
          | image_tag: loading: 'lazy', class: 'custom-icon__image', widths: '80, 160, 240'
        }}
      {%- else -%}
        {%- render 'icons', icon: icon, width: size -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}" class="custom-icon__inner">{{ icon_markup }}</a>
    {%- else -%}
      <span class="custom-icon__inner">{{ icon_markup }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

