{% comment %}
  MRT · UGC autoplay — mur de vidéos clients façon TikTok
  - Vignettes vidéo verticales qui se lancent toutes seules (muettes) à l'écran
  - Défilement automatique continu optionnel (marquee) ou slider manuel
  - Clic → popup avec le son + produit associé cliquable (conversion)
{% endcomment %}

{%- liquid
  assign st = section.settings
  assign ugc_blocks = section.blocks | where: 'type', 'ugc'
-%}

{%- style -%}
  #mrt-ugc-{{ section.id }}{
    --mrtU-bg: {{ st.color_bg }};
    --mrtU-ink: {{ st.color_text }};
    --mrtU-accent: {{ st.color_accent }};
    --mrtU-serif: var(--font-heading-family, Georgia, serif);
    --mrtU-sans: var(--font-body-family, -apple-system, sans-serif);
    background: var(--mrtU-bg); color: var(--mrtU-ink);
    font-family: var(--mrtU-sans); overflow: hidden;
    padding-top: {{ st.padding_top_sm }}px; padding-bottom: {{ st.padding_bottom_sm }}px;
  }
  @media(min-width:750px){
    #mrt-ugc-{{ section.id }}{padding-top: {{ st.padding_top }}px; padding-bottom: {{ st.padding_bottom }}px;}
  }
  #mrt-ugc-{{ section.id }} .mrtU-wrap{max-width:{% if st.layout_width == 'full' %}100%{% else %}1180px{% endif %};margin:0 auto;padding:0 20px}
  #mrt-ugc-{{ section.id }} .mrtU-head{text-align:{{ st.alignment }};margin-bottom:32px}
  #mrt-ugc-{{ section.id }} .mrtU-kicker{display:block;font-size:12px;letter-spacing:.22em;
    text-transform:uppercase;color:var(--mrtU-accent);font-weight:600;margin-bottom:12px}
  #mrt-ugc-{{ section.id }} .mrtU-h2{font-family:var(--mrtU-serif);font-weight:500;
    font-size:clamp(26px,4vw,38px);line-height:1.2;margin:0 0 10px}
  #mrt-ugc-{{ section.id }} .mrtU-h2 p{margin:0}
  #mrt-ugc-{{ section.id }} .mrtU-desc{color:color-mix(in srgb, var(--mrtU-ink) 65%, var(--mrtU-bg));max-width:560px;
    {% if st.alignment == 'center' %}margin:0 auto;{% endif %}}
  #mrt-ugc-{{ section.id }} .mrtU-desc p{margin:0}

  #mrt-ugc-{{ section.id }} .mrtU-slider{position:relative}
  {%- if st.marquee -%}
  #mrt-ugc-{{ section.id }} .mrtU-viewport{overflow:hidden}
  #mrt-ugc-{{ section.id }} .mrtU-track{display:flex;gap:{{ st.gap }}px;width:max-content;
    animation:mrtUmarq {{ st.marquee_speed }}s linear infinite}
  #mrt-ugc-{{ section.id }} .mrtU-track:hover{animation-play-state:paused}
  @keyframes mrtUmarq{to{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){#mrt-ugc-{{ section.id }} .mrtU-track{animation:none;width:auto}
    #mrt-ugc-{{ section.id }} .mrtU-viewport{overflow-x:auto}}
  {%- else -%}
  /* la piste porte le centrage : margin auto centre tant qu'il reste de la place */
  #mrt-ugc-{{ section.id }} .mrtU-viewport{display:flex;overflow-x:auto;
    scroll-snap-type:x proximity;scrollbar-width:none;padding-bottom:8px}
  #mrt-ugc-{{ section.id }} .mrtU-viewport::-webkit-scrollbar{display:none}
  #mrt-ugc-{{ section.id }} .mrtU-track{display:flex;gap:{{ st.gap }}px;padding-inline:2px;
    margin-inline:{% if st.cards_alignment == 'center' %}auto{% elsif st.cards_alignment == 'right' %}auto 0{% else %}0 auto{% endif %}}
  @media(max-width:1024px){#mrt-ugc-{{ section.id }} .mrtU-track{gap:{{ st.gap_tablet }}px;
    margin-inline:{% if st.cards_alignment_tablet == 'center' %}auto{% elsif st.cards_alignment_tablet == 'right' %}auto 0{% else %}0 auto{% endif %}}}
  @media(max-width:749px){#mrt-ugc-{{ section.id }} .mrtU-track{gap:{{ st.gap_mobile }}px;
    margin-inline:{% if st.cards_alignment_mobile == 'center' %}auto{% elsif st.cards_alignment_mobile == 'right' %}auto 0{% else %}0 auto{% endif %}}}
  {%- endif -%}
  #mrt-ugc-{{ section.id }} .mrtU-card{flex:0 0 {{ st.card_width }}px;scroll-snap-align:start}
  @media(max-width:1024px){#mrt-ugc-{{ section.id }} .mrtU-card{flex-basis:{{ st.card_width_tablet }}px}}
  @media(max-width:749px){#mrt-ugc-{{ section.id }} .mrtU-card{flex-basis:{{ st.card_width_mobile }}px}}
  {%- if st.grid_mobile -%}
  @media(max-width:749px){
    #mrt-ugc-{{ section.id }} .mrtU-viewport{overflow:visible;display:block}
    #mrt-ugc-{{ section.id }} .mrtU-track{display:grid;
      grid-template-columns:repeat({{ st.columns_mobile }},minmax(0,1fr));width:100%;margin-inline:0;animation:none}
    #mrt-ugc-{{ section.id }} .mrtU-card{flex:none;width:100%}}
  {%- endif -%}
  #mrt-ugc-{{ section.id }} .mrtU-media{position:relative;aspect-ratio:{{ st.ratio }};border-radius:16px;overflow:hidden;
    background:#101a15;cursor:pointer;width:100%;display:block;border:0;padding:0;
    box-shadow:0 18px 40px -24px rgba(21,42,33,.45);transition:transform .3s ease}
  #mrt-ugc-{{ section.id }} .mrtU-media:hover{transform:translateY(-4px)}
  #mrt-ugc-{{ section.id }} .mrtU-media video,
  #mrt-ugc-{{ section.id }} .mrtU-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  #mrt-ugc-{{ section.id }} .mrtU-sound{position:absolute;right:10px;top:10px;width:34px;height:34px;border-radius:50%;
    background:rgba(0,0,0,.45);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:13px;pointer-events:none}
  #mrt-ugc-{{ section.id }} .mrtU-handle{position:absolute;left:10px;bottom:10px;max-width:calc(100% - 20px);
    background:rgba(0,0,0,.5);backdrop-filter:blur(6px);color:#fff;font-size:12.5px;font-weight:600;
    padding:6px 12px;border-radius:999px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #mrt-ugc-{{ section.id }} .mrtU-product{display:flex;align-items:center;gap:10px;margin-top:10px;
    background:color-mix(in srgb, var(--mrtU-ink) 6%, var(--mrtU-bg));border-radius:12px;padding:8px 10px;
    text-decoration:none;color:var(--mrtU-ink);transition:transform .25s ease, box-shadow .25s ease}
  #mrt-ugc-{{ section.id }} .mrtU-product:hover{transform:translateY(-2px);box-shadow:0 10px 24px -14px rgba(21,42,33,.4)}
  #mrt-ugc-{{ section.id }} .mrtU-product img{width:38px;height:38px;border-radius:8px;object-fit:cover}
  #mrt-ugc-{{ section.id }} .mrtU-product b{display:block;font-size:12.5px;line-height:1.3;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #mrt-ugc-{{ section.id }} .mrtU-product span{font-size:12px;color:color-mix(in srgb, var(--mrtU-ink) 60%, var(--mrtU-bg))}
  #mrt-ugc-{{ section.id }} .mrtU-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:44px;height:44px;
    border-radius:50%;border:0;cursor:pointer;background:var(--mrtU-ink);color:var(--mrtU-bg);font-size:17px;
    display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px -10px rgba(21,42,33,.5);transition:.2s}
  #mrt-ugc-{{ section.id }} .mrtU-arrow:hover{transform:translateY(-50%) scale(1.1)}
  #mrt-ugc-{{ section.id }} .mrtU-arrow.prev{left:-6px}
  #mrt-ugc-{{ section.id }} .mrtU-arrow.next{right:-6px}
  @media(max-width:749px){#mrt-ugc-{{ section.id }} .mrtU-arrow{display:none}}

  /* popup son */
  #mrtU-popup-{{ section.id }}{position:fixed;inset:0;z-index:999;background:rgba(10,14,12,.96);
    display:none;align-items:center;justify-content:center}
  #mrtU-popup-{{ section.id }}.is-open{display:flex}
  #mrtU-popup-{{ section.id }} .mrtU-pop-stage{position:relative;height:min(90vh,860px);aspect-ratio:{{ st.ratio }};
    max-width:94vw;border-radius:20px;overflow:hidden;background:#000}
  #mrtU-popup-{{ section.id }} .mrtU-pop-stage video,
  #mrtU-popup-{{ section.id }} .mrtU-pop-stage iframe{width:100%;height:100%;object-fit:contain;border:0;background:#000}
  #mrtU-popup-{{ section.id }} .mrtU-pop-close{position:absolute;top:14px;right:14px;z-index:5;width:38px;height:38px;
    border-radius:50%;border:0;cursor:pointer;background:rgba(0,0,0,.5);backdrop-filter:blur(6px);color:#fff;font-size:16px}
  #mrtU-popup-{{ section.id }} .mrtU-pop-product{position:absolute;left:14px;right:60px;bottom:14px;z-index:5;
    display:flex;align-items:center;gap:10px;background:rgba(245,241,234,.94);backdrop-filter:blur(8px);
    border-radius:14px;padding:10px 12px;text-decoration:none;color:#2B2B2B}
  #mrtU-popup-{{ section.id }} .mrtU-pop-product img{width:42px;height:42px;border-radius:8px;object-fit:cover}
  #mrtU-popup-{{ section.id }} .mrtU-pop-product b{display:block;font-size:13px}
  #mrtU-popup-{{ section.id }} .mrtU-pop-product span{font-size:12.5px;opacity:.7}
{%- endstyle -%}

<section id="mrt-ugc-{{ section.id }}">
  <div class="mrtU-wrap">
    <div class="mrtU-head">
      {%- if st.subheading != blank -%}<span class="mrtU-kicker">{{ st.subheading | escape }}</span>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="mrtU-h2">{{ st.heading }}</h2>{%- endif -%}
      {%- if st.description != blank -%}<div class="mrtU-desc">{{ st.description }}</div>{%- endif -%}
    </div>

    <div class="mrtU-slider">
      {%- unless st.marquee -%}
        <button type="button" class="mrtU-arrow prev" data-mrtu-prev aria-label="Précédent">←</button>
        <button type="button" class="mrtU-arrow next" data-mrtu-next aria-label="Suivant">→</button>
      {%- endunless -%}
      <div class="mrtU-viewport" data-mrtu-track>
      <div class="mrtU-track">
        {%- assign loops = 1 -%}
        {%- if st.marquee -%}{%- assign loops = 2 -%}{%- endif -%}
        {%- for i in (1..loops) -%}
          {%- for block in ugc_blocks -%}
            <div class="mrtU-card" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
              <button type="button" class="mrtU-media"
                data-mrtu-open
                {%- if block.settings.video != blank %} data-kind="file"
                {%- elsif block.settings.video_url != blank %} data-kind="{{ block.settings.video_url.type }}" data-vid="{{ block.settings.video_url.id }}"{% endif %}
                {%- if block.settings.product != blank %} data-purl="{{ block.settings.product.url }}" data-ptitle="{{ block.settings.product.title | escape }}" data-pprice="{{ block.settings.product.price | money | escape }}" data-pimg="{{ block.settings.product.featured_image | image_url: width: 100 }}"{% endif %}
                aria-label="Voir la vidéo {{ block.settings.handle | escape }}">
                {%- if block.settings.video != blank -%}
                  {%- if st.inline_autoplay -%}
                    {{ block.settings.video | video_tag: class: 'mrtU-inline', image_size: '600x', autoplay: false, loop: true, controls: false, muted: true, preload: 'metadata' }}
                  {%- elsif block.settings.video.preview_image -%}
                    {{ block.settings.video.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.handle }}
                  {%- endif -%}
                  <template data-mrtu-src>{{ block.settings.video | video_tag: image_size: '1100x', autoplay: true, loop: true, controls: true, muted: false, playsinline: true }}</template>
                {%- elsif block.settings.cover != blank -%}
                  {{ block.settings.cover | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.handle }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag }}
                {%- endif -%}
                <span class="mrtU-sound" aria-hidden="true">🔇</span>
                {%- if block.settings.handle != blank -%}<span class="mrtU-handle">{{ block.settings.handle | escape }}</span>{%- endif -%}
              </button>
              {%- if st.show_product and block.settings.product != blank -%}
                {%- assign p = block.settings.product -%}
                <a class="mrtU-product" href="{{ p.url }}">
                  {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 100 }}" alt="" width="38" height="38" loading="lazy">{%- endif -%}
                  <span style="min-width:0"><b>{{ p.title | escape }}</b><span>{{ p.price | money }}</span></span>
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
  </div>
</section>

<div id="mrtU-popup-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Vidéo">
  <div class="mrtU-pop-stage">
    <button type="button" class="mrtU-pop-close" data-mrtu-close aria-label="Fermer">✕</button>
    <div data-mrtu-stage></div>
    <a class="mrtU-pop-product" data-mrtu-pop-product hidden href="#">
      <img data-mrtu-pop-img src="" alt="" width="42" height="42">
      <span style="min-width:0"><b data-mrtu-pop-title></b><span data-mrtu-pop-price></span></span>
    </a>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('mrt-ugc-{{ section.id }}');
  var popup = document.getElementById('mrtU-popup-{{ section.id }}');
  if (!root || !popup) return;

  {%- if st.inline_autoplay -%}
  var vids = root.querySelectorAll('video.mrtU-inline');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var v = en.target;
        if (en.isIntersecting) { v.muted = true; var p = v.play(); if (p) p.catch(function () {}); }
        else v.pause();
      });
    }, { threshold: 0.35 });
    vids.forEach(function (v) { io.observe(v); });
  }
  {%- endif -%}

  var track = root.querySelector('[data-mrtu-track]');
  var prev = root.querySelector('[data-mrtu-prev]');
  var next = root.querySelector('[data-mrtu-next]');
  var step = {{ st.card_width | plus: st.gap }};
  if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step, behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { track.scrollBy({ left: step, behavior: 'smooth' }); });

  var stage = popup.querySelector('[data-mrtu-stage]');
  var popProduct = popup.querySelector('[data-mrtu-pop-product]');
  function close() {
    stage.innerHTML = '';
    popup.classList.remove('is-open');
    document.documentElement.style.overflow = '';
  }
  root.querySelectorAll('[data-mrtu-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var kind = btn.dataset.kind;
      if (!kind) return;
      stage.innerHTML = '';
      if (kind === 'file') {
        var tpl = btn.querySelector('template[data-mrtu-src]');
        if (tpl) stage.innerHTML = tpl.innerHTML;
        var v = stage.querySelector('video');
        if (v) { v.muted = false; var p = v.play(); if (p) p.catch(function () {}); }
      } else {
        var vid = btn.dataset.vid;
        var f = document.createElement('iframe');
        f.src = kind === 'youtube'
          ? 'https://www.youtube.com/embed/' + vid + '?autoplay=1&playsinline=1&rel=0'
          : 'https://player.vimeo.com/video/' + vid + '?autoplay=1';
        f.allow = 'autoplay; encrypted-media'; f.allowFullscreen = true;
        stage.appendChild(f);
      }
      if (btn.dataset.purl) {
        popProduct.hidden = false;
        popProduct.href = btn.dataset.purl;
        popup.querySelector('[data-mrtu-pop-title]').textContent = btn.dataset.ptitle || '';
        popup.querySelector('[data-mrtu-pop-price]').textContent = btn.dataset.pprice || '';
        popup.querySelector('[data-mrtu-pop-img]').src = btn.dataset.pimg || '';
      } else {
        popProduct.hidden = true;
      }
      popup.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
    });
  });
  popup.querySelector('[data-mrtu-close]').addEventListener('click', close);
  popup.addEventListener('click', function (e) { if (e.target === popup) close(); });
  document.addEventListener('keydown', function (e) {
    if (popup.classList.contains('is-open') && e.key === 'Escape') close();
  });
})();
</script>

{% schema %}
{
  "name": "MRT · UGC autoplay",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "En-tête" },
    { "type": "text", "id": "subheading", "label": "Sur-titre", "default": "Ils en parlent" },
    { "type": "richtext", "id": "heading", "label": "Titre", "default": "<p>La routine, filmée par vous</p>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>De vraies vidéos, de vraies salles de bain. Touche une vidéo pour le son.</p>" },
    { "type": "select", "id": "alignment", "label": "Alignement", "options": [
      { "value": "left", "label": "Gauche" },
      { "value": "center", "label": "Centre" },
      { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "header", "content": "Lecture automatique" },
    { "type": "checkbox", "id": "inline_autoplay", "label": "Lire les vidéos en muet dans les vignettes", "info": "Vidéos importées uniquement.", "default": true },
    { "type": "checkbox", "id": "marquee", "label": "Défilement automatique continu", "info": "Le mur défile tout seul, pause au survol. Sinon : slider manuel avec flèches.", "default": false },
    { "type": "range", "id": "marquee_speed", "min": 10, "max": 90, "step": 5, "unit": "s", "label": "Durée d'un tour (défilement continu)", "default": 40 },
    { "type": "header", "content": "Cartes" },
    { "type": "select", "id": "ratio", "label": "Format vidéo", "options": [
      { "value": "9/16", "label": "Vertical (9:16)" },
      { "value": "1/1", "label": "Carré (1:1)" },
      { "value": "16/9", "label": "Horizontal (16:9)" }
    ], "default": "9/16" },
    { "type": "checkbox", "id": "show_product", "label": "Afficher le produit associé sous la vidéo", "default": true },
    { "type": "header", "content": "Cartes — ordinateur" },
    { "type": "select", "id": "cards_alignment", "label": "Alignement des cartes", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "range", "id": "card_width", "min": 0, "max": 380, "step": 10, "unit": "px", "label": "Largeur des cartes", "default": 250 },
    { "type": "range", "id": "gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Espace entre les cartes", "default": 16 },
    { "type": "header", "content": "Cartes — tablette" },
    { "type": "select", "id": "cards_alignment_tablet", "label": "Alignement des cartes", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "range", "id": "card_width_tablet", "min": 0, "max": 340, "step": 10, "unit": "px", "label": "Largeur des cartes", "default": 210 },
    { "type": "range", "id": "gap_tablet", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Espace entre les cartes", "default": 14 },
    { "type": "header", "content": "Cartes — mobile" },
    { "type": "select", "id": "cards_alignment_mobile", "label": "Alignement des cartes", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Droite" }
    ], "default": "center" },
    { "type": "range", "id": "card_width_mobile", "min": 0, "max": 300, "step": 10, "unit": "px", "label": "Largeur des cartes", "default": 170 },
    { "type": "range", "id": "gap_mobile", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Espace entre les cartes", "default": 12 },
    { "type": "checkbox", "id": "grid_mobile", "label": "Tout afficher en grille sur mobile", "info": "Sans défilement horizontal. Incompatible avec le défilement automatique.", "default": false },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "unit": "col", "label": "Colonnes en grille (mobile)", "default": 2 },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#F1EAE0" },
    { "type": "color", "id": "color_text", "label": "Texte", "default": "#2B2B2B" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#B07A3B" },
    { "type": "header", "content": "Mise en page" },
    { "type": "select", "id": "layout_width", "label": "Largeur", "options": [
      { "value": "normal", "label": "Page" },
      { "value": "full", "label": "Pleine largeur" }
    ], "default": "full" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Haut (desktop)", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bas (desktop)", "default": 56 },
    { "type": "range", "id": "padding_top_sm", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Haut (mobile)", "default": 28 },
    { "type": "range", "id": "padding_bottom_sm", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bas (mobile)", "default": 28 }
  ],
  "blocks": [
    {
      "type": "ugc",
      "name": "Vidéo UGC",
      "settings": [
        { "type": "video", "id": "video", "label": "Vidéo (importée — recommandé)" },
        { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "Ou vidéo YouTube / Vimeo" },
        { "type": "image_picker", "id": "cover", "label": "Image de couverture (YouTube/Vimeo)" },
        { "type": "text", "id": "handle", "label": "Pseudo / légende", "default": "@cliente" },
        { "type": "product", "id": "product", "label": "Produit associé" }
      ]
