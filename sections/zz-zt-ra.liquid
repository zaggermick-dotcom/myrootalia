<div>x</div>
{% schema %}
{
  "name": "zt ra",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "default": "La routine"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre",
      "default": "<p>Deux minutes, <em>chaque soir</em></p>",
      "info": "Utilise <em>…</em> pour mettre un mot en italique doré."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Un geste simple qui devient un réflexe. Pas de promesse magique — juste de la constance."
    },
    {
      "type": "text",
      "id": "chip_text",
      "label": "Pastille (chrono)",
      "default": "2 minutes par jour, montre en main"
    },
    {
      "type": "select",
      "id": "chip_icon",
      "label": "Icône de la pastille",
      "options": [
        {
          "value": "chrono",
          "label": "Chronomètre"
        },
        {
          "value": "horloge",
          "label": "Horloge"
        },
        {
          "value": "sablier",
          "label": "Sablier"
        },
        {
          "value": "lune",
          "label": "Lune"
        },
        {
          "value": "etincelle",
          "label": "Étincelle"
        },
        {
          "value": "coeur",
          "label": "Cœur"
        },
        {
          "value": "feuille",
          "label": "Feuille"
        },
        {
          "value": "aucune",
          "label": "Aucune"
        }
      ],
      "default": "chrono"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignement de l'en-tête",
      "options": [
        {
          "value": "left",
          "label": "Gauche"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Droite"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 26,
      "max": 54,
      "step": 2,
      "unit": "px",
      "label": "Taille du titre",
      "default": 38
    },
    {
      "type": "range",
      "id": "header_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espace sous l'en-tête",
      "default": 48
    },
    {
      "type": "header",
      "content": "Appel à l'action"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Petite phrase au-dessus",
      "default": "Essai 60 nuits — remboursé si tu n'aimes pas."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton",
      "default": "Commencer ma routine"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton",
      "info": "Laisse #acheter pour remonter au bloc d'achat de la page produit."
    },
    {
      "type": "range",
      "id": "cta_gap",
      "min": 20,
      "max": 90,
      "step": 4,
      "unit": "px",
      "label": "Espace au-dessus du bouton",
      "default": 48
    },
    {
      "type": "header",
      "content": "Grille"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "unit": "col",
      "label": "Colonnes (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Espacement (desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "grid_gap_sm",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Espacement (mobile)",
      "default": 34
    },
    {
      "type": "checkbox",
      "id": "show_connector",
      "label": "Ligne pointillée entre les étapes",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "Largeur",
      "options": [
        {
          "value": "narrow",
          "label": "Étroite"
        },
        {
          "value": "normal",
          "label": "Page"
        },
        {
          "value": "full",
          "label": "Large"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Cartes"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Arrondi",
      "default": 18
    }
  ]
}
{% endschema %}
