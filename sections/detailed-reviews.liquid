{{ 'detailed-reviews.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}

{% liquid
  for block in section.blocks
    if block.type == 'custom_typo'
      render 'block-custom-typo', block: block
    endif
  endfor

  assign sectionId = section.id | remove: '-'
  assign bgImage = section.settings.image_bg_colored
  assign bgImageMobile = section.settings.image_bg_colored_mobile

  if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank
    render 'cut-colored', section: section
  endif

  assign enable_animations = section.settings.enable_animations
  assign animation = section.settings.animation

  assign hide_desktop = section.settings.hide_desktop
  assign hide_mobile = section.settings.hide_mobile
%}

{%- render 'separator-top', section: section -%}

{%- capture attributes -%}
  id="{{ section.id }}"
  class="color-{{ section.settings.color_palette }} {% if hide_desktop %}hide-desktop{% endif %}
    {% if hide_mobile %}hide-mobile{% endif %} detailed-reviews section section-{{ section.id }}-padding{% if section.settings.enable_cut_bg_color or bgImage != blank or bgImageMobile != blank %} cut-colored-section{% endif %}"
  data-section-id="{{ section.id }}"
{%- endcapture -%}

<section
  {{ attributes }}
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-sm: {{ section.settings.padding_top_sm }}px;
    --padding-bottom-sm: {{ section.settings.padding_bottom_sm }}px;
  "
  id="{{section.id }}"
>
  {% if bgImage %}
    <img
      src="{{ bgImage | image_url: width: 3000 }}"
      class="bg-image-lg {% if bgImageMobile != blank %}hide-mobile{% endif %}"
      width="100%"
      height="auto"
    >
    <img src="{{ bgImageMobile | image_url: width: 1500 }}" class="bg-image-sm hide-desktop" width="100%" height="auto">
  {% endif %}
  <div
    class="
      section__inner
      {% case section.settings.layout_width %}
        {% when 'narrow' %}container container--narrow
        {% when 'normal' %}container container--normal
        {% when 'full-padded' %}container container--full-padded
        {% when 'full' %}contianer--full
      {% endcase %}
    "
  >
    {%- liquid
      for block in section.blocks
        if block.type == 'picto'
          render 'pictogram', block: block
        endif
      endfor
    -%}
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      {%- render 'heading',
        alignment: 'center',
        enable_animations: enable_animations,
        animation: animation,
        subheading: section.settings.subheading,
        heading: section.settings.heading,
        heading_class: 'collection__heading',
        heading_style: section.settings.heading_style
      -%}
    {%- endif -%}
 {% if section.settings.rating_info %}
  {%- assign rating_value = section.settings.rating | plus: 0 -%}
  {%- assign full_stars = rating_value | floor -%}
  {%- assign decimal_part = rating_value | minus: full_stars -%}
  {%- assign has_half_star = false -%}

  {%- if decimal_part >= 0.25 and decimal_part < 0.75 -%}
    {%- assign has_half_star = true -%}
  {%- endif -%}

  {%- assign half_star_position = full_stars | plus: 1 -%}

  <div
    class="reviews-summary"
    {% if section.settings.enable_animations %}
      data-aos="{{ section.settings.animation }}"
      data-aos-delay="150"
    {% endif %}
  >
    <div class="reviews-summary__rating-line">
      <span class="reviews-summary__rating-value">{{ section.settings.rating }} / 5</span>

      <div class="reviews-summary__stars" aria-label="Rating {{ section.settings.rating }} out of 5">
        {% for i in (1..5) %}
          {% if i <= full_stars %}
            <span class="reviews-summary__star filled">★</span>
          {% elsif has_half_star and i == half_star_position %}
            <span class="reviews-summary__star half">★</span>
          {% else %}
            <span class="reviews-summary__star">★</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="reviews-summary__count">
      {{ section.settings.reviews_based_on_text }}
      {{ section.settings.reviews_count }}
      {{ section.settings.reviews_suffix_text }}
    </div>
  </div>
{% endif %}
    <div class="reviews-wrapper swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div
            class="swiper-slide"
            {% render 'animation',
              enable_animations: section.settings.enable_animations,
              animation: section.settings.animation
            -%}
          >
            <div class="review-card">
              <!-- LEFT -->
              <div
                class="review-left"
                {% render 'animation',
                  enable_animations: section.settings.enable_animations,
                  animation: section.settings.animation
                -%}
              >
                <div class="review-left-inner">
                  <div class="review-profile">
                    {% if block.settings.avatar != blank %}
                      <img
                        src="{{ block.settings.avatar | image_url: width: 80 }}"
                        alt="Customer avatar"
                        height="auto"
                        width="100%"
                      >
                      {% comment %}
                        {% else %}
                        <div class="placeholder-profile-avatar"></div>
                      {% endcomment %}
                    {% endif %}
                    <div>
                      {% if block.settings.customer_name %}
                        <strong>{{ block.settings.customer_name }}</strong>
                      {% endif %}
                      {% if block.settings.verified %}
                        <span class="verified">✔ {{ block.settings.verified_text }}</span>
                      {% endif %}
                    </div>
                  </div>
                  {% if block.settings.product != blank %}
                    <div class="review-product">
                      <a href="{{ block.settings.product.url }}">
                        <img src="{{ block.settings.product.featured_image | image_url: width: 160 }}" height="auto" width="80">
                        <span>{{ block.settings.product.title }}</span>
                      </a>
                      {% comment %}
                        {% else %}
                        <div class="product-placeholder">
                          <div class="placeholder-img">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                          <span>Product title</span>
                        </div>
                      {% endcomment %}
                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- RIGHT -->
              <div class="review-right">
                <div class="review-right-inner">
                  <div
                    class="review-header {% if block.settings.review_text == blank %}no-desc{% endif %}"
                    {% render 'animation',
                      enable_animations: section.settings.enable_animations,
                      animation: section.settings.animation
                    -%}
                  >
                    <h3>{{ block.settings.review_title }}</h3>
                    <div class="stars">
                      {% for i in (1..5) %}
                        <span class="{% if i <= block.settings.stars %}filled{% endif %}">★</span>
                      {% endfor %}
                    </div>
                  </div>

                  <p
                    class="review-text"
                    {% render 'animation',
                      enable_animations: section.settings.enable_animations,
                      animation: section.settings.animation
                    -%}
                  >
                    {{ block.settings.review_text }}
                  </p>

                  <div class="rating-bars">
                    {% for i in (1..10) %}
                      {% assign label_key = 'label_' | append: i %}
                      {% assign value_key = 'value_' | append: i %}

                      {% assign label = block.settings[label_key] %}
                      {% assign value = block.settings[value_key] %}

                      {% if label != blank %}
                        <div
                          class="rating-row"
                          {% render 'animation',
                            enable_animations: section.settings.enable_animations,
                            animation: section.settings.animation
                          -%}
                        >
                          <span>{{ label }}</span>
                          <div class="bar">
                            <div class="fill" style="width: {{ value | times: 10 }}%"></div>
                          </div>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>

{%- render 'separator-bottom', section: section -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let reviewSwiper;
    function initReviewSwiper() {
      const wrapper = document.querySelector('.detailed-reviews .swiper');
      if (window.innerWidth <= 768) {
        if (!reviewSwiper) {
          reviewSwiper = new Swiper(wrapper, {
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            pagination: { el: '.detailed-reviews .swiper-pagination', clickable: true },
          });
        }
      } else {
        if (reviewSwiper) {
          reviewSwiper.destroy(true, true);
          reviewSwiper = undefined;
        }
      }
    }
    initReviewSwiper();
    window.addEventListener('resize', initReviewSwiper);
  });
</script>

